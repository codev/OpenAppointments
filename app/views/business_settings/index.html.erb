<%# Port of EA pages/business_settings.php. %>
<div id="business-logic-page" class="container backend-page py-3">
    <div id="business-logic">
        <div class="row">
            <div class="col-sm-3">
                <%= render "shared/settings_nav" %>
            </div>
            <div class="col-sm-9">
                <turbo-frame id="settings">
                    <%= settings_form "/business_settings/save" do %>
                        <div class="d-flex justify-content-between align-items-center border-bottom mb-4 py-2">
                            <h4 class="mb-0 fw-light">
                                <%= lang('business_logic') %>
                            </h4>

                            <%= settings_save_button %>
                        </div>

                        <%# The working plan editor and status options write into these on submit. %>
                        <%= hidden_field_tag "settings[company_working_plan]", setting('company_working_plan'), id: "working-plan-json" %>
                        <%= hidden_field_tag "settings[appointment_status_options]", vars(:appointment_status_options), id: "status-options-json" %>
                        <h5 class="mb-3 fw-light"><%= lang('working_plan') %></h5>

                        <p class="form-text text-muted mb-4">
                            <%= lang('edit_working_plan_hint') %>
                        </p>

                        <div class="table-responsive">
                            <table class="working-plan table table-striped">
                                <thead>
                                <tr>
                                    <th><%= lang('day') %></th>
                                    <th><%= lang('start') %></th>
                                    <th><%= lang('end') %></th>
                                </tr>
                                </thead>
                                <tbody><!-- Dynamic Content --></tbody>
                            </table>
                        </div>

                        <div class="text-end mb-5">
                            <button class="btn btn-outline-secondary" id="apply-global-working-plan" type="button">
                                <i class="fas fa-check"></i>
                                <%= lang('apply_to_all_providers') %>
                            </button>
                        </div>

                        <h5 class="mb-3 fw-light"><%= lang('breaks') %></h5>

                        <p class="form-text text-muted">
                            <%= lang('edit_breaks_hint') %>
                        </p>

                        <div class="mt-2">
                            <button type="button" class="add-break btn btn-primary">
                                <i class="fas fa-plus-square me-2"></i>
                                <%= lang('add_break') %>
                            </button>
                        </div>

                        <br>

                        <div class="table-responsive">
                            <table class="breaks table table-striped mb-5">
                                <thead>
                                <tr>
                                    <th><%= lang('day') %></th>
                                    <th><%= lang('start') %></th>
                                    <th><%= lang('end') %></th>
                                    <th><%= lang('actions') %></th>
                                </tr>
                                </thead>
                                <tbody><!-- Dynamic Content --></tbody>
                            </table>
                        </div>

                        <% if can?(:view, :blocked_periods) %>
                            <h5 class="mb-3 fw-light"><%= lang('blocked_periods') %></h5>

                            <p class="form-text text-muted">
                                <%= lang('blocked_periods_hint') %>
                            </p>

                            <div class="mb-5">
                                <a href="/blocked_periods" data-turbo="false" class="btn btn-primary">
                                    <i class="fas fa-cogs me-2"></i>
                                    <%= lang('configure') %>
                                </a>
                            </div>
                        <% end %>

                        <h5 class="mb-3 fw-light"><%= lang('minimum_times_before_appointments') %></h5>

                        <% { "book_advance_timeout" => "booking_window", "late_cancellation_timeout" => "late_window" }.each do |field, key| %>
                            <div class="mb-4 minutes-field" data-minutes-field="<%= field %>">
                                <label class="form-label"><%= lang(key) %></label>
                                <div class="d-flex gap-2">
                                    <div class="input-group">
                                        <%= number_field_tag "minutes[#{field}][hours]", setting(field).to_i / 60, min: 0, id: nil,
                                                             class: "form-control hours", "aria-label": lang('hours') %>
                                        <span class="input-group-text"><%= lang('hours') %></span>
                                    </div>
                                    <div class="input-group">
                                        <%= number_field_tag "minutes[#{field}][minutes]", setting(field).to_i % 60, min: 0, max: 59, id: nil,
                                                             class: "form-control minutes", "aria-label": lang('minutes') %>
                                        <span class="input-group-text"><%= lang('minutes') %></span>
                                    </div>
                                </div>
                                <%= settings_flash %>
                                <div class="form-text text-muted">
                                    <small><%= lang("#{key}_hint") %></small>
                                </div>
                            </div>
                        <% end %>
                        <div class="mb-5"></div>

                        <h5 class="mb-3 fw-light"><%= lang('future_booking_limit') %></h5>

                        <div class="mb-5">
                            <label for="future-booking-limit" class="form-label">
                                <%= lang('limit_days') %>
                            </label>
                            <%= setting_text "future_booking_limit", min: 15, type: "number" %>
                            <div class="form-text text-muted">
                                <small>
                                    <%= lang('future_booking_limit_hint') %>
                                </small>
                            </div>
                        </div>

                        <h5 class="mb-3 fw-light"><%= lang('waitlist') %></h5>

                        <div class="form-check form-switch mb-3">
                            <%= setting_switch "waitlist_enabled", default: "0" %>
                            <label class="form-check-label" for="waitlist-enabled"><%= lang('waitlist_enabled') %></label>
                            <div class="form-text text-muted"><small><%= lang('waitlist_enabled_hint') %></small></div>
                        </div>

                        <% { "waitlist_days" => 14, "waitlist_max_notices" => 7, "waitlist_min_slots" => 3,
                             "waitlist_stagger_seconds" => 60 }.each do |name, default| %>
                            <div class="mb-3">
                                <label for="<%= name.dasherize %>" class="form-label"><%= lang(name) %></label>
                                <%= setting_text name, type: "number", min: 0, value: setting(name).presence || default %>
                                <div class="form-text text-muted"><small><%= lang("#{name}_hint") %></small></div>
                            </div>
                        <% end %>
                        <div class="mb-5"></div>

                        <div class="d-flex justify-content-start align-items-center mb-3">
                            <h5 class="mb-0 me-3 fw-light">
                                <%= lang('appointment_status_options') %>
                            </h5>
                        </div>

                        <p class="form-text text-muted mb-4">
                            <%= lang('appointment_status_options_info') %>
                        </p>

                        <%= render "shared/appointment_status_options",
                                   attributes: 'id="appointment-status-options"' %>

                    <% end %>
                </turbo-frame>
            </div>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= javascript_include_tag "vendor/jquery-jeditable/jquery.jeditable.min" %>
    <%= ea_js "utils/ui", "utils/working_plan", "pages/business_settings" %>
<% end %>
