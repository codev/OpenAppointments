<%# Port of EA pages/business_settings.php. %>
<div id="business-logic-page" class="backend-page">
    <div id="business-logic">
        <div class="with-sidebar">
            <aside>
                <%= render "shared/settings_nav" %>
            </aside>
            <div>
                <turbo-frame id="settings">
                    <%= settings_form "/business_settings/save" do %>
                        <div class="page-heading toolbar spaced">
                            <h4>
                                <%= lang('business_logic') %>
                            </h4>

                            <%= settings_save_button %>
                        </div>

                        <%# The working plan editor and status options write into these on submit. %>
                        <%= hidden_field_tag "settings[company_working_plan]", setting('company_working_plan'), id: "working-plan-json" %>
                        <%= hidden_field_tag "settings[appointment_status_options]", vars(:appointment_status_options), id: "status-options-json" %>
                        <h5><%= lang('working_plan') %></h5>

                        <p class="field-hint muted">
                            <%= lang('edit_working_plan_hint') %>
                        </p>

                        <div class="table-scroll">
                            <table class="working-plan striped">
                                <thead>
                                <tr>
                                    <th><%= lang('day') %></th>
                                    <th><%= lang('start') %></th>
                                    <th><%= lang('end') %></th>
                                </tr>
                                </thead>
                                <tbody><!-- Dynamic Content --></tbody>
                            </table>
                        </div>

                        <div class="end-aligned">
                            <button class="secondary" id="apply-global-working-plan" type="button">
                                <i class="fas fa-check"></i>
                                <%= lang('apply_to_all_providers') %>
                            </button>
                        </div>

                        <h5><%= lang('breaks') %></h5>

                        <p class="field-hint muted">
                            <%= lang('edit_breaks_hint') %>
                        </p>

                        <div class="toolbar">
                            <button type="button" class="add-break">
                                <i class="fas fa-plus-square"></i>
                                <%= lang('add_break') %>
                            </button>
                        </div>

                        <br>

                        <div class="table-scroll">
                            <table class="breaks striped">
                                <thead>
                                <tr>
                                    <th><%= lang('day') %></th>
                                    <th><%= lang('start') %></th>
                                    <th><%= lang('end') %></th>
                                    <th><%= lang('actions') %></th>
                                </tr>
                                </thead>
                                <tbody><!-- Dynamic Content --></tbody>
                            </table>
                        </div>

                        <% if can?(:view, :blocked_periods) %>
                            <h5><%= lang('blocked_periods') %></h5>

                            <p class="field-hint muted">
                                <%= lang('blocked_periods_hint') %>
                            </p>

                            <div>
                                <a role="button" href="/blocked_periods" data-turbo="false" >
                                    <i class="fas fa-cogs"></i>
                                    <%= lang('configure') %>
                                </a>
                            </div>
                        <% end %>

                        <h5><%= lang('minimum_times_before_appointments') %></h5>

                        <% { "book_advance_timeout" => "booking_window", "late_cancellation_timeout" => "late_window" }.each do |field, key| %>
                            <div class="minutes-field" data-minutes-field="<%= field %>">
                                <label><%= lang(key) %></label>
                                <div class="toolbar">
                                    <div class="input-row">
                                        <%= number_field_tag "minutes[#{field}][hours]", setting(field).to_i / 60, min: 0, id: nil,
                                                             class: "hours", "aria-label": lang('hours') %>
                                        <span class="input-addon"><%= lang('hours') %></span>
                                    </div>
                                    <div class="input-row">
                                        <%= number_field_tag "minutes[#{field}][minutes]", setting(field).to_i % 60, min: 0, max: 59, id: nil,
                                                             class: "minutes", "aria-label": lang('minutes') %>
                                        <span class="input-addon"><%= lang('minutes') %></span>
                                    </div>
                                </div>
                                <%= settings_flash %>
                                <div class="field-hint muted">
                                    <small><%= lang("#{key}_hint") %></small>
                                </div>
                            </div>
                        <% end %>
                        <div></div>

                        <h5><%= lang('future_booking_limit') %></h5>

                        <div class="field">
                            <label for="future-booking-limit" >
                                <%= lang('limit_days') %>
                            </label>
                            <%= setting_text "future_booking_limit", min: 15, type: "number" %>
                            <div class="field-hint muted">
                                <small>
                                    <%= lang('future_booking_limit_hint') %>
                                </small>
                            </div>
                        </div>

                        <h5><%= lang('waitlist') %></h5>

                        <div class="choice switch-field">
                            <%= setting_switch "waitlist_enabled", default: "0" %>
                            <label  for="waitlist-enabled"><%= lang('waitlist_enabled') %></label>
                            <div class="field-hint muted"><small><%= lang('waitlist_enabled_hint') %></small></div>
                        </div>

                        <% { "waitlist_days" => 14, "waitlist_max_notices" => 7, "waitlist_min_slots" => 3,
                             "waitlist_stagger_seconds" => 60 }.each do |name, default| %>
                            <div class="field">
                                <label for="<%= name.dasherize %>" ><%= lang(name) %></label>
                                <%= setting_text name, type: "number", min: 0, value: setting(name).presence || default %>
                                <div class="field-hint muted"><small><%= lang("#{name}_hint") %></small></div>
                            </div>
                        <% end %>
                        <div></div>

                        <div>
                            <h5>
                                <%= lang('appointment_status_options') %>
                            </h5>
                        </div>

                        <p class="field-hint muted">
                            <%= lang('appointment_status_options_info') %>
                        </p>

                        <%= render "shared/appointment_status_options",
                                   attributes: 'id="appointment-status-options"' %>

                    <% end %>
                </turbo-frame>
            </div>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= javascript_include_tag "vendor/jquery-jeditable/jquery.jeditable.min" %>
    <%= ea_js "utils/ui", "utils/working_plan", "pages/business_settings" %>
<% end %>
