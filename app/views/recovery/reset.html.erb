<%# Port of EA pages/password_reset.php. The legacy image captcha branch is dropped; only ALTCHA remains. %>
<div class="centered">
    <img src="<%= image_path("logo.png") %>" alt="OpenAppointments"
          width="72" height="72">

    <h4 class="accent"><%= lang('reset_password') %></h4>

    <% if vars(:token_valid) %>
        <p>
            <%= lang('enter_new_password') %>
        </p>
    <% end %>
</div>

<div class="notice" hidden></div>

<% if vars(:token_valid) %>

    <!-- Password Reset Form -->

    <% if flash[:alert] %><div class="notice" data-tone="error"><%= flash[:alert] %></div><% end %>
    <%= form_with url: "/recovery/complete", method: :post, id: "password-reset-form", data: { turbo: false } do %>
        <%= hidden_field_tag :form, "1" %>
        <%= hidden_field_tag :token, vars(:token), id: "token" %>

        <div class="field">
            <label for="password" >
                <%= lang('new_password') %>
            </label>
            <div class="input-row">
                <span class="input-addon">
                    <i class="fas fa-lock"></i>
                </span>
                <%= password_field_tag :password, nil, id: "password", placeholder: lang('enter_password_here'), required: true %>
            </div>
            <small class="muted">
                <%= lang('password_length_notice').sub('$number', Passwords::MIN_LENGTH.to_s) %>
            </small>
        </div>

        <div class="field">
            <label for="password-confirm" >
                <%= lang('retype_password') %>
            </label>
            <div class="input-row">
                <span class="input-addon">
                    <i class="fas fa-lock"></i>
                </span>
                <%= password_field_tag :password_confirm, nil, id: "password-confirm", placeholder: lang('enter_password_here'), required: true %>
            </div>
        </div>

        <%= render "shared/auth_captcha" %>

        <div class="centered">
            <button type="submit" id="reset-password" >
                <i class="fas fa-key"></i>
                <%= lang('reset_password') %>
            </button>
        </div>

    <% end %>

<% else %>
    <!-- Invalid or Expired Token Message -->
    <div class="notice" data-tone="error">
        <i class="fas fa-exclamation-triangle"></i>
        <%= vars(:error_message) || lang('invalid_or_expired_token') %>
    </div>
<% end %>

<div>
    <a href="/login" >
        <i class="fas fa-arrow-left"></i>
        <%= lang('go_to_login') %>
    </a>
</div>

