<%# Port of EA pages/recovery.php. The legacy image captcha branch is dropped; only ALTCHA remains. %>
<div class="centered">
    <img src="<%= image_path("logo.png") %>"
         alt="OpenAppointments"  width="72" height="72">

    <h4 class="accent">
        <%= lang('forgot_your_password') %>
    </h4>

    <p>
        <%= lang('type_username_and_email_for_reset_link') %>
    </p>
</div>

<div class="notice" hidden></div>

<% if flash[:notice] %><div class="notice" data-tone="success"><%= flash[:notice] %></div><% end %>
<% if flash[:alert] %><div class="notice" data-tone="error"><%= flash[:alert] %></div><% end %>
<%= form_with url: "/recovery/perform", method: :post, id: "recovery-form", data: { turbo: false } do %>
    <%= hidden_field_tag :form, "1" %>
    <div class="field">
        <label for="username" >
            <%= lang('username') %>
        </label>
        <div class="input-row">
            <span class="input-addon">
                <i class="fas fa-user"></i>
            </span>
            <%= text_field_tag :username, nil, id: "username", placeholder: lang('enter_username_here'), required: true %>
        </div>
    </div>

    <div class="field">
        <label for="email" >
            <%= lang('email') %>
        </label>
        <div class="input-row">
            <span class="input-addon">
                <i class="fas fa-envelope"></i>
            </span>
            <%= email_field_tag :email, nil, id: "email", placeholder: lang('enter_email_here'), required: true %>
        </div>
    </div>

    <%= render "shared/auth_captcha" %>

    <div class="centered">
        <button type="submit" id="get-new-password" >
            <i class="fas fa-paper-plane"></i>
            <%= lang('send_reset_link') %>
        </button>
    </div>

    <div>
        <a href="/login" >
            <i class="fas fa-arrow-left"></i>
            <%= lang('go_to_login') %>
        </a>
    </div>
<% end %>
