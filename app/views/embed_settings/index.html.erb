<%# Iframe embedding settings + copy-paste embed code. %>
<div class="backend-page" id="embed-settings-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/settings_nav" %>
        </aside>

        <div>
            <h4><%= lang('embedding') %></h4>

            <turbo-frame id="settings">
            <div class="panel" style="max-width: 720px;">
                <%= settings_form "/embed_settings/save" do %>
                <%= settings_flash %>
                <div>
                    <div class="choice switch-field">
                        <%= setting_switch "allow_iframe_embedding" %>
                        <label  for="allow-iframe-embedding">
                            <%= lang('allow_iframe_embedding') %>
                        </label>
                    </div>
                </div>

                <div class="field">
                    <label  for="iframe-embed-origin">
                        <%= lang('iframe_embed_origin') %>
                    </label>
                    <%= setting_text "iframe_embed_origin", type: "url", placeholder: "https://www.example.org", maxlength: 256 %>
                </div>

                <div>
                    <%= settings_save_button %>
                </div>
                <% end %>
            </div>
            </turbo-frame>

            <h5><%= lang('embed_code') %></h5>
            <p class="muted"><%= lang('embed_hint') %></p>

            <div class="panel" style="max-width: 720px;">
<% embed_html = <<~HTML
     <iframe id="openappointments-booking" src="#{vars(:booking_url)}/" title="Book an appointment"
             style="width: 100%; height: 900px; border: 0;"></iframe>
   HTML
   embed_js = <<~JS
     window.addEventListener('message', function (event) {
       if (event.origin !== '#{vars(:booking_url)}') return;
       var data = event.data || {};
       if (data.type === 'openappointments:height') {
         document.getElementById('openappointments-booking').style.height = data.height + 'px';
       }
     });
   JS
   embed_code = embed_html + "<script>\n" + embed_js.gsub(/^(?!$)/, "  ") + "</script>\n"
%>
                <textarea id="embed-code"  rows="12"
                          readonly><%= embed_code %></textarea>
                <div>
                    <button type="button" id="copy-embed-code" class="secondary small-action copy-embed-target"
                            data-target="#embed-code">
                        <i class="fas fa-copy"></i>
                        <%= lang('copy') %>
                    </button>
                </div>
            </div>

            <h5><%= lang('embed_wordpress') %></h5>
            <p class="muted"><%= lang('embed_wordpress_hint') %></p>

            <div class="panel" style="max-width: 720px;">
                <div class="field">
                    <label  for="embed-wordpress-html">HTML</label>
                    <textarea id="embed-wordpress-html"  rows="3"
                              readonly><%= embed_html %></textarea>
                    <div>
                        <button type="button" class="secondary small-action copy-embed-target"
                                data-target="#embed-wordpress-html">
                            <i class="fas fa-copy"></i>
                            <%= lang('copy') %>
                        </button>
                    </div>
                </div>

                <div class="field">
                    <label  for="embed-wordpress-css">CSS</label>
                    <textarea id="embed-wordpress-css"  rows="3"
                              readonly></textarea>
                    <div>
                        <button type="button" class="secondary small-action copy-embed-target"
                                data-target="#embed-wordpress-css">
                            <i class="fas fa-copy"></i>
                            <%= lang('copy') %>
                        </button>
                    </div>
                </div>

                <div class="field">
                    <label  for="embed-wordpress-js">JavaScript</label>
                    <textarea id="embed-wordpress-js"  rows="8"
                              readonly><%= embed_js %></textarea>
                    <div>
                        <button type="button" class="secondary small-action copy-embed-target"
                                data-target="#embed-wordpress-js">
                            <i class="fas fa-copy"></i>
                            <%= lang('copy') %>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= ea_js "utils/copy_target" %>
<% end %>
