<%# Umami Analytics settings (integrations hub). %>
<div id="umami-analytics-settings-page" class="backend-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/settings_nav" %>
        </aside>
        <div id="umami-analytics-settings" >
            <turbo-frame id="settings">
                <%= settings_form "/umami_analytics_settings/save" do %>
                    <div class="toolbar spaced">
                        <h4>
                            <%= lang('umami_analytics') %>
                        </h4>

                        <div class="split">
                            <a role="button" href="/integrations" data-turbo="false" class="outline">
                                <i class="fas fa-chevron-left"></i>
                                <%= lang('back') %>
                            </a>

                            <%= settings_save_button %>
                        </div>
                    </div>
                    <%= settings_flash %>

                    <div>
                        <div class="full">
                            <div class="field">
                                <label  for="umami-analytics-url">
                                    <%= lang('umami_analytics_url') %>
                                </label>
                                <%= setting_text "umami_analytics_url", placeholder: "https://stats.example.org" %>
                                <div class="field-hint muted">
                                    <small>
                                        <%= lang('umami_analytics_url_hint') %>
                                    </small>
                                </div>
                            </div>

                            <div class="field">
                                <label  for="umami-analytics-website-id">
                                    <%= lang('umami_analytics_website_id') %>
                                </label>
                                <%= setting_text "umami_analytics_website_id" %>
                            </div>

                            <div>
                                <div class="choice switch-field">
                                    <%= setting_switch "umami_analytics_recorder" %>
                                    <label  for="umami-analytics-recorder">
                                        <%= lang('umami_analytics_recorder') %>
                                    </label>
                                </div>
                                <div class="field-hint muted">
                                    <%= lang('umami_analytics_recorder_hint') %>
                                </div>
                            </div>
                        </div>
                    </div>

                <% end %>
            </turbo-frame>
        </div>
    </div>
</div>

