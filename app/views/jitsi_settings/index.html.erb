<%# Port of EA pages/jitsi_settings.php. %>
<div id="jitsi-settings-page" class="backend-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/settings_nav" %>
        </aside>
        <div id="jitsi-settings" >
            <turbo-frame id="settings">
                <%= settings_form "/jitsi_settings/save" do %>
                    <div class="toolbar spaced">
                        <h4>
                            <%= lang('jitsi') %>
                        </h4>

                        <div class="split">
                            <a role="button" href="/integrations" data-turbo="false" class="outline">
                                <i class="fas fa-chevron-left"></i>
                                <%= lang('back') %>
                            </a>

                            <%= settings_save_button %>
                        </div>
                    </div>
                    <%= settings_flash %>

                    <div>
                        <div class="full">
                            <div>
                                <div class="field-hint muted">
                                    <%= lang('jitsi_info') %>
                                </div>
                            </div>

                            <div>
                                <div class="choice switch-field">
                                    <%= setting_switch "jitsi_enabled" %>
                                    <label  for="jitsi-enabled">
                                        <%= lang('active') %>
                                    </label>
                                </div>
                            </div>

                        </div>
                    </div>

                <% end %>
            </turbo-frame>
        </div>
    </div>
</div>

