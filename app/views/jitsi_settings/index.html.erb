<%# Port of EA pages/jitsi_settings.php. %>
<div id="jitsi-settings-page" class="container backend-page py-3">
    <div class="row">
        <div class="col-sm-3">
            <%= render "shared/settings_nav" %>
        </div>
        <div id="jitsi-settings" class="col-sm-9">
            <turbo-frame id="settings">
                <%= settings_form "/jitsi_settings/save" do %>
                    <div class="d-flex justify-content-between align-items-center border-bottom mb-4 py-2">
                        <h4 class="mb-0 fw-light">
                            <%= lang('jitsi') %>
                        </h4>

                        <div>
                            <a href="/integrations" data-turbo="false" class="btn btn-outline-primary me-2">
                                <i class="fas fa-chevron-left me-2"></i>
                                <%= lang('back') %>
                            </a>

                            <%= settings_save_button %>
                        </div>
                    </div>
                    <%= settings_flash %>

                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3">
                                <div class="form-text text-muted mb-4">
                                    <%= lang('jitsi_info') %>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <%= setting_switch "jitsi_enabled" %>
                                    <label class="form-check-label" for="jitsi-enabled">
                                        <%= lang('active') %>
                                    </label>
                                </div>
                            </div>

                        </div>
                    </div>

                <% end %>
            </turbo-frame>
        </div>
    </div>
</div>

