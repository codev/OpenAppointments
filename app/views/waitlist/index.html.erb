<%# Live waiting list signups, longest waiting first. %>
<% format_settings = { date_format: setting("date_format"), time_format: setting("time_format") } %>
<div id="waitlist-page" class="backend-page">
    <h4><%= lang('waitlist') %></h4>
    <p class="muted"><%= lang('waitlist_hint') %></p>

    <% if @entries.empty? %>
        <p><%= lang('waitlist_empty') %></p>
    <% else %>
        <div class="table-scroll">
            <table id="waitlist-entries" >
                <thead>
                    <tr>
                        <th><%= lang('name') %></th>
                        <th><%= lang('contact_info') %></th>
                        <th><%= lang('service') %></th>
                        <th><%= lang('provider') %></th>
                        <th><%= lang('waitlist_signed_up') %></th>
                        <th><%= lang('waitlist_expires') %></th>
                        <th><%= lang('waitlist_messages_sent') %></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% @entries.each do |entry| %>
                        <tr>
                            <td><%= entry.name %></td>
                            <td><%= [ entry.email, entry.phone.presence ].compact.join(", ") %></td>
                            <td><%= entry.service.name %></td>
                            <td><%= entry.provider&.name || lang('any_provider') %></td>
                            <td class="nowrap"><%= display_datetime(entry.created_at) %></td>
                            <td class="nowrap"><%= display_datetime(entry.expires_at) %></td>
                            <td><%= entry.notices_sent %></td>
                            <td>
                                <%= button_to lang('delete'), "/waitlist/#{entry.id}", method: :delete,
                                              class: "destructive small-action",
                                              form: { data: { turbo_confirm: lang('delete_record_prompt') } } %>
                            </td>
                        </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
    <% end %>
</div>
