<%# Live waiting list signups, longest waiting first. %>
<% format_settings = { date_format: setting("date_format"), time_format: setting("time_format") } %>
<div id="waitlist-page" class="container backend-page py-3">
    <h4 class="border-bottom py-3 mb-2 fw-light"><%= lang('waitlist') %></h4>
    <p class="text-muted"><%= lang('waitlist_hint') %></p>

    <% if @entries.empty? %>
        <p class="fst-italic"><%= lang('waitlist_empty') %></p>
    <% else %>
        <div class="table-responsive">
            <table id="waitlist-entries" class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th><%= lang('name') %></th>
                        <th><%= lang('contact_info') %></th>
                        <th><%= lang('service') %></th>
                        <th><%= lang('provider') %></th>
                        <th><%= lang('waitlist_signed_up') %></th>
                        <th><%= lang('waitlist_expires') %></th>
                        <th class="text-end"><%= lang('waitlist_messages_sent') %></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% @entries.each do |entry| %>
                        <tr>
                            <td><%= entry.name %></td>
                            <td><%= [ entry.email, entry.phone.presence ].compact.join(", ") %></td>
                            <td><%= entry.service.name %></td>
                            <td><%= entry.provider&.name || lang('any_provider') %></td>
                            <td class="text-nowrap"><%= format_appointment_datetime(entry.created_at, format_settings) %></td>
                            <td class="text-nowrap"><%= format_appointment_datetime(entry.expires_at, format_settings) %></td>
                            <td class="text-end"><%= entry.notices_sent %></td>
                            <td class="text-end">
                                <%= button_to lang('delete'), "/waitlist/#{entry.id}", method: :delete,
                                              class: "btn btn-outline-danger btn-sm",
                                              form: { data: { turbo_confirm: lang('delete_record_prompt') } } %>
                            </td>
                        </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
    <% end %>
</div>
