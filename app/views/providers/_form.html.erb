<% linked_ids = record.provider_service_links.map(&:id_services) %>
<% plan_settings = record.settings %>
<% header = capture do %>
    <% if record.persisted? %>
        <div class="full">
            <%= link_to root_path(provider: record.booking_slug), target: "_blank", title: lang('booking_link'),
                        "aria-label": lang('booking_link') do %>
                <i class="fas fa-link"></i>
            <% end %>
            <%= button_to lang('regenerate_link'), regenerate_link_provider_path(record),
                          class: "secondary small-action", form_class: "inline-form", data: { turbo_confirm_title: lang('regenerate_link'), turbo_confirm_button: lang('change') },
                          form: { data: { turbo_frame: "providers_record",
                                          turbo_confirm: lang('regenerate_link_warning_provider') } } %>
        </div>
    <% end %>
    <div role="tablist" class="switch-view">
        <button type="button" role="tab" aria-selected="true" aria-controls="details"><%= lang('details') %></button>
        <button type="button" role="tab" aria-selected="false" aria-controls="working-plan"><%= lang('working_plan') %></button>
    </div>
<% end %>
<% settings = capture do %>
    <div>
        <div class="choice switch-field">
            <%= hidden_field_tag "provider[is_private]", "0", id: nil %>
            <%= check_box_tag "provider[is_private]", "1", record.is_private, id: "provider_is_private" %>
            <label  for="provider_is_private"><%= lang('hide_from_public') %></label>
        </div>
        <div class="field-hint muted"><small><%= lang('private_hint') %></small></div>
    </div>
    <div>
        <%= render "shared/color_selection", name: "provider[color]", value: record.color %>
        <div class="field-hint muted"><small><%= lang('provider_color_hint') %></small></div>
    </div>
    <div class="field toolbar spaced">
        <label><%= lang('services') %></label>
        <div class="toolbar btn-group-sm">
            <button type="button" class="secondary" data-check-all="#provider-services">
                <%= lang('select_all') %>
            </button>
            <button type="button" class="secondary" data-check-none="#provider-services">
                <%= lang('select_none') %>
            </button>
        </div>
    </div>
    <div id="provider-services" class="panel">
        <%= hidden_field_tag "provider[services][]", "", id: nil %>
        <% Service.order(:name).each do |service| %>
            <div class="choice">
                <%= check_box_tag "provider[services][]", service.id, linked_ids.include?(service.id),
                                  id: "service-#{service.id}" %>
                <label  for="service-<%= service.id %>"><%= service.name %></label>
            </div>
        <% end %>
    </div>
<% end %>
<% after = capture do %>
    <div>
        <div class="field">
            <label  for="provider_about"><%= lang('about') %></label>
            <%= text_area_tag "provider[about]", record.about, rows: 6, id: "provider_about" %>
        </div>
        <div class="field">
            <label  for="provider_services_description"><%= lang('services_description') %></label>
            <%= text_area_tag "provider[services_description]", record.services_description, rows: 6,
                              id: "provider_services_description" %>
        </div>
    </div>
<% end %>
<%# The working plan editor reads and writes these; the tab content is shown by
    pages/providers.js after the frame loads. %>
<%# After a failed save the typed plan wins over the stored one. %>
<% typed_settings = params.dig(:provider, :settings) || {} %>
<% working_plan = capture do %>
    <%= hidden_field_tag "provider[settings][working_plan]",
                         typed_settings[:working_plan].presence || plan_settings&.working_plan.presence || setting('company_working_plan'),
                         id: "working-plan-json" %>
    <%= hidden_field_tag "provider[settings][working_plan_exceptions]",
                         typed_settings[:working_plan_exceptions].presence ||
                           (record.persisted? ? EaRows.working_plan_exceptions_api(record.id).to_json : "[]"),
                         id: "working-plan-exceptions-json" %>
    <div class="working-plan-view" id="working-plan" role="tabpanel" hidden>
        <h4><%= lang('working_plan') %></h4>
        <button type="button" id="reset-working-plan" 
                data-company-working-plan="<%= setting('company_working_plan') %>"
                data-tippy-content="<%= lang('reset_working_plan') %>">
            <i class="fas fa-undo-alt"></i>
            <%= lang('reset_plan') %>
        </button>
        <div class="table-scroll">
            <table class="working-plan striped">
                <thead><tr><th><%= lang('day') %></th><th><%= lang('start') %></th><th><%= lang('end') %></th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
        <br>
        <h4><%= lang('breaks') %></h4>
        <p><%= lang('add_breaks_during_each_day') %></p>
        <div class="stack">
            <button type="button" class="add-break">
                <i class="fas fa-plus-square"></i>
                <%= lang('add_break') %>
            </button>
        </div>
        <br>
        <div class="table-scroll">
            <table class="breaks striped">
                <thead><tr><th><%= lang('day') %></th><th><%= lang('start') %></th><th><%= lang('end') %></th><th><%= lang('actions') %></th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
        <br>
        <h4><%= lang('working_plan_exceptions') %></h4>
        <p><%= lang('add_working_plan_exceptions_during_each_day') %></p>
        <div>
            <button type="button" class="add-working-plan-exception" data-non-working="0">
                <i class="fas fa-plus-square"></i>
                <%= lang('add_available_exception') %>
            </button>
            <button type="button" class="add-working-plan-exception" data-non-working="1">
                <i class="fas fa-plus-square"></i>
                <%= lang('add_unavailable_exception') %>
            </button>
        </div>
        <br>
        <div class="table-scroll">
            <table class="working-plan-exceptions striped">
                <thead><tr><th><%= lang('date') %></th><th><%= lang('status') %></th><th><%= lang('actions') %></th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
<% end %>
<%= render "shared/user_form", record: record, delete_title: lang('delete_provider'), header: header,
           settings: settings, after: after, working_plan: working_plan %>
