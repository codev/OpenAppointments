<% list_toolbar = capture do %>
    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="text-muted me-2"><%= lang('drag_to_reorder') %></small>
        <%= button_to lang('sort_alphabetically'), "/providers/sort_alphabetically",
                      class: "btn btn-outline-secondary btn-sm sort-alphabetically text-nowrap",
                      form: { data: { turbo_confirm: lang('sort_alphabetically_confirm') } } %>
    </div>
<% end %>
<%= render "shared/crud_page", page: "providers", title: lang('providers'),
           records: @records, record: @record, editing: @editing, keyword: @keyword,
           row: "shared/user_row", form: "providers/form", list_toolbar: list_toolbar %>

<%# Outside the frames: the modal script binds it once at page load. %>
<%= render "shared/working_plan_exceptions_modal" %>

<% content_for :scripts do %>
    <%= javascript_include_tag "vendor/jquery-jeditable/jquery.jeditable.min" %>
    <%= ea_js "utils/ui", "utils/working_plan", "components/working_plan_exceptions_modal", "pages/providers" %>
<% end %>
