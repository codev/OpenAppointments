<div id="payments-settings-page" class="container backend-page py-3">
    <div class="row">
        <div class="col-sm-3">
            <%= render "shared/payments_nav" %>
        </div>
        <div id="payments-settings" class="col-sm-9">
            <turbo-frame id="settings">
                <%= settings_form "/payments_settings/save" do %>
                    <div class="d-flex justify-content-between align-items-center border-bottom mb-4 py-2">
                        <h4 class="mb-0 fw-light">
                            <%= lang('settings') %>
                        </h4>
                    </div>
                    <%= settings_flash %>

                    <div class="row">
                        <div class="col-12 col-md-8">
                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <%= setting_switch "payments_enabled" %>
                                    <label class="form-check-label" for="payments-enabled">
                                        <%= lang('payments_enabled') %>
                                    </label>
                                </div>
                                <div class="form-text text-muted">
                                    <small>
                                        <%= lang('payments_enabled_hint') %>
                                    </small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="payments-default-method">
                                    <%= lang('payments_default_method') %>
                                </label>
                                <%= setting_select "payments_default_method", Payments.all.map { |method| [ method.label, method.key ] } %>
                                <div class="form-text text-muted">
                                    <small>
                                        <%= lang('payments_default_method_hint') %>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                <% end %>
            </turbo-frame>
        </div>
    </div>
</div>
