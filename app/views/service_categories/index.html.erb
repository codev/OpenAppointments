<% list_toolbar = capture do %>
    <div class="toolbar spaced">
        <small class="muted"><%= lang('drag_to_reorder') %></small>
        <%= button_to lang('sort_alphabetically'), "/service_categories/sort_alphabetically",
                      class: "secondary small-action sort-alphabetically nowrap",
                      form: { data: { turbo_confirm: lang('sort_alphabetically_confirm') } } %>
    </div>
<% end %>
<%= render "shared/crud_page", page: "service-categories", title: lang('service_categories'),
           records: @records, record: @record, editing: @editing, keyword: @keyword,
           row: "service_categories/row", form: "service_categories/form", list_toolbar: list_toolbar %>
