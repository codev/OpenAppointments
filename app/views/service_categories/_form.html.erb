<%= render "shared/crud_form", record: record, delete_title: lang('delete_service_category') do |f| %>
    <div class="mb-3">
        <%= f.label :name, class: "form-label" do %>
            <%= lang('name') %> <span class="text-danger">*</span>
        <% end %>
        <%= f.text_field :name, required: true,
                         class: "form-control #{'is-invalid' if record.errors.include?(:name)}" %>
    </div>

    <%= render "shared/record_picture", record: record, scope: "service_category" %>

    <div class="mb-3">
        <%= f.label :description, lang('description'), class: "form-label" %>
        <%= f.text_area :description, rows: 4, class: "form-control" %>
    </div>

    <div class="mb-3">
        <div class="form-check form-switch">
            <%= f.check_box :is_hidden, class: "form-check-input" %>
            <%= f.label :is_hidden, lang('hidden'), class: "form-check-label" %>
        </div>
        <div class="form-text text-muted small"><%= lang('category_hidden_hint') %></div>
    </div>
<% end %>
