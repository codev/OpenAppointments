<%= render "shared/crud_form", record: record, delete_title: lang('delete_service_category') do |f| %>
    <div class="mb-3">
        <%= f.label :name, class: "form-label" do %>
            <%= lang('name') %> <span class="text-danger">*</span>
        <% end %>
        <%= f.text_field :name, required: true,
                         class: "form-control #{'is-invalid' if record.errors.include?(:name)}" %>
    </div>

    <%= render "shared/record_picture", record: record, scope: "service_category" %>

    <div class="mb-3">
        <%= f.label :description, lang('description'), class: "form-label" %>
        <%= f.text_area :description, rows: 4, class: "form-control" %>
    </div>

    <% if record.persisted? %>
        <%# The category's services, each opening on the services page. %>
        <div id="category-services" class="card card-body mb-3">
            <h6 class="fw-light"><%= lang('category_services') %></h6>
            <% services = record.services.display_order %>
            <% if services.any? %>
                <ul class="list-unstyled mb-0">
                    <% services.each do |service| %>
                        <li class="mb-1">
                            <%= link_to service.name, edit_service_path(service), data: { turbo_frame: "_top" } %>
                            <small class="text-muted"><%= service.duration %> min - <%= service.price %> <%= service.currency %></small>
                        </li>
                    <% end %>
                </ul>
            <% else %>
                <div class="text-muted small"><%= lang('category_no_services') %></div>
            <% end %>
        </div>
    <% end %>

    <div class="mb-3">
        <div class="form-check form-switch">
            <%= f.check_box :is_hidden, class: "form-check-input" %>
            <%= f.label :is_hidden, lang('hidden'), class: "form-check-label" %>
        </div>
        <div class="form-text text-muted small"><%= lang('category_hidden_hint') %></div>
    </div>
<% end %>
