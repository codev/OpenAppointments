<% if categories.empty? %>
    <em><%= lang('no_records_found') %></em>
<% end %>
<% categories.each do |category| %>
    <div class="service-category-row entry <%= 'selected' if selected&.id == category.id %>"
         draggable="true" data-id="<%= category.id %>">
        <%= link_to edit_service_category_path(category), data: { turbo_frame: "service_category" },
                    class: "text-reset text-decoration-none d-block" do %>
            <strong><%= category.name %></strong>
        <% end %>
    </div>
    <hr>
<% end %>
