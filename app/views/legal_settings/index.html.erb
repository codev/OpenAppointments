<%# Port of EA pages/legal_settings.php. %>
<div id="legal-settings-page" class="container backend-page py-3">
    <div id="legal-contents">
        <div class="row">
            <div class="col-sm-3">
                <%= render "shared/settings_nav" %>
            </div>
            <div class="col-sm-9">
                <turbo-frame id="settings">
                    <%= settings_form "/legal_settings/save" do %>
                        <div class="d-flex justify-content-between align-items-center border-bottom mb-4 py-2">
                            <h4 class="mb-0 fw-light">
                                <%= lang('legal_contents') %>
                            </h4>

                            <%= settings_save_button %>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <h5 class="mb-3 fw-light"><%= lang('cookie_notice') %></h5>

                                <div class="form-check form-switch mb-3">
                                    <%= setting_switch "display_cookie_notice", class: "form-check-input display-switch" %>
                                    <label class="form-check-label" for="display-cookie-notice">
                                        <%= lang('display_cookie_notice') %>
                                    </label>
                                </div>

                                <div class="mb-5">
                                    <label class="form-label"
                                           for="cookie-notice-content"><%= lang('cookie_notice_content') %></label>
                                    <%= setting_textarea "cookie_notice_content", class: "mb-3 rich-text", cols: 30, rows: 10 %>
                                </div>

                                <h5 class="mb-3 fw-light"><%= lang('terms_and_conditions') %></h5>

                                <div class="form-check form-switch mb-3">
                                    <%= setting_switch "display_terms_and_conditions", class: "form-check-input display-switch" %>
                                    <label class="form-check-label" for="display-terms-and-conditions">
                                        <%= lang('display_terms_and_conditions') %>
                                    </label>
                                </div>

                                <div class="mb-5">
                                    <label class="form-label"
                                           for="terms-and-conditions-content"><%= lang('terms_and_conditions_content') %></label>
                                    <%= setting_textarea "terms_and_conditions_content", class: "mb-3 rich-text", cols: 30, rows: 10 %>
                                </div>

                                <h5 class="mb-3 fw-light"><%= lang('privacy_policy') %></h5>

                                <div class="form-check form-switch mb-3">
                                    <%= setting_switch "display_privacy_policy", class: "form-check-input display-switch" %>
                                    <label class="form-check-label" for="display-privacy-policy">
                                        <%= lang('display_privacy_policy') %>
                                    </label>
                                </div>

                                <div class="mb-5">
                                    <label class="form-label"
                                           for="privacy-policy-content"><%= lang('privacy_policy_content') %></label>
                                    <%= setting_textarea "privacy_policy_content", class: "mb-3 rich-text", cols: 30, rows: 10 %>
                                </div>

                                <h5 class="mb-3 fw-light"><%= lang('legal_notice') %></h5>

                                <div class="mb-5">
                                    <label class="form-label" for="legal-notice-url"><%= lang('legal_notice_url') %></label>
                                    <%= setting_text "legal_notice_url", type: "url", placeholder: "https://..." %>
                                    <div class="form-text text-muted small">
                                        <%= lang('legal_notice_url_hint') %>
                                    </div>
                                </div>
                                <%= settings_flash %>

                                <h5 class="mb-3 fw-light"><%= lang('imprint') %></h5>

                                <div class="mb-5">
                                    <label class="form-label" for="imprint-url"><%= lang('imprint_url') %></label>
                                    <%= setting_text "imprint_url", type: "url", placeholder: "https://..." %>
                                    <div class="form-text text-muted small">
                                        <%= lang('imprint_url_hint') %>
                                    </div>
                                </div>

                                <h5 class="mb-3 fw-light"><%= lang('data_retention') %></h5>

                                <div class="mb-3">
                                    <label class="form-label" for="data-retention-days"><%= lang('data_retention_days') %></label>
                                    <%= setting_text "data_retention_days", type: "number", min: 0, placeholder: "0" %>
                                    <div class="form-text text-muted small">
                                        <%= lang('data_retention_days_hint') %>
                                    </div>
                                </div>
                            </div>
                        </div>

                    <% end %>
                </turbo-frame>
            </div>
        </div>
    </div>
</div>
