<%# Port of EA pages/legal_settings.php. %>
<div id="legal-settings-page" class="backend-page">
    <div id="legal-contents">
        <div class="with-sidebar">
            <aside>
                <%= render "shared/settings_nav" %>
            </aside>
            <div>
                <turbo-frame id="settings">
                    <%= settings_form "/legal_settings/save" do %>
                        <div class="page-heading toolbar spaced">
                            <h4>
                                <%= lang('notices') %>
                            </h4>

                            <%= settings_save_button %>
                        </div>

                        <div class="split">
                            <div class="full">
                                <h5><%= lang('booking_notice') %></h5>

                                <div class="choice switch-field">
                                    <%= setting_switch "display_booking_notice_time_step", class: "display-switch" %>
                                    <label  for="display-booking-notice-time-step">
                                        <%= lang('display_booking_notice_time_step') %>
                                    </label>
                                </div>

                                <div class="choice switch-field">
                                    <%= setting_switch "display_booking_notice_info_step", class: "display-switch" %>
                                    <label  for="display-booking-notice-info-step">
                                        <%= lang('display_booking_notice_info_step') %>
                                    </label>
                                </div>

                                <div class="field">
                                    <label 
                                           for="booking-notice-content"><%= lang('booking_notice_content') %></label>
                                    <%= setting_textarea "booking_notice_content", class: "rich-text", cols: 30, rows: 10 %>
                                </div>

                                <h5><%= lang('fully_booked_notice') %></h5>

                                <div class="field">
                                    <label 
                                           for="fully-booked-notice-content"><%= lang('fully_booked_notice') %></label>
                                    <%= setting_textarea "fully_booked_notice_content", class: "rich-text", cols: 30, rows: 6 %>
                                    <div class="field-hint muted">
                                        <%= lang('fully_booked_notice_hint') %>
                                    </div>
                                </div>

                                <h5><%= lang('cookie_notice') %></h5>

                                <div class="choice switch-field">
                                    <%= setting_switch "display_cookie_notice", class: "display-switch" %>
                                    <label  for="display-cookie-notice">
                                        <%= lang('display_cookie_notice') %>
                                    </label>
                                </div>

                                <div class="field">
                                    <label 
                                           for="cookie-notice-content"><%= lang('cookie_notice_content') %></label>
                                    <%= setting_textarea "cookie_notice_content", class: "rich-text", cols: 30, rows: 10 %>
                                </div>

                                <h5><%= lang('terms_and_conditions') %></h5>

                                <div class="choice switch-field">
                                    <%= setting_switch "display_terms_and_conditions", class: "display-switch" %>
                                    <label  for="display-terms-and-conditions">
                                        <%= lang('display_terms_and_conditions') %>
                                    </label>
                                </div>

                                <div class="field">
                                    <label 
                                           for="terms-and-conditions-content"><%= lang('terms_and_conditions_content') %></label>
                                    <%= setting_textarea "terms_and_conditions_content", class: "rich-text", cols: 30, rows: 10 %>
                                </div>

                                <h5><%= lang('privacy_policy') %></h5>

                                <div class="choice switch-field">
                                    <%= setting_switch "display_privacy_policy", class: "display-switch" %>
                                    <label  for="display-privacy-policy">
                                        <%= lang('display_privacy_policy') %>
                                    </label>
                                </div>

                                <div class="field">
                                    <label 
                                           for="privacy-policy-content"><%= lang('privacy_policy_content') %></label>
                                    <%= setting_textarea "privacy_policy_content", class: "rich-text", cols: 30, rows: 10 %>
                                </div>

                                <h5><%= lang('legal_notice') %></h5>

                                <div class="field">
                                    <label  for="legal-notice-url"><%= lang('legal_notice_url') %></label>
                                    <%= setting_text "legal_notice_url", type: "url", placeholder: "https://..." %>
                                    <div class="field-hint muted">
                                        <%= lang('legal_notice_url_hint') %>
                                    </div>
                                </div>
                                <%= settings_flash %>

                                <h5><%= lang('imprint') %></h5>

                                <div class="field">
                                    <label  for="imprint-url"><%= lang('imprint_url') %></label>
                                    <%= setting_text "imprint_url", type: "url", placeholder: "https://..." %>
                                    <div class="field-hint muted">
                                        <%= lang('imprint_url_hint') %>
                                    </div>
                                </div>
                            </div>
                        </div>

                    <% end %>
                </turbo-frame>
            </div>
        </div>
    </div>
</div>
