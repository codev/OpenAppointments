<%# Port of EA pages/integrations.php. %>
<div id="integrations-page" class="backend-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/settings_nav" %>
        </aside>
        <div id="integrations" >
            <h4>
                <%= lang('integrations') %>
            </h4>

            <p class="field-hint muted">
                <%= lang('integrations_info') %>
            </p>

            <div class="split">
                <div>
                    <div class="panel">
                        <div>
                            <h5>
                                <%= lang('captcha') %>
                            </h5>
                        </div>
                        <div>
                            <div class="integration-info">
                                <small>
                                    <%= lang('captcha_info') %>
                                </small>
                            </div>
                        </div>
                        <div>
                            <%= render "status", on: @statuses[:captcha], text: nil %>
                            <a role="button" href="/altcha_settings" class="outline">
                                <i class="fas fa-cogs"></i>
                                <%= lang('configure') %>
                            </a>
                        </div>
                    </div>
                </div>

                <div>
                    <div class="panel">
                        <div>
                            <h5>
                                <%= lang('google_calendar') %>
                            </h5>
                        </div>
                        <div>
                            <div class="integration-info">
                                <small>
                                    <%= lang('google_calendar_info') %>
                                </small>
                            </div>
                        </div>
                        <div>
                            <%= render "status", on: @statuses[:google_calendar], text: nil %>
                            <a role="button" href="/google_calendar_settings" class="outline">
                                <i class="fas fa-cogs"></i>
                                <%= lang('configure') %>
                            </a>
                        </div>
                    </div>
                </div>

                <div>
                    <div class="panel">
                        <div>
                            <h5>
                                <%= lang('embedding') %>
                            </h5>
                        </div>
                        <div>
                            <div class="integration-info">
                                <small>
                                    <%= lang('embed_hint') %>
                                </small>
                            </div>
                        </div>
                        <div>
                            <%= render "status", on: @statuses[:embedding], text: nil %>
                            <a role="button" href="/embed_settings" class="outline">
                                <i class="fas fa-cogs"></i>
                                <%= lang('configure') %>
                            </a>
                        </div>
                    </div>
                </div>

                <div>
                    <div class="panel">
                        <div>
                            <h5>
                                <%= lang('webhooks') %>
