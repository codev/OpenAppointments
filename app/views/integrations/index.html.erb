                            </div>
                        </div>
                        <div>
                            <%= render "status", on: @statuses[:jitsi], text: nil %>
                            <a role="button" href="/jitsi_settings" class="outline">
                                <i class="fas fa-cogs"></i>
                                <%= lang('configure') %>
                            </a>
