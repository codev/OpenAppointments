                                    <%= lang('webhooks_info') %>
                                </small>
                            </div>
                        </div>
                        <div>
                            <%= render "status", on: @statuses[:webhooks] > 0,
                                        text: "#{@statuses[:webhooks]} #{lang('webhooks')}" %>
                            <a role="button" href="/webhooks" class="outline">
                                <i class="fas fa-cogs"></i>
                                <%= lang('configure') %>
                            </a>
                        </div>
                    </div>
                </div>

