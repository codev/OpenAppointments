<%# Port of EA pages/google_analytics_settings.php. %>
<div id="google-analytics-settings-page" class="backend-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/settings_nav" %>
        </aside>
        <div id="google-analytics-settings" >
            <turbo-frame id="settings">
                <%= settings_form "/google_analytics_settings/save" do %>
                    <div class="toolbar spaced">
                        <h4>
                            <%= lang('google_analytics') %>
                        </h4>

                        <div class="split">
                            <a role="button" href="/integrations" data-turbo="false" class="outline">
                                <i class="fas fa-chevron-left"></i>
                                <%= lang('back') %>
                            </a>

                            <%= settings_save_button %>
                        </div>
                    </div>
                    <%= settings_flash %>

                    <div>
                        <div class="full">
                            <div class="field">
                                <label  for="google-analytics-code">
                                    <%= lang('google_analytics_code') %>
                                </label>
                                <%= setting_text "google_analytics_code", placeholder: "G-XXXXXXXXXX" %>
                                <div class="field-hint muted">
                                    <small>
                                        <%= lang('google_analytics_code_hint') %>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                <% end %>
            </turbo-frame>
        </div>
    </div>
</div>

