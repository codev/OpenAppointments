<%# Port of EA pages/login.php. The legacy image captcha branch is dropped; only ALTCHA remains. %>
<div class="text-center mb-4">
    <img src="<%= image_path("logo.png") %>"
         alt="OpenAppointments" class="shadow mb-3" width="72" height="72">
    <h4 class="text-primary fw-semibold mb-1"><%= lang('backend_section') %></h4>
    <p class=" small mb-0"><%= lang('you_need_to_login') %></p>
</div>

<% if flash[:notice] %><div class="alert alert-success"><%= flash[:notice] %></div><% end %>
<% if flash[:alert] %><div class="alert alert-danger"><%= flash[:alert] %></div><% end %>

<%= form_with url: "/login/validate", method: :post, id: "login-form", data: { turbo: false } do %>
    <%= hidden_field_tag :form, "1" %>
    <div class="mb-3">
        <label for="username" class="form-label fw-medium "><%= lang('username') %></label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="fas fa-user "></i></span>
            <%= text_field_tag :username, params[:username], id: "username", placeholder: lang('enter_username_here'),
                               class: "form-control border-start-0 ps-2", required: true, autofocus: true %>
        </div>
    </div>
    <div class="mb-4">
        <label for="password" class="form-label fw-medium "><%= lang('password') %></label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock "></i></span>
            <%= password_field_tag :password, nil, id: "password", placeholder: lang('enter_password_here'),
                                   class: "form-control border-start-0 ps-2", required: true %>
        </div>
    </div>
    <%= render "shared/auth_captcha" %>
    <div class="d-grid gap-2 mb-3">
        <button type="submit" id="login" class="btn btn-primary">
            <i class="fas fa-sign-in-alt me-2"></i>
            <%= lang('login') %>
        </button>
    </div>
    <div class="text-center">
        <a href="/recovery" class="text-decoration-none  small">
            <i class="fas fa-key me-1"></i>
            <%= lang('forgot_your_password') %>
        </a>
    </div>
<% end %>
