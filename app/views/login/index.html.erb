<%# Port of EA pages/login.php. The legacy image captcha branch is dropped; only ALTCHA remains. %>
<div class="centered">
    <img src="<%= image_path("logo.png") %>"
         alt="OpenAppointments"  width="72" height="72">
    <h4 class="text-primary"><%= lang('backend_section') %></h4>
    <p><%= lang('you_need_to_login') %></p>
</div>

<% if flash[:notice] %><div class="notice" data-tone="success"><%= flash[:notice] %></div><% end %>
<% if flash[:alert] %><div class="notice" data-tone="error"><%= flash[:alert] %></div><% end %>

<%= form_with url: "/login/validate", method: :post, id: "login-form", data: { turbo: false } do %>
    <%= hidden_field_tag :form, "1" %>
    <div class="field">
        <label for="username" ><%= lang('username') %></label>
        <div class="input-row">
            <span class="input-addon"><i class="fas fa-user"></i></span>
            <%= text_field_tag :username, params[:username], id: "username", placeholder: lang('enter_username_here'), required: true, autofocus: true %>
        </div>
    </div>
    <div class="field">
        <label for="password" ><%= lang('password') %></label>
        <div class="input-row">
            <span class="input-addon"><i class="fas fa-lock"></i></span>
            <%= password_field_tag :password, nil, id: "password", placeholder: lang('enter_password_here'), required: true %>
        </div>
    </div>
    <%= render "shared/auth_captcha" %>
    <div class="centered">
        <button type="submit" id="login" >
            <i class="fas fa-sign-in-alt"></i>
            <%= lang('login') %>
        </button>
    </div>
    <div>
        <a href="/recovery" >
            <i class="fas fa-key"></i>
            <%= lang('forgot_your_password') %>
        </a>
    </div>
<% end %>
