<%= render "shared/crud_form", record: record, delete_title: lang('delete_blocked_period') do |f| %>
    <div class="mb-3">
        <%= f.label :name, class: "form-label" do %>
            <%= lang('name') %> <span class="text-danger">*</span>
        <% end %>
        <%= f.text_field :name, required: true,
                         class: "form-control #{'is-invalid' if record.errors.include?(:name)}" %>
    </div>

    <div class="mb-3">
        <%= f.label :start_datetime, class: "form-label" do %>
            <%= lang('start') %> <span class="text-danger">*</span>
        <% end %>
        <%= f.datetime_field :start_datetime, required: true, include_seconds: false,
                             class: "form-control #{'is-invalid' if record.errors.include?(:start_datetime)}" %>
    </div>

    <div class="mb-3">
        <%= f.label :end_datetime, class: "form-label" do %>
            <%= lang('end') %> <span class="text-danger">*</span>
        <% end %>
        <%= f.datetime_field :end_datetime, required: true, include_seconds: false,
                             class: "form-control #{'is-invalid' if record.errors.include?(:end_datetime)}" %>
    </div>

    <div class="mb-3">
        <%= f.label :notes, lang('notes'), class: "form-label" %>
        <%= f.text_area :notes, rows: 8, class: "form-control" %>
    </div>
<% end %>
