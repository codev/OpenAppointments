<%= render "shared/crud_form", record: record, delete_title: lang('delete_blocked_period') do |f| %>
    <div class="field">
        <%= f.label :name do %>
            <%= lang('name') %> <span class="required">*</span>
        <% end %>
        <%= f.text_field :name, required: true,
                         class: "#{'is-invalid' if record.errors.include?(:name)}" %>
    </div>

    <div class="field">
        <%= f.label :start_datetime do %>
            <%= lang('start') %> <span class="required">*</span>
        <% end %>
        <%= f.datetime_field :start_datetime, required: true, include_seconds: false,
                             class: "#{'is-invalid' if record.errors.include?(:start_datetime)}" %>
    </div>

    <div class="field">
        <%= f.label :end_datetime do %>
            <%= lang('end') %> <span class="required">*</span>
        <% end %>
        <%= f.datetime_field :end_datetime, required: true, include_seconds: false,
                             class: "#{'is-invalid' if record.errors.include?(:end_datetime)}" %>
    </div>

    <div class="field">
        <%= f.label :notes, lang('notes') %>
        <%= f.text_area :notes, rows: 8 %>
    </div>
<% end %>
