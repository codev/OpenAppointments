<%# Manage data: backups, reports, ODS/10to8 import, database reset (admin only).
    The backups and import status frames poll while a job runs. %>
<div class="container backend-page py-3" id="import-page">
    <div class="col-lg-8 offset-lg-2">
        <h4 class="mb-3 fw-light"><%= lang('data_settings') %></h4>

        <div class="card card-body mb-4">
            <%= render "import/backups", backups: @backups, export_status: @export_status %>
        </div>

        <h5 class="mb-3 fw-light"><%= lang('reports') %></h5>

        <form class="card card-body mb-4" method="get" action="/import/report" id="report-form" data-turbo="false">
            <p class="text-muted small"><%= lang('report_hint') %></p>
            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label for="report-from" class="form-label"><%= lang('report_from') %></label>
                    <input type="date" id="report-from" name="from" class="form-control" required
                           value="<%= vars(:report_from) %>">
                </div>
                <div class="col-sm-6">
                    <label for="report-to" class="form-label"><%= lang('report_to') %></label>
                    <input type="date" id="report-to" name="to" class="form-control" required
                           value="<%= vars(:report_to) %>">
                </div>
            </div>
            <label class="form-label"><%= lang('report_statuses') %></label>
            <input type="hidden" name="status_ids[]" value="">
            <div class="d-flex flex-wrap gap-3 mb-3">
                <% vars(:appointment_statuses).each do |status| %>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="status_ids[]" value="<%= status["id"] %>"
                               id="report-status-<%= status["id"] %>" checked>
                        <label class="form-check-label" for="report-status-<%= status["id"] %>"><%= status["name"] %></label>
                    </div>
                <% end %>
            </div>
            <div>
                <button type="submit" class="btn btn-outline-primary">
                    <i class="fas fa-file-download me-2"></i>
                    <%= lang('download_report') %>
                </button>
            </div>
        </form>

        <p class="text-muted small"><%= lang('import_hint') %></p>

        <%= form_with url: "/import/start", method: :post, multipart: true, id: "import-form", class: "card card-body mb-4", data: { turbo: false } do %>
            <%= hidden_field_tag :form, "1", id: nil %>
            <div class="mb-3">
                <label class="form-label" for="import-type"><%= lang('import_type') %></label>
                <%= select_tag :import_type, options_for_select([ [ "OpenAppointments ODS", "ods" ], [ "Sign In App / 10to8 CSV", "ten_to_eight" ] ]),
                               id: "import-type", class: "form-select", data: { field: "import_type" } %>
            </div>
            <div class="mb-3">
                <%= file_field_tag :file, id: "import-file", class: "form-control", required: true,
                                   accept: ".ods,.csv,application/vnd.oasis.opendocument.spreadsheet,text/csv" %>
            </div>
            <div class="mb-3" id="images-zip-wrapper" data-visible-when="import_type=ods">
                <label class="form-label" for="import-images-file"><%= lang('images_zip_optional') %></label>
                <%= file_field_tag :images_file, id: "import-images-file", class: "form-control", accept: ".zip,application/zip" %>
                <div class="form-text text-muted small"><%= lang('images_zip_hint') %></div>
            </div>
            <div class="alert alert-warning py-2 small mb-3"><%= lang('import_providers_caution') %></div>
            <div class="row mb-3">
                <div class="col-12 col-md-6">
                    <label class="form-label"><%= lang('import_phases') %></label>
                    <% ods_only = %w[appointment_statuses appointment_series working_plan_exceptions notifications webhooks consents] %>
                    <% TenToEight::Load::PHASES.each do |phase| %>
                        <div class="form-check<%= ' ods-only' if ods_only.include?(phase) %>" <%= 'data-visible-when=import_type=ods' if ods_only.include?(phase) %>>
                            <%= check_box_tag "phases[]", phase, !%w[providers assistants admins settings].include?(phase),
                                              id: "phase-#{phase}", class: "form-check-input import-phase" %>
                            <label class="form-check-label" for="phase-<%= phase %>"><%= lang(phase) %></label>
                        </div>
                    <% end %>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="days-back"><%= lang('days_back') %></label>
                    <%= number_field_tag :days_back, 21, id: "days-back", class: "form-control", min: 0, max: 3650 %>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="days-forward"><%= lang('days_forward') %></label>
                    <%= number_field_tag :days_forward, 21, id: "days-forward", class: "form-control", min: 0, max: 3650 %>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" id="analyze-import" class="btn btn-outline-secondary" formaction="/import/analyze"><%= lang('analyze') %></button>
                <button type="submit" id="start-import" class="btn btn-primary"><%= lang('start_import') %></button>
            </div>
            <%= render "import/status", import_status: @import_status, summary: @summary %>
        <% end %>

        <h4 class="mb-3 fw-light text-danger"><%= lang('reset_database') %></h4>
        <%= form_with url: "/import/reset", method: :post, id: "reset-form", class: "card card-body border-danger", data: { turbo: false } do %>
            <%= hidden_field_tag :form, "1", id: nil %>
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <%= lang('reset_database_warning') %>
            </div>
            <div class="form-check mb-3">
                <%= check_box_tag :full, "1", false, id: "full-reset", class: "form-check-input" %>
                <label class="form-check-label" for="full-reset"><%= lang('full_reset_label') %></label>
            </div>
            <div class="mb-3">
                <label class="form-label" for="reset-confirmation"><%= lang('reset_confirmation_hint') %></label>
                <%= text_field_tag :confirmation, nil, id: "reset-confirmation", class: "form-control", autocomplete: "off", data: { field: "confirmation" } %>
            </div>
            <div>
                <button type="submit" id="reset-database" class="btn btn-danger" data-enabled-when="confirmation=I KNOW WHAT I AM DOING">
                    <%= lang('reset_database') %>
                </button>
            </div>
        <% end %>
    </div>
</div>

<% if notice %>
    <script>document.addEventListener('DOMContentLoaded', () => App.Layouts.Backend.displayNotification(<%= notice.to_json.html_safe %>));</script>
<% end %>
