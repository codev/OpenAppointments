<%# Export button and the kept backups; polls every 2 s while an export runs. Locals: backups, export_status. %>
<% working = export_status && %w[queued running].include?(export_status[:state] || export_status["state"]) %>
<% state = export_status && (export_status[:state] || export_status["state"]) %>
<turbo-frame id="backups" <% if working %>data-poll-every="2000" data-poll-src="/data?export_id=<%= params[:export_id] %>"<% end %>>
    <%= form_with url: "/data/export", method: :post, data: { turbo_frame: "backups" } do %>
        <%= hidden_field_tag :form, "1", id: nil %>
        <button type="submit" class="outline" id="export-data" <%= 'disabled' if working %>>
            <i class="fas <%= working ? 'fa-spinner fa-spin' : 'fa-download' %>"></i>
            <%= lang(working ? 'backup_working' : 'export_data') %>
        </button>
    <% end %>
    <% if state == "failed" %>
        <div class="notice" data-tone="error"><%= lang('backup_failed') %></div>
    <% end %>
    <% if backups.any? %>
        <div id="backups-section" >
            <h6><%= lang('backups') %></h6>
            <table class="align-middle" id="backups-table">
                <thead>
                    <tr>
                        <th><%= lang('date') %></th>
                        <th><%= lang('ods_file') %></th>
                        <th><%= lang('zip_file') %></th>
                    </tr>
                </thead>
                <tbody>
                    <% backups.each do |backup| %>
                        <tr>
                            <td><%= backup[:date].strftime("%Y-%m-%d %H:%M") %></td>
                            <% %i[ods zip].each do |kind| %>
                                <td>
                                    <% if (name = backup[:files][kind.to_s]) %>
                                        <%= link_to "#{lang(kind == :ods ? 'ods_file' : 'zip_file')} (#{number_to_human_size(File.size(BackupExport.dir.join(name)))})",
                                                    "/data/download_backup?name=#{ERB::Util.url_encode(name)}", data: { turbo: false } %>
                                    <% end %>
                                </td>
                            <% end %>
                        </tr>
                    <% end %>
                </tbody>
            </table>
            <p class="muted"><%= lang('backups_hint') %></p>
        </div>
    <% end %>
</turbo-frame>
