<%# Port of EA pages/booking_confirmation.php. Rendered with the message layout. %>
<div class="toolbar">
    <div class="centered">
        <div class="toolbar"  style="width: 100px; height: 100px;">
            <i class="fas fa-calendar-check fa-3x success"></i>
        </div>

        <h3 class="success"><%= lang('appointment_registered') %></h3>

        <p class="muted">
            <%= lang('appointment_details_was_sent_to_you') %>
        </p>

        <p class="muted">
            <%= lang('check_spam_folder') %>
        </p>

        <div class="stack">
            <a role="button" href="<%= vars(:company_link).presence || "/" %>" id="go-to-company" >
                <%= t("ea.go_to_company", company: vars(:company_name)) %>
            </a>
        </div>

        <div class="stack">
            <% if vars(:display_add_to_google_calendar) == "1" %>
            <a role="button" href="<%= vars(:add_to_google_url) %>" id="add-to-google-calendar" class="outline" target="_blank">
                <i class="fab fa-google"></i>
                <%= lang('add_to_google_calendar') %>
            </a>
            <% end %>

            <a role="button" href="<%= vars(:ics_url) %>" id="download-ics" class="outline">
                <i class="fas fa-file-download"></i>
                <%= lang('download_ics') %>
            </a>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= render "shared/google_analytics_script", google_analytics_code: vars(:google_analytics_code) %>
    <%= render "shared/matomo_analytics_script",
               matomo_analytics_url: vars(:matomo_analytics_url),
               matomo_analytics_site_id: vars(:matomo_analytics_site_id) %>
    <%= render "shared/umami_analytics_script" %>
<% end %>
