<%# One Inbox or Unknown Inbox message: Done or Undo on the top line, the
    other customers sharing its contact with Move buttons, then the message as
    a bubble whose bottom line has the customer (linked to their conversation)
    and address on the left, the time, Mark as read and (unknown senders)
    Delete on the right. Locals: message, moved (after a Move). %>
<% unread = message.direction == "incoming" && !message.read? %>
<div class="inbox-message py-3 border-bottom<%= ' message-unread' if unread %>" id="inbox-message-<%= message.id %>">
    <div class="inbox-meta d-flex flex-wrap align-items-center gap-2 mb-2">
        <% if local_assigns[:moved] %><span class="badge bg-info inbox-moved"><%= lang('message_moved') %></span><% end %>
        <% if message.direction == "incoming" && message.done? %>
            <span class="text-muted inbox-done-by ms-md-auto">
                <%= lang('inbox_done_by').sub("{name}") { message.done_by&.name.to_s }.sub("{time}") { display_datetime(message.done_at) } %>
            </span>
            <%= button_to lang('undo'), "/messages/#{message.id}/undo_done", class: "btn btn-sm btn-outline-secondary", form_class: "d-inline" %>
        <% elsif message.direction == "incoming" %>
            <%= button_to "/messages/#{message.id}/done", class: "btn btn-sm btn-outline-success", form_class: "d-inline ms-md-auto" do %>
                <i class="fas fa-check-double me-1"></i><%= lang('inbox_done') %>
            <% end %>
        <% end %>
    </div>
    <% others = message.other_customers_on_contact %>
    <% if others.any? %>
        <div class="inbox-shared-contact d-flex flex-wrap align-items-center gap-2 mb-2 text-muted">
            <span><%= lang('message_shared_contact') %> <%= others.map(&:name).join(", ") %></span>
            <% others.each do |other| %>
                <%= button_to lang('message_move_to').sub("{name}") { other.name }, "/messages/#{message.id}/move",
                              params: { customer_id: other.id }, class: "btn btn-sm btn-outline-secondary", form_class: "d-inline" %>
            <% end %>
        </div>
    <% end %>
    <div class="bubble-row <%= message.direction == 'incoming' ? 'in' : 'out' %><%= ' failed' if message.status == 'failed' %>">
        <div class="bubble bubble-<%= message.channel %>" title="<%= Messaging.channel(message.channel)&.label || message.channel %>">
            <% if message.subject.present? %>
                <div class="bubble-subject"><%= message.subject %></div>
            <% end %>
            <div class="bubble-body"><%= message.body %></div>
            <div class="bubble-meta">
                <span class="bubble-who">
                    <% if message.customer %>
                        <a href="/customers?customer_id=<%= message.customer.id %>&section=messages" class="fw-bold"><%= message.customer.name %></a>
                    <% else %>
                        <span class="fw-bold"><%= message.direction == "incoming" ? lang('messages_unknown_sender') : message.audience %></span>
                    <% end %>
                    <span class="text-break"><%= message.direction == "incoming" ? message.from_address : message.to_address %></span>
                </span>
                <span class="bubble-when">
                    <%= brief_datetime(message.created_at) %>
                    <% if message.status == "failed" %>
                        <%= lang('messages_status_failed') %> - <%= Messaging.channel(message.channel)&.label || message.channel %>
                    <% end %>
                    <% if unread %>
                        <a href="#" class="mark-read ms-2" data-id="<%= message.id %>"><%= lang('mark_as_read') %></a>
                    <% end %>
                    <% if message.customer_id.nil? %>
                        <%= button_to "/messages/#{message.id}", method: :delete, class: "btn btn-link btn-sm p-0 ms-2 text-danger",
                                      form_class: "d-inline", title: lang('delete'),
                                      form: { data: { turbo_confirm: lang('message_delete_confirm') } },
                                      data: { turbo_confirm_title: lang('delete'), turbo_confirm_button: lang('delete') } do %>
                            <i class="fas fa-trash-alt"></i>
                        <% end %>
                    <% end %>
                </span>
            </div>
        </div>
    </div>
</div>
