<%# User record fields for admins, assistants and providers: details then settings,
    each full width. Locals: record, delete_title, optional header,
    settings (extra HTML at the end of the settings column), after (a full-width
    row after the columns) and working_plan (a second tab pane; the columns then
    become the details pane). %>
<% picture_url = EaRows.picture_url(record) %>
<% settings = record.settings || record.build_settings %>
<%# Keep typed settings through a failed save (they are not assigned to the record). %>
<% typed = params.dig(controller_name.singularize, :settings) || {} %>
<%= render "shared/crud_form", record: record, delete_title: delete_title, header: local_assigns[:header] do |f| %>
    <div>
    <div class="split" id="details" role="tabpanel">
        <div class="details full">
            <div class="field">
                <%= f.label :name do %>
                    <%= lang('name') %> <span class="required">*</span>
                <% end %>
                <%= f.text_field :name, required: true, maxlength: 220,
                                 class: "#{'is-invalid' if record.errors.include?(:name)}" %>
            </div>

            <div class="record-picture">
                <%= f.label :picture, lang('picture') %>
                <img class="picture-preview" <%= 'hidden' unless picture_url %>
                     style="max-height: 120px;" src="<%= picture_url %>" alt="">
                <%= f.file_field :picture, accept: PictureUpload::ALLOWED_PICTURE_TYPES.join(",") %>
                <% if picture_url %>
                    <div class="choice">
                        <%= f.check_box :remove_picture, checked: false %>
                        <%= f.label :remove_picture, lang('remove_picture') %>
                    </div>
                <% end %>
            </div>

            <div class="field">
                <%= f.label :email do %>
                    <%= lang('email') %> <span class="required">*</span>
                <% end %>
                <%= f.email_field :email, required: true, maxlength: 512,
                                  class: "#{'is-invalid' if record.errors.include?(:email)}" %>
            </div>

            <% { phone_number: 128, mobile_number: 128, address: 256, city: 256, state: 128, zip_code: 64 }.each do |field, max| %>
                <div class="field">
                    <%= f.label field, lang(field.to_s) %>
                    <%= f.text_field field, maxlength: max %>
                </div>
            <% end %>

            <div class="field">
                <%= f.label :notes, lang('notes') %>
                <%= f.text_area :notes, rows: 6 %>
            </div>
        </div>

        <div class="settings full">
            <%= f.fields_for :settings, settings do |s| %>
                <div class="field">
                    <%= s.label :username do %>
                        <%= lang('username') %> <span class="required">*</span>
                    <% end %>
                    <%= s.text_field :username, value: typed.fetch(:username, settings.username), required: true,
                                     maxlength: 256, autocomplete: "off",
                                     class: "#{'is-invalid' if record.errors[:base].include?(lang('username_already_exists'))}" %>
                </div>

                <div class="field">
                    <%= s.label :password do %>
                        <%= lang('password') %> <span class="required">*</span>
                    <% end %>
                    <%= s.password_field :password, value: typed[:password], required: record.new_record?, maxlength: 512,
                                         autocomplete: "new-password" %>
                </div>

                <div class="field">
                    <%= s.label :password_confirmation do %>
                        <%= lang('retype_password') %> <span class="required">*</span>
                    <% end %>
                    <%= s.password_field :password_confirmation, value: typed[:password_confirmation],
                                         required: record.new_record?, maxlength: 512,
                                         autocomplete: "new-password" %>
                </div>
            <% end %>

            <div class="field">
                <%= f.label :language do %>
                    <%= lang('language') %> <span class="required">*</span>
                <% end %>
                <%= f.select :language, Localization.available_languages.map { |l| [ l.capitalize, l ] }, {},
                             required: true %>
            </div>

            <div class="<%= timezone_hidden_class %>">
                <%= f.label :timezone do %>
                    <%= lang('timezone') %> <span class="required">*</span>
                <% end %>
                <%= f.select :timezone, grouped_timezones.map { |continent, zones| [ continent, zones.map { |value, name| [ name, value ] } ] }, {},
                             required: true %>
            </div>

            <% if setting('ldap_is_active').to_s == "1" %>
                <div class="field">
                    <%= f.label :ldap_dn, lang('ldap_dn') %>
                    <%= f.text_field :ldap_dn, maxlength: 100 %>
                </div>
            <% end %>

            <div><label><%= lang('options') %></label></div>
            <%= local_assigns[:settings] %>
        </div>
        <%= local_assigns[:after] %>
    </div>
    <%= local_assigns[:working_plan] %>
    </div>
<% end %>
