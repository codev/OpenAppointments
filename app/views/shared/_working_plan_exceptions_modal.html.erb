<%# Port of EA components/working_plan_exceptions_modal.php. %>
<dialog id="working-plan-exceptions-modal" data-static>
    <article class="wide">
            <div class="dialog-header">
                <h5 class="dialog-title"><%= lang('working_plan_exception') %></h5>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close">&times;</button>
            </div>
            <div class="dialog-body">
                <div class="split">
                    <div class="split">
                        <div class="field full">
                            <label  for="working-plan-exceptions-start-date"><%= lang('start_date') %></label>
                            <input  id="working-plan-exceptions-start-date">
                        </div>
                    </div>
                    <div class="split">
                        <div class="field">
                            <label  for="working-plan-exceptions-end-date"><%= lang('end_date') %></label>
                            <input  id="working-plan-exceptions-end-date">
                        </div>
                    </div>
                </div>

                <div class="choice switch-field" id="working-plan-exceptions-is-non-working-day-group">
                    <input  type="checkbox" id="working-plan-exceptions-is-non-working-day">
                    <label  for="working-plan-exceptions-is-non-working-day">
                        <%= lang('make_non_working_day') %>
                    </label>
                </div>

                <div id="working-plan-exceptions-times">
                <div>
                    <div class="full">
                        <div class="field">
                            <label  for="working-plan-exceptions-start-time"><%= lang('start') %></label>
                            <input  id="working-plan-exceptions-start-time">
                        </div>
                    </div>

                    <div>
                        <div class="field">
                            <label  for="working-plan-exceptions-end-time"><%= lang('end') %></label>
                            <input  id="working-plan-exceptions-end-time">
                        </div>
                    </div>
                </div>

                <div>
                    <div class="field">
                        <label><%= lang('time_off') %></label>
                    </div>
                    <div>
                        <div>
                            <input  id="working-plan-exceptions-time-off-start" aria-label="<%= lang('start') %>">
                        </div>
                    </div>
                    <div>
                        <div>
                            <input  id="working-plan-exceptions-time-off-end" aria-label="<%= lang('end') %>">
                        </div>
                    </div>
                    <div>
                        <div class="field-hint muted"><small><%= lang('time_off_hint') %></small></div>
                    </div>
                </div>

                <h3><%= lang('breaks') %></h3>

                <p>
                    <%= lang('add_breaks_during_each_day') %>
                </p>

                <div>
                    <button type="button" class="outline small-action working-plan-exceptions-add-break">
                        <i class="fas fa-plus-square"></i>
                        <%= lang('add_break') %>
                    </button>
                </div>

                <br>

                <div class="table-scroll">
                    <table class="striped" id="working-plan-exceptions-breaks">
                        <thead>
                        <tr>
                            <th><%= lang('start') %></th>
                            <th><%= lang('end') %></th>
                            <th><%= lang('actions') %></th>
                        </tr>
                        </thead>
                        <tbody><!-- Dynamic Content --></tbody>
                    </table>
                </div>
                </div>

            </div>
            <div class="dialog-footer">

                <button type="button" class="secondary" data-dialog-close>
                    <%= lang('cancel') %>
                </button>
                <button type="button"  id="working-plan-exceptions-save">
                    <i class="fas fa-check-square"></i>
                    <%= lang('save') %>
                </button>
            </div>
    </article>
</dialog>

<% content_for :scripts do %>
    <%= ea_js "components/working_plan_exceptions_modal" %>
<% end %>
