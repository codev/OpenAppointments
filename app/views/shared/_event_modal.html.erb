<%# The event dialog shell: forms load into the frame and the page script opens
    the dialog. Locals: src (optional form to open on load). %>
<dialog id="event-modal" data-static>
    <article class="wide">
        <turbo-frame id="event" <%= "src=#{local_assigns[:src]}" if local_assigns[:src] %>></turbo-frame>
    </article>
</dialog>
