<%# Customer details, posted to booking/confirm (never in a URL). Locals: the
    display_/require_ settings. Half-width fields; long custom fields and notes
    full width. %>
<% customer = @customer || vars(:customer_data) || prefilled_customer %>
<% invalid = Array(@invalid_fields) %>
<%# The lambdas return captured HTML, so each prints once. %>
<% required_star = ->(flag, either: false) { capture do %>
    <% if flag == "1" %><abbr class="required" title="<%= lang('fields_are_required') %>">*</abbr><% elsif either %>
        <abbr class="required-either" title="<%= lang('phone_or_email_required') %>">*</abbr>
        <span class="visually-hidden"><%= lang('phone_or_email_required') %></span>
    <% end %>
<% end } %>
<% text_field = ->(field, label, require, maxlength, either: false) { capture do %>
    <div class="field">
        <label for="<%= field.dasherize %>"><%= label %> <%= required_star.call(require, either: either) %></label>
        <%= text_field_tag "customer[#{field}]", customer[field], id: field.dasherize, maxlength: maxlength,
                           "aria-invalid": (invalid.include?(field) ? "true" : nil), required: require == "1" %>
    </div>
<% end } %>
<div id="wizard-frame-<%= step_number %>" class="wizard-frame">
    <%# novalidate: the script marks the fields and writes the message below them, as the server does. %>
    <%= form_with url: "/booking/confirm", method: :post, id: "info-step-form", html: { novalidate: true },
                  data: { turbo_frame: "wizard", require_phone_or_email: require_phone_or_email } do %>
        <%= hidden_field_tag :form, "1", id: nil %>
        <%= wizard_state_fields %>
        <% if vars(:manage_mode) %>
            <%= hidden_field_tag :manage_mode, "1", id: nil %>
            <%= hidden_field_tag :appointment_hash, vars(:appointment_data)["hash"], id: nil %>
        <% end %>
        <div class="frame-container">
            <h2 class="frame-title"><%= lang('customer_information') %></h2>
            <%= render "shared/booking_notice", shown: vars(:display_booking_notice_info_step) %>
            <div class="frame-content fields" data-columns="2">
                <%= text_field.call("name", lang("name"), "1", 220) %>
                <%= text_field.call("email", lang("email"), require_email, 120, either: require_phone_or_email == "1") if display_email == "1" %>
                <%= text_field.call("phone_number", lang("phone_number"), require_phone_number, 60, either: require_phone_or_email == "1") if display_phone_number == "1" %>
                <% { "address" => [ display_address, require_address ], "city" => [ display_city, require_city ],
                     "zip_code" => [ display_zip_code, require_zip_code ] }.each do |field, (display, require)| %>
                    <%= text_field.call(field, lang(field), require, 120) if display == "1" %>
                <% end %>
                <%= render "shared/custom_fields", name: "customer", values: customer, rows: 2 %>
                <% if display_notes == "1" %>
                    <div class="field full">
                        <label for="notes"><%= lang('notes') %> <%= required_star.call(require_notes) %></label>
                        <%= text_area_tag "customer[notes]", customer["notes"], id: "notes", rows: 2, maxlength: 500,
                                          "aria-invalid": (invalid.include?("notes") ? "true" : nil), required: require_notes == "1" %>
                    </div>
                <% end %>
                <% unless vars(:manage_mode) %>
                    <div class="field full">
                        <label><input type="checkbox" id="remember-me"> <%= lang('remember_me') %></label>
                        <span class="field-hint"><%= lang('remember_me_hint') %></span>
                    </div>
                <% end %>
            </div>
            <div id="form-message" class="notice" data-tone="error" role="alert" <%= 'hidden' unless @error %>><%= @error %></div>
        </div>
        <div class="command-buttons">
            <%= wizard_back_button "time" %>
            <%= wizard_next_button %>
        </div>
    <% end %>
</div>
