<%# Port of EA components/booking_cancellation_frame.php. Locals: manage_mode (bool),
    appointment_data (hash), customer_token, display_delete_personal_information ("1"/"0"). %>
<% if manage_mode %>
    <div id="cancel-appointment-frame" class="manage-bar" data-tone="warning">
        <small><%= lang('cancel_appointment_hint') %></small>
        <button type="button" id="cancel-appointment" class="small-action secondary" data-dialog-open="cancel-appointment-modal">
            <i class="fas fa-calendar-times"></i>
            <%= lang('cancel') %>
        </button>
    </div>
    <dialog id="cancel-appointment-modal">
        <article>
            <form id="cancel-appointment-form" method="post" action="<%= "/booking_cancellation/of/#{appointment_data['hash']}" %>">
                <header>
                    <h5><%= lang('cancel_appointment_title') %></h5>
                    <button type="button" class="dialog-close" aria-label="<%= lang('close') %>" data-dialog-close>&times;</button>
                </header>
                <p><%= lang('write_appointment_cancel_reason') %></p>
                <div class="field">
                    <%= text_area_tag "cancellation_reason", nil, id: "cancellation-reason", rows: 3, required: true %>
                </div>
                <footer>
                    <button type="button" class="secondary" data-dialog-close><%= lang('close') %></button>
                    <button type="submit" id="cancel-appointment-confirm"><%= lang('confirm') %></button>
                </footer>
            </form>
        </article>
    </dialog>
    <% if display_delete_personal_information == "1" %>
        <div class="manage-bar" data-tone="error">
            <small><%= lang('delete_personal_information_hint') %></small>
            <button type="button" id="delete-personal-information" class="small-action destructive" data-dialog-open="delete-personal-information-modal">
                <i class="fas fa-trash"></i>
                <%= lang('delete') %>
            </button>
        </div>
        <dialog id="delete-personal-information-modal">
            <article>
                <%= form_with url: "/privacy/delete_personal_information", method: :post, id: "delete-personal-information-form",
                              data: { turbo: false } do %>
                    <%= hidden_field_tag :form, "1", id: nil %>
                    <%= hidden_field_tag :customer_token, customer_token, id: nil %>
                    <header>
                        <h5><%= lang('delete_personal_information') %></h5>
                        <button type="button" class="dialog-close" aria-label="<%= lang('close') %>" data-dialog-close>&times;</button>
                    </header>
                    <p><%= lang('delete_personal_information_prompt') %></p>
                    <footer>
                        <button type="button" class="secondary" data-dialog-close><%= lang('cancel') %></button>
                        <button type="submit" id="delete-personal-information-confirm" class="destructive"><%= lang('delete') %></button>
                    </footer>
                <% end %>
            </article>
        </dialog>
    <% end %>
<% end %>
