<%# Inbox pages: one block per message, the metadata on a wrapping line and the
    full text beneath it. Locals: messages, page, last_page, base_path. %>
<div class="inbox-list mb-4">
    <% messages.each do |message| %>
        <%= render "shared/inbox_message", message: message %>
    <% end %>
    <% if messages.empty? %>
        <p class="text-muted text-center py-4"><%= lang('no_records_found') %></p>
    <% end %>
</div>

<%= render "shared/messages_pagination", page: page, last_page: last_page, base_path: base_path %>
