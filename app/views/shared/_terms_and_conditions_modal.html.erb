<%# Port of EA components/terms_and_conditions_modal.php. Locals: terms_and_conditions_content (raw HTML by design). %>
<dialog id="terms-and-conditions-modal">
    <article class="wide">
        <header>
            <h4><%= lang('terms_and_conditions') %></h4>
            <button type="button" class="dialog-close" aria-label="<%= lang('close') %>" data-dialog-close>&times;</button>
        </header>
        <div class="dialog-body">
            <%= terms_and_conditions_content&.html_safe %>
        </div>
        <footer>
            <button type="button" class="secondary" data-dialog-close><%= lang('close') %></button>
        </footer>
    </article>
</dialog>
