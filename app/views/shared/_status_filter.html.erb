<%# Status tick boxes for the calendar and appointments pages. Cancelled and
    rescheduled kinds start unticked. %>
<details class="menu" id="status-filter" data-align="start">
    <summary role="button" class="secondary" data-tippy-content="<%= lang('filter_statuses_hint') %>">
        <%= lang('statuses') %>
    </summary>
    <ul>
        <% vars(:appointment_statuses).each do |status| %>
            <li>
                <label>
                    <input type="checkbox" value="<%= status["name"] %>"
                           <%= "checked" unless %w[cancelled rescheduled].include?(status["kind"]) %>>
                    <%= status["name"] %>
                </label>
            </li>
        <% end %>
    </ul>
</details>
