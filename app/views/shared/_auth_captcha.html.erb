<%# Captcha widget for the login/recovery forms, per the captcha_login_enabled setting. %>
<% case Captcha.for_login %>
<% when "altcha" %>
    <div class="centered">
        <div id="altcha-widget" class="altcha-widget"></div>
        <input type="hidden" id="altcha-payload" name="altcha_payload" value="">
        <span id="altcha-hint" class="field-hint required" style="opacity:0">&nbsp;</span>
    </div>
<% when "turnstile" %>
    <div>
        <div class="cf-turnstile" data-sitekey="<%= TurnstileChallenge.site_key %>"
             data-response-field-name="cf_turnstile_response"></div>
        <span id="turnstile-hint" class="field-hint required" style="opacity:0">&nbsp;</span>
    </div>
<% end %>
