<%# Port of EA components/ldap_import_modal.php. Locals: roles ([{id, name, slug}]). %>
<dialog id="ldap-import-modal">
    <article class="wide">
        <%= form_with url: "/ldap_settings/import", method: :post, id: "ldap-import-form", class: "dialog-content", data: { turbo: false } do %>
            <div class="dialog-header">
                <h3 class="dialog-title"><%= lang('import') %></h3>
                <button class="dialog-close" data-dialog-close aria-label="Close">&times;</button>
            </div>

            <div class="dialog-body">
                <div class="field">
                    <label  for="ldap-import-ldap-dn">
                        <%= lang('ldap_dn') %>
                        <span class="required">*</span>
                    </label>
                    <%= text_field_tag "user[ldap_dn]", nil, id: "ldap-import-ldap-dn", maxlength: 256, required: true %>
                </div>

                <div class="field">
                    <label  for="ldap-import-role-slug">
                        <%= lang('role') %>
                        <span class="required">*</span>
                    </label>
                    <select name="role_slug" id="ldap-import-role-slug"  required>
                        <% roles.each do |role| %>
                            <option value="<%= role['slug'] %>">
                                <%= role['name'] %>
                            </option>
                        <% end %>
                    </select>
                </div>

                <div class="field">
                    <label  for="ldap-import-name">
                        <%= lang('name') %>
                        <span class="required">*</span>
                    </label>
                    <%= text_field_tag "user[name]", nil, id: "ldap-import-name", maxlength: 220, required: true %>
                </div>

                <div class="field">
                    <label  for="ldap-import-email">
                        <%= lang('email') %>
                        <span class="required">*</span>
                    </label>
                    <%= text_field_tag "user[email]", nil, id: "ldap-import-email", maxlength: 512, required: true %>
                </div>

                <div class="field">
                    <label  for="ldap-import-phone-number">
                        <%= lang('phone_number') %>
                        <span class="required">*</span>
                    </label>
                    <%= text_field_tag "user[phone_number]", nil, id: "ldap-import-phone-number", maxlength: 128, required: true %>
                </div>

                <div class="field">
                    <label  for="ldap-import-username">
                        <%= lang('username') %>
                    </label>
                    <%= text_field_tag "settings[username]", nil, id: "ldap-import-username", maxlength: 256 %>
                </div>

                <div class="field">
                    <label  for="ldap-import-password">
                        <%= lang('password') %>
                    </label>
                    <%= password_field_tag "settings[password]", nil, id: "ldap-import-password", maxlength: 512, autocomplete: "new-password" %>
                </div>
            </div>

            <div class="dialog-footer">
                <button type="button" class="secondary" data-dialog-close>
                    <%= lang('cancel') %>
                </button>
                <button type="submit" id="ldap-import-save">
                    <i class="fas fa-check-square"></i>
                    <%= lang('save') %>
                </button>
            </div>
        <% end %>
    </article>
</dialog>

<% content_for :scripts do %>
    <%= ea_js "components/ldap_import_modal" %>
<% end %>
