<%# Port of EA components/privacy_policy_modal.php. Locals: privacy_policy_content (raw HTML by design). %>
<dialog id="privacy-policy-modal">
    <article class="wide">
        <header>
            <h4><%= lang('privacy_policy') %></h4>
            <button type="button" class="dialog-close" aria-label="<%= lang('close') %>" data-dialog-close>&times;</button>
        </header>
        <div class="dialog-body">
            <%= privacy_policy_content&.html_safe %>
        </div>
        <footer>
            <button type="button" class="secondary" data-dialog-close><%= lang('close') %></button>
        </footer>
    </article>
</dialog>
