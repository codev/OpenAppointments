<%# Admin CRUD page: list + detail form in nested Turbo Frames. The outer frame
    reloads after save/delete/filter; the inner one swaps the form on row click.
    backend.scss shows either the list or the details, toggled by the editing
    class (rendered for direct visits, kept in sync by utils/crud_page.js).
    Locals: page, title, records, record, editing, keyword, row partial, form
    partial, optional before_add and list_toolbar HTML, can_add (default true). %>
<% frame = controller_name %>
<div class="backend-page <%= 'editing' if editing %>" id="<%= page %>-page" data-crud-page>
    <turbo-frame id="<%= frame %>">
        <% if notice %>
            <div class="notice" data-tone="success"><%= notice %></div>
        <% end %>
        <% if alert %>
            <div class="notice" data-tone="error"><%= alert %></div>
        <% end %>

        <div id="<%= page %>">
            <div class="filter-records column full" id="filter-<%= page %>" >
                <div class="toolbar">
                    <%= local_assigns[:before_add] %>
                    <% if local_assigns.fetch(:can_add, true) %>
                        <%= link_to url_for(action: :new), id: "add-#{page.singularize}",
                                    class: "add-record-btn", role: "button",
                                    data: { turbo_frame: "#{frame}_record" } do %>
                            <i class="fas fa-plus-square"></i>
                            <%= lang('add') %>
                        <% end %>
                    <% end %>
                </div>

                <%= form_with url: url_for(action: :index), method: :get, class: "input-append" do |f| %>
                    <div class="input-row">
                        <%= f.text_field :keyword, value: keyword, class: "key", "aria-label": "keyword" %>
                        <button class="filter secondary" type="submit"
                                data-tippy-content="<%= lang('filter') %>">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                <% end %>

                <h4><%= title %></h4>

                <%= local_assigns[:list_toolbar] %>

                <div class="results" data-keyword="<%= keyword %>">
                    <% if records.empty? %>
                        <em><%= lang('no_records_found') %></em>
                    <% end %>
                    <% records.each do |item| %>
                        <div class="entry <%= page.singularize %>-row <%= 'selected' if record&.id == item.id %>"
                             data-id="<%= item.id %>" <%= 'draggable=true' if local_assigns[:list_toolbar] %>>
                            <%= link_to url_for(action: :edit, id: item), data: { turbo_frame: "#{frame}_record" } do %>
                                <%= render row, record: item %>
                            <% end %>
                        </div>
                        <hr>
                    <% end %>
                    <% if @pagy && @pagy.last > 1 %>
                        <%= raw @pagy.series_nav %>
                    <% end %>
                </div>
            </div>

            <div class="record-details full">
                <h4><%= lang('details') %></h4>
                <turbo-frame id="<%= frame %>_record">
                    <%= render form, record: record if editing %>
                </turbo-frame>
            </div>
        </div>
    </turbo-frame>
</div>

<% content_for :scripts do %>
    <%# Frame-loaded forms cannot add scripts, so the form components load here. %>
    <%= ea_js "utils/drag_reorder", "components/color_selection", "utils/crud_page" %>
<% end %>
