<%# Confirmation: the summary and the register form, everything in hidden fields.
    Locals: manage_mode, display_terms_and_conditions, display_privacy_policy. %>
<% service = selected_service %>
<% provider = selected_provider %>
<% customer = (@customer || {}).merge("timezone" => wizard_customer_timezone) %>
<% provider_zone = Time.find_zone!(wizard_provider_timezone) %>
<% start_at = provider_zone.parse("#{@date} #{@time}") %>
<% customer_start_at = start_at.in_time_zone(customer["timezone"]) %>
<div id="wizard-frame-<%= step_number %>" class="wizard-frame">
    <%# The Back button re-renders the details step in the frame; the booking
        itself leaves the frame for the confirmation page, so only Confirm is a
        plain submit. %>
    <%= form_with url: "/booking/register", method: :post, id: "book-appointment-form" do %>
        <%= hidden_field_tag :form, "1", id: nil %>
        <%= wizard_state_fields %>
        <%= hidden_field_tag "appointment[id_services]", service["id"], id: nil %>
        <%= hidden_field_tag "appointment[id_users_provider]", @provider_id, id: nil %>
        <%= hidden_field_tag "appointment[start_datetime]", start_at.strftime("%Y-%m-%d %H:%M:%S"), id: nil %>
        <%= hidden_field_tag "appointment[notes]", customer["notes"], id: nil %>
        <% customer.except("notes").each do |field, value| %>
            <%= hidden_field_tag "customer[#{field}]", value, id: nil %>
        <% end %>
        <% if vars(:manage_mode) %>
            <%= hidden_field_tag :manage_mode, "1", id: nil %>
            <%= hidden_field_tag :appointment_hash, vars(:appointment_data)["hash"], id: nil %>
            <%= hidden_field_tag "appointment[id]", vars(:appointment_data)["id"], id: nil %>
        <% end %>
        <div class="frame-container">
            <h2 class="frame-title"><%= lang('appointment_confirmation') %></h2>
            <% if @error %>
                <div id="form-message" class="notice" data-tone="error" role="alert"><%= @error %></div>
            <% end %>
            <div class="frame-content summary">
                <div id="appointment-details">
                    <div><i class="fas fa-calendar-day"></i> <strong><%= display_datetime(customer_start_at) %></strong></div>
                    <% if Setting.timezone_support? %>
                        <div class="muted"><small><%= format_timezone(customer["timezone"]) %></small></div>
                    <% end %>
                    <div><%= service["name"] %></div>
                    <div><%= provider["name"] %></div>
                </div>
                <div id="customer-details">
                    <div><strong><%= customer["name"] %></strong></div>
                    <% %w[email phone_number address city zip_code].each do |field| %>
                        <% next if customer[field].blank? %>
                        <div><%= customer[field] %></div>
                    <% end %>
                </div>
            </div>
            <% if TurnstileChallenge.enabled? %>
                <div class="captcha">
                    <div class="cf-turnstile" data-sitekey="<%= TurnstileChallenge.site_key %>"
                         data-response-field-name="cf_turnstile_response"></div>
                    <span id="turnstile-hint" class="captcha-hint">&nbsp;</span>
                </div>
            <% end %>
            <% if AltchaChallenge.enabled? %>
                <div class="captcha">
                    <div id="altcha-widget" class="altcha-widget"></div>
                    <input type="hidden" id="altcha-payload" name="altcha_payload" value="">
                    <span id="altcha-hint" class="captcha-hint">&nbsp;</span>
                </div>
            <% end %>
            <% if display_terms_and_conditions == "1" || display_privacy_policy == "1" %>
                <div class="agreements">
                    <% if display_terms_and_conditions == "1" %>
                        <label>
                            <input type="checkbox" id="accept-to-terms-and-conditions" required>
                            <%= lang('read_and_agree_to_terms_and_conditions')
                                  .sub('{$link}', '<a href="#" data-dialog-open="terms-and-conditions-modal">')
                                  .sub('{/$link}', '</a>').html_safe %>
                        </label>
                    <% end %>
                    <% if display_privacy_policy == "1" %>
                        <label>
                            <input type="checkbox" id="accept-to-privacy-policy" required>
                            <%= lang('read_and_agree_to_privacy_policy')
                                  .sub('{$link}', '<a href="#" data-dialog-open="privacy-policy-modal">')
                                  .sub('{/$link}', '</a>').html_safe %>
                        </label>
                    <% end %>
                </div>
            <% end %>
        </div>
        <div class="command-buttons">
            <button type="submit" id="button-back-5" class="button-back secondary"
                    formaction="/booking/confirm" formnovalidate name="back" value="1" data-turbo-frame="wizard">
                <i class="fas fa-chevron-left"></i>
                <%= lang('back') %>
            </button>
            <button id="book-appointment-submit" type="submit" data-turbo="false">
                <i class="fas fa-check-square"></i>
                <%= vars(:manage_mode) ? lang('update') : lang('confirm') %>
            </button>
        </div>
    <% end %>
</div>
