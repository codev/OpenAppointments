<%# Provider selection: a GET form advancing the wizard. %>
<% providers = selectable_providers %>
<% any_provider = !vars(:manage_mode) && providers.length > 1 && vars(:display_any_provider).to_s == "1" %>
<% cards_mode = vars(:display_mode) == "cards" %>
<div id="wizard-frame-<%= step_number %>" class="wizard-frame">
    <%= form_with url: wizard_form_path, method: :get, id: "provider-step-form", data: { turbo_frame: "wizard", turbo_action: "advance" } do %>
        <%= wizard_state_fields(provider_id: nil, date: nil, time: nil, step: nil) %>
        <%= hidden_field_tag :step, (@step == "first" ? "second" : "time"), id: nil %>
        <div class="frame-container">
            <h2 class="frame-title"><%= lang('select_provider') %></h2>
            <%= render "shared/fully_booked_notice" %>
            <div class="frame-content">
                <div class="field">
                    <label for="select-provider" <%= 'hidden' if cards_mode %>><%= lang('provider') %></label>
                    <select name="provider_id" id="select-provider" <%= 'hidden' if cards_mode %> <%= 'required' unless cards_mode %>>
                        <% if providers.length != 1 %>
                            <option value=""><%= lang('please_select') %></option>
                        <% end %>
                        <% if any_provider %>
                            <option value="<%= BookingPayloads::ANY_PROVIDER %>" <%= 'selected' if @provider_id == BookingPayloads::ANY_PROVIDER %>><%= lang('any_provider') %></option>
                        <% end %>
                        <% providers.each do |provider| %>
                            <option value="<%= provider['id'] %>" <%= 'selected' if provider['id'].to_s == @provider_id.to_s || providers.length == 1 %>><%= provider['name'] %></option>
                        <% end %>
                    </select>
                </div>
                <% if cards_mode %>
                    <div id="provider-cards" class="booking-cards">
                        <% if any_provider %>
                            <div class="booking-card <%= 'selected' if @provider_id == BookingPayloads::ANY_PROVIDER %>"
                                 role="button" tabindex="0" data-provider-id="<%= BookingPayloads::ANY_PROVIDER %>">
                                <div class="booking-card-body"><h5 class="booking-card-title"><%= lang('any_provider') %></h5></div>
                            </div>
                        <% end %>
                        <% providers.each do |provider| %>
                            <div class="booking-card <%= 'selected' if provider['id'].to_s == @provider_id.to_s %>"
                                 role="button" tabindex="0" data-provider-id="<%= provider["id"] %>">
                                <% if provider["picture_url"].present? %>
                                    <img src="<%= provider["picture_url"] %>" class="booking-card-picture" alt="">
                                <% end %>
                                <div class="booking-card-body"><h5 class="booking-card-title"><%= provider["name"] %></h5></div>
                            </div>
                        <% end %>
                    </div>
                <% end %>
                <div id="provider-description" class="selection-details">
                    <% providers.each do |provider| %>
                        <div class="selection-description" data-for-provider="<%= provider['id'] %>" hidden>
                            <% if !cards_mode && provider["picture_url"].present? %>
                                <img src="<%= provider["picture_url"] %>" alt="<%= provider["name"] %>" class="selection-picture">
                            <% end %>
                            <% [ provider["about"], provider["services_description"] ].each do |text| %>
                                <% next if text.blank? %>
                                <div class="muted"><%= simple_format(text) %></div>
                            <% end %>
                        </div>
                    <% end %>
                </div>
            </div>
        </div>
        <div class="command-buttons">
            <% if @step == "first" %>
                <% if !vars(:manage_mode) && setting("display_order_switch", "1").to_s == "1" %>
                    <a class="swap-first-step secondary" role="button" data-turbo-action="advance"
                       href="<%= wizard_step_path('first', first: 'service', service_id: nil, provider_id: nil) %>">
                        <%= lang('select_service_first') %>
                    </a>
                <% else %>
                    <span>&nbsp;</span>
                <% end %>
            <% else %>
                <%= wizard_back_button "first" %>
            <% end %>
            <%= wizard_next_button %>
        </div>
    <% end %>
</div>
