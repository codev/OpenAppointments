<%# Previous/next links. Locals: page, last_page, base_path. %>
<% page_url = ->(n) { "#{base_path}#{base_path.include?('?') ? '&' : '?'}page=#{n}" } %>
<div class="toolbar spaced">
    <% if page > 1 %>
        <a role="button" class="secondary" href="<%= page_url.call(page - 1) %>">
            <i class="fas fa-chevron-left"></i><%= lang('previous') %>
        </a>
    <% else %>
        <span></span>
    <% end %>
    <% unless last_page %>
        <a role="button" class="secondary" href="<%= page_url.call(page + 1) %>">
            <%= lang('next') %><i class="fas fa-chevron-right"></i>
        </a>
    <% end %>
</div>
