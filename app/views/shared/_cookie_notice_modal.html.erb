<%# Port of EA components/cookie_notice_modal.php. Locals: cookie_notice_content (raw HTML by design). %>
<dialog id="cookie-notice-modal">
    <article class="wide">
        <header>
            <h4><%= lang('cookie_notice') %></h4>
            <button type="button" class="dialog-close" aria-label="<%= lang('close') %>" data-dialog-close>&times;</button>
        </header>
        <div class="dialog-body">
            <%= cookie_notice_content&.html_safe %>
        </div>
        <footer>
            <button type="button" class="secondary" data-dialog-close><%= lang('close') %></button>
        </footer>
    </article>
</dialog>
