<%# Port of EA components/backend_header.php. Locals: active_menu. %>
<header id="header" class="app-header">
    <div id="header-logo" class="brand toolbar">
        <img src="<%= vars(:company_logo).presence || image_path("logo.png") %>" alt="">
        <div>
            <strong>OpenAppointments</strong>
            <small id="header-user"><%= vars(:user_display_name) %></small>
        </div>
    </div>

    <button type="button" class="menu-toggle" aria-controls="header-menu" aria-expanded="false" aria-label="Menu">
        <i class="fas fa-bars"></i>
    </button>

    <nav id="header-menu">
        <ul class="main-menu">
            <% if can?(:view, :appointments) %>
                <li <%= 'aria-current="page"'.html_safe if active_menu == "appointments" %>>
                    <a href="/appointments" data-tippy-content="<%= lang('manage_appointment_record_hint') %>">
                        <i class="fas fa-list"></i>
                        <span><%= lang('appointments') %></span>
                    </a>
                </li>
                <li <%= 'aria-current="page"'.html_safe if active_menu == "calendar" %>>
                    <a href="/calendar" data-tippy-content="<%= lang('manage_appointment_record_hint') %>">
                        <i class="fas fa-calendar-alt"></i>
                        <span><%= lang('calendar') %></span>
                    </a>
                </li>
            <% end %>

            <% if can?(:view, :customers) %>
                <li <%= 'aria-current="page"'.html_safe if active_menu == "inbox" %>>
                    <a href="/inbox" data-tippy-content="<%= lang('inbox_hint') %>">
                        <i class="fas fa-inbox"></i>
                        <span><%= lang('inbox') %></span>
                        <span id="inbox-unread" class="count" <%= 'hidden' unless vars(:inbox_unread).to_i.positive? %>><%= vars(:inbox_unread) %></span>
                    </a>
                </li>
                <li <%= 'aria-current="page"'.html_safe if active_menu == "customers" %>>
                    <a href="/customers" data-tippy-content="<%= lang('manage_customers_hint') %>">
                        <i class="fas fa-user-friends"></i>
                        <span><%= lang('customers') %></span>
                    </a>
                </li>
            <% end %>

            <% if can?(:view, :services) %>
                <li <%= 'aria-current="page"'.html_safe if active_menu == "services" %>>
                    <details class="menu">
                        <summary data-tippy-content="<%= lang('manage_services_hint') %>">
                            <i class="fas fa-business-time"></i>
                            <span><%= lang('services') %></span>
                        </summary>
                        <ul>
                            <li><a href="/services"><%= lang('services') %></a></li>
                            <li><a href="/service_categories"><%= lang('categories') %></a></li>
                        </ul>
                    </details>
                </li>
            <% end %>

            <% if can?(:view, :users) %>
                <li <%= 'aria-current="page"'.html_safe if active_menu == "users" %>>
                    <details class="menu">
                        <summary data-tippy-content="<%= lang('manage_users_hint') %>">
                            <i class="fas fa-users"></i>
                            <span><%= lang('users') %></span>
                        </summary>
                        <ul>
                            <li><a href="/providers"><%= lang('providers') %></a></li>
                            <li><a href="/assistants"><%= lang('assistants') %></a></li>
                            <li><a href="/admins"><%= lang('admins') %></a></li>
                        </ul>
                    </details>
                </li>
            <% end %>

            <% if can?(:view, :system_settings) || can?(:view, :user_settings) %>
                <li <%= 'aria-current="page"'.html_safe if %w[system_settings messages].include?(active_menu) %>>
                    <details class="menu">
                        <summary aria-label="<%= lang('settings') %>" data-tippy-content="<%= lang('settings_hint') %>">
                            <i class="fas fa-cog"></i>
                        </summary>
                        <ul>
                            <% if can?(:view, :system_settings) %>
                                <li><a href="/general_settings"><i class="fas fa-cogs"></i> <%= lang('settings') %></a></li>
                                <li><a href="/messages_settings"><i class="fas fa-envelope"></i> <%= lang('message_settings') %></a></li>
                            <% end %>
                            <% if [ Role::ADMIN, Role::ASSISTANT ].include?(session[:role_slug]) %>
                                <% unknown_unread = Message.unread.unknown_sender.count %>
                                <li>
                                    <a href="/unknown_inbox">
                                        <i class="fas fa-inbox"></i> <%= lang('unknown_inbox') %>
                                        <% if unknown_unread.positive? %><span class="count"><%= unknown_unread %></span><% end %>
                                    </a>
                                </li>
                            <% end %>
                            <% if can?(:edit, :system_settings) %>
                                <li><a href="/data"><i class="fas fa-file-import"></i> <%= lang('manage_data') %></a></li>
                                <li><hr></li>
                            <% end %>
                            <li><a href="/account"><i class="fas fa-user"></i> <%= lang('account') %></a></li>
                            <li><a href="/about"><i class="fas fa-info-circle"></i> <%= lang('about') %></a></li>
                            <li><hr></li>
                            <li><a href="/booking" target="_blank"><i class="fas fa-external-link"></i> <%= lang('booking') %></a></li>
                            <li><hr></li>
                            <li><a href="/logout" data-turbo="false"><i class="fas fa-sign-out"></i> <%= lang('log_out') %></a></li>
                        </ul>
                    </details>
                </li>
            <% end %>
        </ul>
    </nav>
</header>

<div id="notification" hidden></div>

<div id="loading" class="loading-overlay" hidden>
    <span class="loading" role="status" aria-label="Loading"></span>
</div>
