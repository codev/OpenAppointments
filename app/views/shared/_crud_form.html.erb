<%# Wraps a CRUD detail form: error message, fields (block), save/cancel, delete.
    Locals: record, delete_title, optional header HTML placed before the form (for
    buttons that post elsewhere, since forms cannot nest); the block renders the
    fields with the builder. %>
<%= local_assigns[:header] %>
<%# Delete sits at the right end of the button row; its form attribute points at
    the separate delete form after the record form, since forms cannot nest. %>
<% delete_form_id = "delete-#{controller_name.singularize}-#{record.id}" %>
<%= form_with model: record, scope: controller_name.singularize, class: "crud-form",
              url: url_for(record.persisted? ? { action: :update, id: record } : { action: :create }),
              data: { turbo_frame: controller_name } do |f| %>
    <% if record.errors.any? %>
        <div class="form-message notice" data-tone="error">
            <%= record.errors[:base].first || lang('fields_are_required') %>
        </div>
    <% end %>

    <%= yield f %>

    <div class="actions toolbar">
        <button type="submit" >
            <i class="fas fa-check-square"></i>
            <%= lang('save') %>
        </button>
        <%= link_to lang('cancel'), url_for(action: :index, selected: record.id), class: "secondary",
                    data: { turbo_frame: controller_name } %>
        <% if record.persisted? %>
            <button type="submit" form="<%= delete_form_id %>" class="destructive trailing"
                    data-turbo-confirm-title="<%= delete_title %>">
                <i class="fas fa-trash-alt"></i>
                <%= lang('delete') %>
            </button>
        <% end %>
    </div>
<% end %>

<% if record.persisted? %>
    <%= form_with url: url_for(action: :destroy, id: record), method: :delete, id: delete_form_id,
                  data: { turbo_frame: controller_name, turbo_confirm: lang('delete_record_prompt') } do %>
    <% end %>
<% end %>
