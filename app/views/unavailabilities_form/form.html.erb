<% new_record = @unavailability.new_record? %>
<turbo-frame id="event">
    <%= form_with url: (new_record ? unavailabilities_path : unavailability_path(@unavailability)), method: (new_record ? :post : :patch),
                  id: "unavailability-form", class: "event-form" do %>
        <div class="modal-header">
            <h3 class="modal-title"><%= lang(new_record ? 'new_unavailability_title' : 'edit_unavailability_title') %></h3>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
            <% if @error %><div class="modal-message alert alert-danger"><%= @error %></div><% end %>
            <div class="mb-3">
                <label for="unavailability-provider" class="form-label"><%= lang('provider') %></label>
                <select name="unavailability[id_users_provider]" id="unavailability-provider" class="form-select" required>
                    <% @providers.each do |provider| %>
                        <option value="<%= provider.id %>" data-timezone="<%= format_timezone(provider.effective_timezone) %>"
                                <%= 'selected' if provider.id == @unavailability.id_users_provider %>><%= provider.name %></option>
                    <% end %>
                </select>
            </div>
            <div class="mb-3">
                <label for="unavailability-start" class="form-label"><%= lang('start') %> <span class="text-danger">*</span></label>
                <%= render "shared/event_datetime", name: "unavailability[start_datetime]", value: @unavailability.start_datetime, id: "unavailability-start" %>
            </div>
            <div class="mb-3">
                <label for="unavailability-end" class="form-label"><%= lang('end') %> <span class="text-danger">*</span></label>
                <%= render "shared/event_datetime", name: "unavailability[end_datetime]", value: @unavailability.end_datetime, id: "unavailability-end" %>
            </div>
            <div class="mb-3<%= timezone_hidden_class %>">
                <label class="form-label"><%= lang('timezone') %></label>
                <div class="border rounded d-flex justify-content-between align-items-center bg-light timezone-info">
                    <div class="border-end w-50 p-1 text-center">
                        <small><%= lang('provider') %>: <span class="provider-timezone">-</span></small>
                    </div>
                    <div class="w-50 p-1 text-center">
                        <small><%= lang('current_user') %>: <span><%= timezones[session[:timezone].presence || "UTC"] %></span></small>
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label for="unavailability-notes" class="form-label"><%= lang('notes') %></label>
                <%= text_area_tag "unavailability[notes]", @unavailability.notes, id: "unavailability-notes", rows: 6, class: "form-control" %>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= lang('cancel') %></button>
            <button type="submit" id="save-unavailability" class="btn btn-primary">
                <i class="fas fa-check-square me-2"></i><%= lang('save') %>
            </button>
        </div>
    <% end %>
</turbo-frame>
