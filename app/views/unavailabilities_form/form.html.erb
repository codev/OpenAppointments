<% new_record = @unavailability.new_record? %>
<turbo-frame id="event">
    <%= form_with url: (new_record ? unavailabilities_path : unavailability_path(@unavailability)), method: (new_record ? :post : :patch),
                  id: "unavailability-form", class: "event-form" do %>
        <div class="dialog-header">
            <h3 class="dialog-title"><%= lang(new_record ? 'new_unavailability_title' : 'edit_unavailability_title') %></h3>
            <button type="button" class="dialog-close" data-dialog-close aria-label="Close">&times;</button>
        </div>
        <div class="dialog-body">
            <% if @error %><div class="modal-message notice" data-tone="error"><%= @error %></div><% end %>
            <div class="field">
                <label for="unavailability-provider"><%= lang('provider') %></label>
                <select name="unavailability[id_users_provider]" id="unavailability-provider"  required>
                    <% @providers.each do |provider| %>
                        <option value="<%= provider.id %>" data-timezone="<%= format_timezone(provider.effective_timezone) %>"
                                <%= 'selected' if provider.id == @unavailability.id_users_provider %>><%= provider.name %></option>
                    <% end %>
                </select>
            </div>
            <div class="field">
                <label for="unavailability-start"><%= lang('start') %> <span class="required">*</span></label>
                <%= render "shared/event_datetime", name: "unavailability[start_datetime]", value: @unavailability.start_datetime, id: "unavailability-start" %>
            </div>
            <div class="field">
                <label for="unavailability-end"><%= lang('end') %> <span class="required">*</span></label>
                <%= render "shared/event_datetime", name: "unavailability[end_datetime]", value: @unavailability.end_datetime, id: "unavailability-end" %>
            </div>
            <div class="<%= timezone_hidden_class %>">
                <label><%= lang('timezone') %></label>
                <div class="timezone-info toolbar spaced">
                    <div class="centered">
                        <small><%= lang('provider') %>: <span class="provider-timezone">-</span></small>
                    </div>
                    <div class="centered">
                        <small><%= lang('current_user') %>: <span><%= timezones[session[:timezone].presence || "UTC"] %></span></small>
                    </div>
                </div>
            </div>
            <div class="field">
                <label for="unavailability-notes"><%= lang('notes') %></label>
                <%= text_area_tag "unavailability[notes]", @unavailability.notes, id: "unavailability-notes", rows: 6 %>
            </div>
        </div>
        <div class="dialog-footer">
            <button type="button" class="secondary" data-dialog-close><%= lang('cancel') %></button>
            <button type="submit" id="save-unavailability">
                <i class="fas fa-check-square"></i><%= lang('save') %>
            </button>
        </div>
    <% end %>
</turbo-frame>
