<%# Appointment dialog: the appointment on the left and its customer below, as
    EA's appointments modal. A new appointment offers a repeat pattern. %>
<% new_record = @appointment.new_record? %>
<% fields = { email: 120, phone_number: 60, address: 120, city: 120, zip_code: 120 } %>
<turbo-frame id="event">
    <%= form_with url: (new_record ? appointments_path : appointment_path(@appointment)), method: (new_record ? :post : :patch),
                  id: "appointment-form", class: "event-form",
                  data: { ask_notify: (new_record ? lang('new_appointment_title') : lang('appointment_update')),
                          ask_notify_question: (new_record ? "notify_users_on_create_question" : "notify_users_on_update_question") } do |f| %>
        <div class="dialog-header">
            <h3 class="dialog-title"><%= new_record ? lang('new_appointment_title') : lang('edit_appointment_title') %></h3>
            <button type="button" class="dialog-close" data-dialog-close aria-label="Close">&times;</button>
        </div>
        <div class="dialog-body">
            <% if @error %>
                <div class="modal-message notice" data-tone="error"><%= @error %></div>
            <% end %>
            <%= hidden_field_tag "notify_users", "", id: "notify-users" %>
            <%= hidden_field_tag "force_save", "1", id: "force-save" if @force_save %>
            <% if @appointment.series %>
                <div id="appointment-series-summary" class="notice" data-tone="info">
                    <i class="fas fa-redo"></i><span><%= @appointment.series.description %></span>
                </div>
            <% end %>

            <fieldset>
                <div class="split">
                    <div class="split">
                        <div class="field">
                            <label for="select-service"><%= lang('service') %> <span class="required">*</span></label>
                            <% grouped = @services.group_by { |service| service.category&.name } %>
                            <select name="appointment[id_services]" id="select-service"  required
                                    data-durations="<%= @services.to_h { |s| [ s.id, s.duration ] }.to_json %>"
                                    data-colors="<%= @services.to_h { |s| [ s.id, s.color ] }.to_json %>">
                                <% if grouped.keys.compact.any? %>
                                    <% grouped.each do |category, services| %>
                                        <optgroup label="<%= category || 'Uncategorized' %>">
                                            <% services.each do |service| %>
                                                <option value="<%= service.id %>" <%= 'selected' if service.id == @appointment.id_services %>><%= service.name %></option>
                                            <% end %>
                                        </optgroup>
                                    <% end %>
                                <% else %>
                                    <% @services.each do |service| %>
                                        <option value="<%= service.id %>" <%= 'selected' if service.id == @appointment.id_services %>><%= service.name %></option>
                                    <% end %>
                                <% end %>
                            </select>
                        </div>

                        <div class="field">
                            <label for="select-provider"><%= lang('provider') %> <span class="required">*</span></label>
                            <select name="appointment[id_users_provider]" id="select-provider"  required>
                                <% @providers.each do |provider| %>
                                    <option value="<%= provider.id %>" data-services="<%= provider.services.map(&:id).to_json %>"
                                            data-timezone="<%= format_timezone(provider.effective_timezone) %>"
                                            <%= 'selected' if provider.id == @appointment.id_users_provider %>><%= provider.name %></option>
                                <% end %>
                            </select>
                        </div>

                        <div>
                            <%= render "shared/color_selection", attributes: 'id="appointment-color"', name: "appointment[color]",
                                       value: @appointment.color %>
                        </div>

                        <div class="field">
                            <label for="appointment-location"><%= lang('location') %></label>
                            <%= text_field_tag "appointment[location]", @appointment.location, id: "appointment-location" %>
                        </div>

                        <div class="field">
                            <label for="appointment-meeting-link"><%= lang('meeting_link') %></label>
                            <%= text_field_tag "appointment[meeting_link]", @appointment.meeting_link, id: "appointment-meeting-link", placeholder: "https://" %>
                        </div>

                        <div class="field">
                            <label for="appointment-status"><%= lang('status') %></label>
                            <%= select_tag "appointment[status]", options_for_select(@statuses.map { |s| [ s["name"], s["name"] ] }, @appointment.status.presence),
                                           id: "appointment-status" %>
                        </div>

                        <% if new_record %>
                            <div id="appointment-repeat">
                                <%= render "shared/repeat_fields", prefix: "repeat" %>
                            </div>
                        <% end %>
                    </div>

                    <div>
                        <div class="field">
                            <label for="start-datetime"><%= lang('start_date_time') %></label>
                            <%= render "shared/event_datetime", name: "appointment[start_datetime]", value: @appointment.start_datetime, id: "start-datetime" %>
                        </div>
                        <div class="field">
                            <label for="end-datetime"><%= lang('end_date_time') %></label>
                            <%= render "shared/event_datetime", name: "appointment[end_datetime]", value: @appointment.end_datetime, id: "end-datetime" %>
                        </div>
                        <div class="<%= timezone_hidden_class %>">
                            <label><%= lang('timezone') %></label>
                            <div class="timezone-info toolbar spaced">
                                <div class="centered">
                                    <small><%= lang('provider') %>: <span class="provider-timezone">-</span></small>
                                </div>
                                <div class="centered">
                                    <small><%= lang('current_user') %>: <span><%= timezones[session[:timezone].presence || "UTC"] %></span></small>
                                </div>
                            </div>
                        </div>
                        <div class="field">
                            <label for="appointment-notes">
                                <%= lang('notes') %>
                                <% if vars(:require_notes) %><span class="required">*</span><% end %>
                            </label>
                            <%= text_area_tag "appointment[notes]", @appointment.notes, id: "appointment-notes", rows: 6,
                                              required: vars(:require_notes) %>
                        </div>
                    </div>
                </div>
            </fieldset>
            <br>
            <fieldset>
                <h5>
                    <%= lang('customer_details_title') %>
                    <button id="new-customer" class="secondary small-action" type="button"
                            data-tippy-content="<%= lang('clear_fields_add_existing_customer_hint') %>">
                        <i class="fas fa-plus-square"></i><%= lang('new') %>
                    </button>
                    <button id="select-customer" class="secondary small-action" type="button"
                            data-tippy-content="<%= lang('pick_existing_customer_hint') %>">
                        <i class="fas fa-hand-pointer"></i><span><%= lang('select') %></span>
                    </button>
                    <input id="filter-existing-customers" placeholder="<%= lang('type_to_filter_customers') %>"
                           style="display: none;" class="input-sm">
                </h5>
                <div id="existing-customers-list" style="display: none;">
                    <% @customers.each do |customer| %>
                        <div data-id="<%= customer.id %>" data-customer="<%= EaRows.customer_row(customer).to_json %>"><%= customer.name.presence || "[No Name]" %></div>
                    <% end %>
                </div>
                <%= hidden_field_tag "customer[id]", @customer.id, id: "customer-id" %>
                <div>
                    <div>
                        <div class="field">
                            <label for="name"><%= lang('name') %> <span class="required">*</span></label>
                            <%= text_field_tag "customer[name]", @customer.name, id: "name", maxlength: 220, required: true %>
                        </div>
                        <% %i[email phone_number].each do |field| %>
                            <% next unless vars(:"display_#{field}") %>
                            <div class="field">
                                <label for="<%= field.to_s.dasherize %>" >
                                    <%= lang(field.to_s) %>
                                    <% if vars(:"require_#{field}") %><span class="required">*</span><% end %>
                                </label>
                                <%= text_field_tag "customer[#{field}]", @customer.public_send(field), id: field.to_s.dasherize,
                                                   maxlength: fields[field], required: vars(:"require_#{field}") %>
                            </div>
                        <% end %>
                        <div class="field">
                            <label  for="language"><%= lang('language') %> <span class="required">*</span></label>
                            <%= select_tag "customer[language]", options_for_select(Localization.available_languages.map { |l| [ l.capitalize, l ] },
                                                                                    @customer.language.presence || setting('default_language')),
                                           id: "language", required: true %>
                        </div>
                        <%= render "shared/custom_fields", name: "customer", record: @customer %>
                    </div>
                    <div>
                        <% %i[address city zip_code].each do |field| %>
                            <% next unless vars(:"display_#{field}") %>
                            <div class="field">
                                <label for="<%= field.to_s.dasherize %>" >
                                    <%= lang(field.to_s) %>
                                    <% if vars(:"require_#{field}") %><span class="required">*</span><% end %>
                                </label>
                                <%= text_field_tag "customer[#{field}]", @customer.public_send(field), id: field.to_s.dasherize,
                                                   maxlength: fields[field], required: vars(:"require_#{field}") %>
                            </div>
                        <% end %>
                        <div class="<%= timezone_hidden_class %>">
                            <label  for="timezone"><%= lang('timezone') %> <span class="required">*</span></label>
                            <%= select_tag "customer[timezone]",
                                           grouped_options_for_select(grouped_timezones.map { |c, zones| [ c, zones.map { |v, n| [ n, v ] } ] },
                                                                      @customer.timezone.presence || setting('default_timezone')),
                                           id: "timezone", required: true %>
                        </div>
                        <div class="field">
                            <label for="customer-notes"><%= lang('notes') %></label>
                            <%= text_area_tag "customer[notes]", @customer.notes, id: "customer-notes", rows: 6 %>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="dialog-footer">
            <button type="button" class="secondary" data-dialog-close><%= lang('cancel') %></button>
            <button type="submit" id="save-appointment">
                <i class="fas fa-check-square"></i><%= lang('save') %>
            </button>
        </div>
    <% end %>
</turbo-frame>
