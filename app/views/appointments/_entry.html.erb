<%# One entry of a provider's day. Appointments and unavailabilities are buttons
    carrying the calendar popover's data (pages/appointments opens it); a free
    slot links to a new appointment. Locals: entry (ProviderDay::Entry), day,
    formats, unread_counts (customer id => unread messages). %>
<% time = ->(t) { t.strftime(MailerFormatHelper::TIME_FORMATS[formats[:time_format]] || MailerFormatHelper::TIME_FORMATS["regular"]).strip } %>
<% classes = "day-entry day-entry-#{entry.kind} d-block text-reset text-decoration-none" %>
<% style = entry.color ? "border-left-color: #{entry.color}" : nil %>
<% content = capture do %>
    <small class="day-entry-time"><%= time.call(entry.start) %> - <%= time.call(entry.end) %></small>
    <span class="day-entry-title"><%= entry.title %></span>
<% end %>
<% case entry.kind %>
<% when "appointment", "freed" %>
    <% row = EaRows.calendar_appointment_row(entry.record, unread_messages: unread_counts[entry.record.id_users_customer] || 0) %>
    <%= button_tag content, type: "button", class: classes, style: style, title: entry.title,
                            data: { event: row.to_json, title: entry.title } %>
<% when "unavailability" %>
    <%= button_tag content, type: "button", class: classes, style: style, title: entry.title,
                            data: { event: EaRows.calendar_unavailability_row(entry.record).to_json, title: entry.title } %>
<% when "free" %>
    <%= link_to content, new_appointment_path(start: entry.start.strftime("%Y-%m-%d %H:%M:%S"), provider_id: day.provider.id),
                class: classes, style: style, title: entry.title, data: { turbo_frame: "event" } %>
<% else %>
    <%= content_tag :div, content, class: classes, style: style, title: entry.title %>
<% end %>
