<%# Appointments page: a day column per provider for one or three days. %>
<div class="container-fluid backend-page pt-0 pb-0" id="calendar-page">
    <div class="row mb-3 text-white py-3 bg-dark" id="calendar-toolbar">
        <div id="calendar-filter" class="col-lg-8">
            <div class="calendar-filter-items d-flex flex-wrap gap-2">
                <select id="select-day-interval" class="form-select"
                        data-tippy-content="<%= lang('select_day_interval_hint') %>" aria-label="Days">
                    <option value="1">1 <%= lang('day') %></option>
                    <option value="3">3 <%= lang('days') %></option>
                </select>
                <select id="filter-provider" class="form-select filter-group"
                        data-tippy-content="<%= lang('filter_providers_hint') %>" aria-label="<%= lang('provider') %>">
                    <option value=""><%= lang('all_providers') %></option>
                    <% vars(:available_providers).each do |provider| %>
                        <option value="<%= provider["id"] %>"><%= provider["name"] %></option>
                    <% end %>
                </select>
                <select id="filter-service" class="form-select filter-group"
                        data-tippy-content="<%= lang('filter_services_hint') %>" aria-label="<%= lang('service') %>">
                    <option value=""><%= lang('all_services') %></option>
                    <% vars(:available_services).each do |service| %>
                        <option value="<%= service["id"] %>"><%= service["name"] %></option>
                    <% end %>
                </select>
                <%= render "shared/status_filter" %>
            </div>
        </div>

        <div id="calendar-actions" class="col-lg-4 text-md-end">
            <%= render "calendar/actions", working_plan_exception: false %>
        </div>
    </div>

    <div id="calendar">
        <div class="calendar-header fc fc-direction-ltr fc-theme-standard">
            <div class="fc-toolbar fc-header-toolbar">
                <div class="fc-toolbar-chunk">
                    <div class="fc-button-group">
                        <button type="button" class="fc-prev-button fc-button fc-button-primary" id="previous-day"
                                aria-label="<%= lang('previous') %>">
                            <span class="fc-icon fc-icon-chevron-left"></span>
                        </button>
                        <button type="button" class="fc-next-button fc-button fc-button-primary" id="next-day"
                                aria-label="<%= lang('next') %>">
                            <span class="fc-icon fc-icon-chevron-right"></span>
                        </button>
                    </div>
                    <button type="button" class="fc-today-button fc-button fc-button-primary" id="today">
                        <%= lang('today') %>
                    </button>
                </div>
                <div class="fc-toolbar-chunk">
                    <input type="text" id="select-date" class="form-control d-inline-block select-date">
                </div>
                <div class="fc-toolbar-chunk">
                    <button type="button" class="btn btn-outline-primary" id="toggle-series">
                        <i class="fas fa-redo me-2"></i><span><%= lang('repeating_appointments') %></span>
                    </button>
                </div>
            </div>
        </div>
        <div id="not-working-notes" class="text-muted mb-2"></div>
        <div class="calendar-view"><div></div></div>

        <div id="series-view" class="d-none">
            <h5 class="fw-light mb-3"><%= lang('repeating_appointments') %></h5>
            <div class="table-responsive">
                <table class="table table-striped align-middle" id="series-table">
                    <thead>
                    <tr>
                        <th><%= lang('provider') %></th>
                        <th><%= lang('customer') %></th>
                        <th><%= lang('service') %></th>
                        <th><%= lang('repeats') %></th>
                        <th><%= lang('next_appointment') %></th>
                        <th><%= lang('not_booked') %></th>
                        <th><%= lang('actions') %></th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <p id="series-empty" class="text-muted d-none"><%= lang('no_repeating_appointments') %></p>
        </div>
    </div>
</div>

<div class="modal" id="series-pattern-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= lang('change_pattern') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small"><%= lang('change_pattern_hint') %></p>
                <%= render "shared/repeat_fields", prefix: "series-repeat" %>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= lang('cancel') %></button>
                <button type="button" class="btn btn-primary" id="series-pattern-save">
                    <i class="fas fa-check-square me-2"></i><%= lang('save') %>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="series-cancel-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= lang('cancel_series') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small"><%= lang('cancel_series_hint') %></p>
                <div id="series-cancel-dates" class="mb-3" style="max-height: 16rem; overflow-y: auto;"></div>
                <label class="form-label" for="series-cancel-reason"><%= lang('reason') %></label>
                <textarea id="series-cancel-reason" class="form-control" rows="2"></textarea>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="series-cancel-notify" checked>
                    <label class="form-check-label" for="series-cancel-notify"><%= lang('notify_customer') %></label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= lang('close') %></button>
                <button type="button" class="btn btn-danger" id="series-cancel-confirm">
                    <i class="fas fa-calendar-times me-2"></i><%= lang('cancel_series_from') %>
                </button>
            </div>
        </div>
    </div>
</div>

<%= render "calendar/modals" %>

<% content_for :scripts do %>
    <%= javascript_include_tag "vendor/fullcalendar/index.global.min",
                               "vendor/fullcalendar-moment/index.global.min",
                               "vendor/jquery-jeditable/jquery.jeditable.min" %>
    <%= ea_js "utils/status_filter", "utils/ui", "utils/calendar_events", "utils/calendar_event_popover",
              "http/calendar_http_client", "pages/appointments" %>
<% end %>
