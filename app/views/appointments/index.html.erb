<%# Appointments page: a day column per provider for one or three days, rendered
    from the URL (date, days, provider, service, statuses) into the day frame.
    Entries open the event dialog. %>
<% formats = { date_format: setting('date_format'), time_format: setting('time_format') } %>
<% query = ->(overrides) { { date: @date, days: @days, provider: @provider_id.positive? ? @provider_id : nil,
                             service: @service_id.positive? ? @service_id : nil, statuses: @selected_statuses }.merge(overrides).compact } %>
<div class="backend-page" id="calendar-page">
    <turbo-frame id="day_view" data-turbo-action="advance">
    <%= form_with url: appointments_path, method: :get, id: "day-filter", data: { turbo_frame: "day_view" } do %>
        <div class="split"  id="calendar-toolbar">
            <div id="calendar-filter">
                <div class="calendar-filter-items toolbar">
                    <%= hidden_field_tag :date, @date, id: "day-date" %>
                    <%= select_tag :days, options_for_select([ [ "1 #{lang('day')}", 1 ], [ "3 #{lang('days')}", 3 ] ], @days),
                                   id: "select-day-interval", "aria-label": "Days", onchange: "this.form.requestSubmit()",
                                   data: { tippy_content: lang('select_day_interval_hint') } %>
                    <%= select_tag :provider, options_for_select([ [ lang('all_providers'), "" ] ] + @providers.map { |p| [ p.name, p.id ] }, @provider_id),
                                   id: "filter-provider", class: "filter-group", "aria-label": lang('provider'), onchange: "this.form.requestSubmit()",
                                   data: { tippy_content: lang('filter_providers_hint') } %>
                    <%= select_tag :service, options_for_select([ [ lang('all_services'), "" ] ] + @services.map { |s| [ s.name, s.id ] }, @service_id),
                                   id: "filter-service", class: "filter-group", "aria-label": lang('service'), onchange: "this.form.requestSubmit()",
                                   data: { tippy_content: lang('filter_services_hint') } %>
                    <details class="menu" id="status-filter" data-align="start">
                        <summary role="button" class="secondary" data-tippy-content="<%= lang('filter_statuses_hint') %>"><%= lang('statuses') %></summary>
                        <ul>
                            <% @statuses.each do |status| %>
                                <li>
                                    <label>
                                        <%= check_box_tag "statuses[]", status["name"], @selected_statuses.include?(status["name"]),
                                                          id: nil, onchange: "this.form.requestSubmit()" %>
                                        <%= status["name"] %>
                                    </label>
                                </li>
                            <% end %>
                            <%= hidden_field_tag "statuses[]", "", id: nil %>
                        </ul>
                    </details>
                </div>
            </div>
            <div id="calendar-actions">
                <%= render "calendar/actions", working_plan_exception: false %>
            </div>
        </div>
    <% end %>

    <div id="calendar">
        <div class="calendar-header split">
            <div class="toolbar">
                <div class="toolbar">
                    <%= link_to appointments_path(query.call(date: @date - 1)), id: "previous-day",
                                "aria-label": lang('previous') do %><i class="fas fa-chevron-left"></i><% end %>
                    <%= link_to appointments_path(query.call(date: @date + 1)), id: "next-day",
                                "aria-label": lang('next') do %><i class="fas fa-chevron-right"></i><% end %>
                </div>
                <%= link_to lang('today'), appointments_path(query.call(date: Date.current)), id: "today",
                            class: "#{'disabled' if @date == Date.current}" %>
            </div>
            <div class="centered">
                <%= date_field_tag :date, @date, id: "select-date", class: "select-date", form: "day-filter",
                                   onchange: "document.getElementById('day-filter').requestSubmit()" %>
            </div>
            <div class="end-aligned">
                <button type="button" class="outline" id="toggle-series">
                    <i class="fas fa-redo"></i><span><%= lang('repeating_appointments') %></span>
                </button>
            </div>
        </div>

        <div id="not-working-notes" class="muted">
            <% @columns.each do |column| %>
                <% next if column[:not_working].empty? %>
                <div><%= lang('not_working_on').sub('{date}', format_setting_date(column[:date])).sub('{names}', column[:not_working].map(&:name).to_sentence(last_word_connector: " #{lang('and')} ", two_words_connector: " #{lang('and')} ")) %></div>
            <% end %>
        </div>

        <div class="calendar-view">
            <div>
                <% @columns.each do |column| %>
                    <div class="date-column">
                        <h5 class="date-column-title"><%= format_setting_date(column[:date]) %></h5>
                        <% column[:days].each do |day| %>
                            <div class="provider-column" data-provider-id="<%= day.provider.id %>">
                                <h6><%= day.provider.name %></h6>
                                <div class="day-entries">
                                    <% day.entries.each do |entry| %>
                                        <%= render "appointments/entry", entry: entry, day: day, formats: formats %>
                                    <% end %>
                                </div>
                            </div>
                        <% end %>
                    </div>
                <% end %>
            </div>
        </div>
    </div>
    </turbo-frame>

    <div id="series-view" hidden>
        <turbo-frame id="series" src="/appointment_series" loading="lazy"></turbo-frame>
    </div>
</div>

<dialog id="series-pattern-modal">
    <article>
            <div class="dialog-header">
                <h5 class="dialog-title"><%= lang('change_pattern') %></h5>
                <button type="button" class="dialog-close" data-dialog-close aria-label="Close">&times;</button>
            </div>
            <div class="dialog-body">
                <p class="muted"><%= lang('change_pattern_hint') %></p>
                <%= render "shared/repeat_fields", prefix: "series-repeat" %>
            </div>
            <div class="dialog-footer">
                <button type="button" class="secondary" data-dialog-close><%= lang('cancel') %></button>
                <button type="button"  id="series-pattern-save">
                    <i class="fas fa-check-square"></i><%= lang('save') %>
                </button>
            </div>
    </article>
</dialog>

<%= render "calendar/modals" %>

<% content_for :scripts do %>
    <%= ea_js "utils/ui", "pages/appointments" %>
<% end %>
