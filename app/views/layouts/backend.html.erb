<%# Port of EA layouts/backend_layout.php. %>
<!doctype html>
<html lang="<%= script_vars[:language_code] %>">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <meta name="theme-color" content="#39824f">
    <meta name="google" content="notranslate">
    <%= csrf_meta_tags %>

    <%= yield :meta %>

    <title><%= vars(:page_title) || lang('backend_section') %> | OpenAppointments</title>

    <link rel="icon" type="image/svg+xml" href="<%= image_path("logo.svg") %>">
    <link rel="icon" type="image/x-icon" href="<%= image_path("favicon.ico") %>">
    <link rel="icon" sizes="192x192" href="<%= image_path('logo.png') %>">

    <%= stylesheet_link_tag "vendor/trumbowyg/trumbowyg.min", "vendor/select2/select2.min",
                            "vendor/flatpickr/flatpickr.min", "vendor/flatpickr/material_green.min" %>
    <%= stylesheet_link_tag "themes/#{active_theme}", "general", "backend" %>

    <%= render "shared/brand_style" %>
    <%= render "shared/custom_css_style" %>

    <%= yield :styles %>

    <%# Scripts load once per session (tracked: a new digest forces a full reload). %>
    <%= javascript_include_tag "vendor/jquery/jquery.min", "vendor/@popperjs-core/popper.min",
                               "vendor/bootstrap/bootstrap.min", "vendor/moment/moment.min",
                               "vendor/moment-timezone/moment-timezone-with-data.min",
                               "vendor/@fortawesome-fontawesome-free/fontawesome.min",
                               "vendor/@fortawesome-fontawesome-free/solid.min",
                               "vendor/tippy.js/tippy-bundle.umd.min", "vendor/trumbowyg/trumbowyg.min",
                               "vendor/select2/select2.min", "vendor/flatpickr/flatpickr.min",
                               "data-turbo-track": "reload" %>

    <%# Trumbowyg derives its icon sprite path from its own script URL, which the
        digested asset filename breaks; point it at the digested sprite instead. %>
    <script>
        if (window.jQuery && jQuery.trumbowyg) {
            jQuery.trumbowyg.svgPath = "<%= asset_path('vendor/trumbowyg/ui/icons.svg') %>";
        }
    </script>

    <%= ea_js "app", "utils/date", "utils/file", "utils/http", "utils/lang", "utils/message",
              "utils/string", "utils/url", "utils/validation", track: true %>
    <%= ea_js "layouts/backend_layout", "http/localization_http_client", "utils/settings_form", "utils/poll_frame", track: true %>

    <%# Turbo Drive: page scripts initialise on turbo:load and bind by delegation. %>
    <script type="module" data-turbo-track="reload">
        import { Turbo } from "<%= asset_path('turbo.min.js') %>";
        window.Turbo = Turbo;

        // data-turbo-confirm uses EA's message modal instead of window.confirm. The
        // submitter's text is the confirm button and title; data-turbo-confirm-title
        // and data-turbo-confirm-button override them.
        Turbo.config.forms.confirm = (message, form, submitter) => new Promise((resolve) => {
            const button = submitter || form;
            const label = button.dataset.turboConfirmButton || button.textContent.trim();
            let answered = false;
            const answer = (value, modal) => {
                answered = true;
                resolve(value);
                modal.hide();
            };

            App.Utils.Message.show(button.dataset.turboConfirmTitle || button.textContent.trim(), message, [
                {text: lang('cancel'), click: (event, modal) => answer(false, modal)},
                {text: label, click: (event, modal) => answer(true, modal)},
            ]);
            $('#message-modal').on('hidden.bs.modal', () => answered || resolve(false));
        });
    </script>

    <%= yield :scripts %>
</head>
<body class="d-flex flex-column h-100">

<main class="flex-shrink-0">

    <%= render "shared/backend_header", active_menu: vars(:active_menu) %>

    <%= yield %>

</main>

<%= render "shared/backend_footer", user_display_name: vars(:user_display_name) %>

<%# Per page values, re-run by Turbo on every visit. %>
<%= render "shared/js_vars_script" %>
<%= render "shared/js_lang_script" %>

</body>
</html>
