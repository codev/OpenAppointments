<%# Customer details left, appointment history right, the conversation full
    width below the record buttons (outside the form, so typing a message is
    not an unsaved change). Field visibility and requirements follow the
    booking form settings, as in EA. %>
<% fields = { email: 120, phone_number: 60, address: 120, city: 120, zip_code: 120 } %>
<% formats = { date_format: setting('date_format'), time_format: setting('time_format') } %>
<% channels = Messaging.enabled_channels %>
<%= render "shared/crud_form", record: record, delete_title: lang('delete_customer') do |f| %>
    <div class="split">
        <div>
            <div class="field">
                <%= f.label :name do %>
                    <%= lang('name') %> <span class="required">*</span>
                <% end %>
                <%= f.text_field :name, required: true, maxlength: 220,
                                 class: "#{'is-invalid' if record.errors.include?(:name)}" %>
            </div>

            <% fields.each do |field, max| %>
                <% next unless vars(:"display_#{field}") %>
                <% required = vars(:"require_#{field}") %>
                <div class="field">
                    <%= f.label field do %>
                        <%= lang(field.to_s) %>
                        <% if required %><span class="required">*</span><% end %>
                    <% end %>
                    <%= f.text_field field, required: required, maxlength: max,
                                     class: "#{'is-invalid' if record.errors.include?(field)}" %>
                </div>
            <% end %>

            <div class="field">
                <%= f.label :language do %>
                    <%= lang('language') %> <span class="required">*</span>
                <% end %>
                <%= f.select :language, Localization.available_languages.map { |l| [ l.capitalize, l ] }, {},
                             required: true %>
            </div>

            <div class="<%= timezone_hidden_class %>">
                <%= f.label :timezone do %>
                    <%= lang('timezone') %> <span class="required">*</span>
                <% end %>
                <%= f.select :timezone, grouped_timezones.map { |continent, zones| [ continent, zones.map { |value, name| [ name, value ] } ] }, {},
                             required: true %>
            </div>

            <% { other_emails: "other_emails", other_phones: "other_phones" }.each do |field, key| %>
                <div class="field">
                    <%= f.label field, lang(key) %>
                    <%= f.text_area field, rows: 2 %>
                    <div class="field-hint muted"><small><%= lang("#{key}_hint") %></small></div>
                </div>
            <% end %>

            <% if setting('ldap_is_active').to_s == "1" %>
                <div class="field">
                    <%= f.label :ldap_dn, lang('ldap_dn') %>
                    <%= f.text_field :ldap_dn, maxlength: 100 %>
                </div>
            <% end %>

            <%= render "shared/custom_fields", rows: 8, name: "customer", record: record %>

            <div class="field">
                <%= f.label :notes, lang('notes') %>
                <%= f.text_area :notes, rows: 8 %>
            </div>
        </div>

        <div>
            <h4 class="toolbar spaced"><%= lang('appointments') %></h4>
            <div id="customer-appointments" class="panel"
                 style="min-height: 400px; max-height: 800px; max-width: 330px; width: 100%;">
                <% appointments = record.persisted? ? visible_appointments(record) : [] %>
                <% if appointments.empty? %>
                    <p><%= lang('no_records_found') %></p>
                <% end %>
                <% appointments.each do |appointment| %>
                    <div class="appointment-row" data-id="<%= appointment.id %>">
                        <a href="/calendar/reschedule/<%= appointment.booking_hash %>" data-turbo="false">
                            <i class="fas fa-edit"></i>
                            <strong><%= appointment.service&.name %> - <%= appointment.provider&.name %></strong>
                            <br>
                        </a>
                        <small><%= display_datetime(appointment.start_datetime) %></small><br>
                        <small><%= display_datetime(appointment.end_datetime) %></small><br>
                        <% if Setting.timezone_support? %>
                            <small><%= format_timezone(appointment.provider&.effective_timezone) %></small>
                        <% end %>
                    </div>
                <% end %>
            </div>
        </div>
    </div>
<% end %>

<% if record.persisted? && can?(:delete, :customers) %>
    <%= form_with url: merge_customer_path(record), method: :post, id: "merge-customer", class: "panel",
                  data: { turbo_confirm: lang('merge_customer_confirm'), turbo_confirm_title: lang('merge_customer') } do %>
        <label for="merge-target" ><%= lang('merge_customer') %></label>
        <div class="field-hint muted"><small><%= lang('merge_customer_hint') %></small></div>
        <div class="input-row" style="max-width: 480px;">
            <%= text_field_tag :target, nil, id: "merge-target", required: true %>
            <button type="submit" class="destructive"><%= lang('merge_customer_button') %></button>
        </div>
    <% end %>
<% end %>

<% if record.persisted? %>
    <div id="customer-conversation" >
        <h4>
            <%= lang('customer_messages') %>
            <button type="button" id="mark-all-read" class="small-action outline" hidden>
                <i class="fas fa-check-double"></i><%= lang('mark_all_as_read') %>
            </button>
        </h4>
        <div id="customer-messages" class="panel" data-customer-id="<%= record.id %>"
             data-scroll="<%= params[:section] == 'messages' %>"></div>
        <% if channels.any? %>
            <div id="customer-message-composer" class="input-row">
                <select id="message-channel" >
                    <option value=""><%= lang('select_one') %></option>
                    <% channels.each do |channel| %>
                        <option value="<%= channel.key %>"><%= channel.label %></option>
                    <% end %>
                    <option value="all"><%= lang('messages_all_providers') %></option>
                </select>
                <textarea id="message-body"  rows="3" maxlength="1000"></textarea>
                <button type="button" id="send-message" >
                    <i class="fas fa-paper-plane"></i>
                    <%= lang('send_message') %>
                </button>
            </div>
        <% end %>
    </div>
<% end %>
