<div id="messages-notifications-page" class="container backend-page py-3">
    <div class="row">
        <div class="col-sm-3">
            <%= render "shared/messages_nav" %>
        </div>
        <div id="messages-notifications" class="col-sm-9">
            <turbo-frame id="notifications">
                <div class="d-flex justify-content-between align-items-center border-bottom mb-4 py-2">
                    <h4 class="mb-0 fw-light"><%= lang('notifications') %></h4>
                    <% if can?(:edit, :system_settings) %>
                        <%= link_to "/messages_notifications?new=1", id: "add-notification", class: "btn btn-primary" do %>
                            <i class="fas fa-plus-square me-2"></i>
                            <%= lang('add') %>
                        <% end %>
                    <% end %>
                </div>
                <% if notice %><div class="alert alert-success"><%= notice %></div><% end %>
                <% if alert %><div class="alert alert-danger"><%= alert %></div><% end %>

                <div id="notifications-list">
                    <% @notifications.each_with_index do |notification, index| %>
                        <%= render "messages_notifications/panel", notification: notification, index: index,
                                   open: notification.new_record? || notification.id == @open_id %>
                    <% end %>
                </div>
                <div class="text-center my-4">
                    <button type="button" id="toggle-all-notifications" class="btn btn-outline-secondary"
                            data-open-text="<%= lang('open_all_notification_templates') %>"
                            data-close-text="<%= lang('close_all_notification_templates') %>">
                        <%= lang('open_all_notification_templates') %>
                    </button>
                </div>
            </turbo-frame>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= ea_js "pages/messages_notifications" %>
<% end %>
