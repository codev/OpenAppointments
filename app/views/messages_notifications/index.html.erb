<div id="messages-notifications-page" class="backend-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/messages_nav" %>
        </aside>
        <div id="messages-notifications" >
            <turbo-frame id="notifications">
                <div class="toolbar spaced">
                    <h4><%= lang('notifications') %></h4>
                    <% if can?(:edit, :system_settings) %>
                        <%= link_to "/messages_notifications?new=1", id: "add-notification", role: "button" do %>
                            <i class="fas fa-plus-square"></i>
                            <%= lang('add') %>
                        <% end %>
                    <% end %>
                </div>
                <% if notice %><div class="notice" data-tone="success"><%= notice %></div><% end %>
                <% if alert %><div class="notice" data-tone="error"><%= alert %></div><% end %>

                <div id="notifications-list">
                    <% @notifications.each_with_index do |notification, index| %>
                        <%= render "messages_notifications/panel", notification: notification, index: index,
                                   open: notification.new_record? || notification.id == @open_id %>
                    <% end %>
                </div>
                <div class="centered">
                    <button type="button" id="toggle-all-notifications" class="secondary"
                            data-open-text="<%= lang('open_all_notification_templates') %>"
                            data-close-text="<%= lang('close_all_notification_templates') %>">
                        <%= lang('open_all_notification_templates') %>
                    </button>
                </div>
            </turbo-frame>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= ea_js "pages/messages_notifications" %>
<% end %>
