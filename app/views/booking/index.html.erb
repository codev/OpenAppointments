<%# The public booking wizard: one step at a time in the wizard frame, chosen by
    the URL (?step=&service_id=&provider_id=&date=&time=). Customer details post
    to booking/confirm so they never appear in a URL. %>
<% if vars(:available_services).blank? || vars(:available_providers).blank? %>
    <%= render "shared/booking_no_services_message" %>
<% else %>
    <%= render "shared/booking_cancellation_frame",
               manage_mode: vars(:manage_mode),
               appointment_data: vars(:appointment_data),
               display_delete_personal_information: vars(:display_delete_personal_information) %>

    <turbo-frame id="wizard" data-turbo-action="<%= request.get? ? 'advance' : 'replace' %>" data-step="<%= step_number %>">
        <% if flash[:alert] %>
            <div class="alert alert-danger m-3"><%= flash[:alert] %></div>
        <% end %>
        <% case @step %>
        <% when "first", "second" %>
            <% kind = @step == "first" ? vars(:first_step) : (vars(:first_step) == "provider" ? "service" : "provider") %>
            <% if kind == "service" %>
                <%= render "shared/booking_service_step", available_services: vars(:available_services) %>
            <% else %>
                <%= render "shared/booking_provider_step" %>
            <% end %>
        <% when "time" %>
            <%= render "shared/booking_time_step" %>
        <% when "info" %>
            <%= render "shared/booking_info_step", **info_step_settings %>
        <% when "final" %>
            <%= render "shared/booking_final_step",
                       manage_mode: vars(:manage_mode),
                       display_terms_and_conditions: vars(:display_terms_and_conditions),
                       display_privacy_policy: vars(:display_privacy_policy) %>
        <% end %>
    </turbo-frame>
<% end %>

<% content_for :scripts do %>
    <%= ea_js "utils/lang", "utils/ui", "pages/booking" %>
<% end %>
