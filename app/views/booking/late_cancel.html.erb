<%# Manage link opened inside the late cancellation window: late cancel only. %>
<div class="message-icon-warning"><i class="fas fa-calendar-times"></i></div>

<h3><%= lang('late_cancel_title') %></h3>

<p class="muted"><%= vars(:notice) %></p>

<form method="post" action="<%= "/booking_cancellation/late/#{vars(:appointment_hash)}" %>">
    <div class="field">
        <label for="cancellation-reason"><%= lang('reason') %></label>
        <textarea id="cancellation-reason" name="cancellation_reason" rows="3" required></textarea>
    </div>
    <div class="actions centered">
        <button type="submit">
            <i class="fas fa-calendar-times"></i>
            <%= lang('late_cancel') %>
        </button>
    </div>
</form>

<% content_for :scripts do %>
    <%= render "shared/google_analytics_script", google_analytics_code: vars(:google_analytics_code) %>
    <%= render "shared/matomo_analytics_script",
               matomo_analytics_url: vars(:matomo_analytics_url),
               matomo_analytics_site_id: vars(:matomo_analytics_site_id) %>
    <%= render "shared/umami_analytics_script" %>
<% end %>
