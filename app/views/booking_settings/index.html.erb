<%# Port of EA pages/booking_settings.php. %>
<div id="booking-settings-page" class="backend-page">
    <div id="booking-settings">
        <div class="with-sidebar">
            <aside>
                <%= render "shared/settings_nav" %>
            </aside>
            <div>
                <turbo-frame id="settings">
                    <%= settings_form "/booking_settings/save" do %>
                        <div class="page-heading toolbar spaced">
                            <h4>
                                <%= lang('booking_settings') %>
                            </h4>

                            <%= settings_save_button %>
                        </div>

                        <h5>
                            <%= lang('fields') %>
                        </h5>

                        <div class="fields-row split">
                            <div class="full">
                                <div class="form-group">
                                    <label for="name" >
                                        <%= lang('name') %>
                                        <span class="required">*</span>
                                    </label>

                                    <input type="text" id="name"  readonly/>
                                </div>
                            </div>
                            <%= settings_flash %>
                            <div class="split">
                                <div class="form-group">
                                    <label for="email" >
                                        <%= lang('email') %>
                                        <span class="required">*</span>
                                    </label>
                                    <input type="text" id="email"  readonly/>
                                    <div class="toolbar">
                                        <div class="choice switch-field">
                                            <%= setting_switch "display_email", class: "display-switch" %>
                                            <label  for="display-email">
                                                <%= lang('display') %>
                                            </label>
                                        </div>

                                        <div class="choice switch-field">
                                            <%= setting_switch "require_email", class: "require-switch" %>
                                            <label  for="require-email">
                                                <%= lang('require') %>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="full">
                                <div class="form-group">
                                    <label for="phone-number" >
                                        <%= lang('phone_number') %>
                                        <span class="required">*</span>
                                    </label>
                                    <input type="text" id="phone-number"  readonly/>
                                    <div class="toolbar">
                                        <div class="choice switch-field">
                                            <%= setting_switch "display_phone_number", class: "display-switch" %>
                                            <label  for="display-phone-number">
                                                <%= lang('display') %>
                                            </label>
                                        </div>

                                        <div class="choice switch-field">
                                            <%= setting_switch "require_phone_number", class: "require-switch" %>
                                            <label  for="require-phone-number">
                                                <%= lang('require') %>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="choice switch-field">
                                        <%= setting_switch "require_phone_or_email" %>
                                        <label  for="require-phone-or-email">
                                            <%= lang('require_phone_or_email_label') %>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="form-group">
                                    <label for="address" >
                                        <%= lang('address') %>
                                        <span class="required">*</span>
                                    </label>
                                    <input type="text" id="address"  readonly/>
                                    <div class="toolbar">
                                        <div class="choice switch-field">
                                            <%= setting_switch "display_address", class: "display-switch" %>
                                            <label  for="display-address">
                                                <%= lang('display') %>
                                            </label>
                                        </div>

                                        <div class="choice switch-field">
                                            <%= setting_switch "require_address", class: "require-switch" %>
                                            <label  for="require-address">
                                                <%= lang('require') %>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="form-group">
                                    <label for="city" >
                                        <%= lang('city') %>
                                        <span class="required">*</span>
                                    </label>
                                    <input type="text" id="city"  readonly/>
                                    <div class="toolbar">
                                        <div class="choice switch-field">
                                            <%= setting_switch "display_city", class: "display-switch" %>
                                            <label  for="display-city">
                                                <%= lang('display') %>
                                            </label>
                                        </div>

                                        <div class="choice switch-field">
                                            <%= setting_switch "require_city", class: "require-switch" %>
                                            <label  for="require-city">
                                                <%= lang('require') %>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="form-group">
                                    <label for="zip-code" >
                                        <%= lang('zip_code') %>
                                        <span class="required">*</span>
                                    </label>
                                    <input type="text" id="zip-code"  readonly/>
                                    <div class="toolbar">
                                        <div class="choice switch-field">
                                            <%= setting_switch "display_zip_code", class: "display-switch" %>
                                            <label  for="display-zip-code">
                                                <%= lang('display') %>
                                            </label>
                                        </div>

                                        <div class="choice switch-field">
                                            <%= setting_switch "require_zip_code", class: "require-switch" %>
                                            <label  for="require-zip-code">
                                                <%= lang('require') %>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="form-group">
                                    <label for="notes" >
                                        <%= lang('notes') %>
                                        <span class="required">*</span>
                                    </label>
                                    <textarea id="notes"  rows="2" readonly></textarea>
                                    <div class="toolbar">
                                        <div class="choice switch-field">
                                            <%= setting_switch "display_notes", class: "display-switch" %>
                                            <label  for="display-notes">
                                                <%= lang('display') %>
                                            </label>
                                        </div>

                                        <div class="choice switch-field">
                                            <%= setting_switch "require_notes", class: "require-switch" %>
                                            <label  for="require-notes">
                                                <%= lang('require') %>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5>
                            <%= lang('custom_fields') %>
                        </h5>

                        <div class="fields-row split">
                            <% (1..5).each do |i| %>
                                <div>
                                    <div class="form-group">
                                        <label for="custom-field-<%= i %>" >
                                            <%= lang('custom_field') %> #<%= i %>
                                            <span class="required">*</span>
                                        </label>

                                        <%= setting_text "label_custom_field_#{i}", id: "custom-field-#{i}", placeholder: lang('label'), "aria-label": "label" %>

                                        <div class="toolbar">
                                            <div class="choice switch-field">
                                                <%= setting_switch "display_custom_field_#{i}", class: "display-switch" %>
                                                <label  for="display-custom-field-<%= i %>">
                                                    <%= lang('display') %>
                                                </label>
                                            </div>

                                            <div class="choice switch-field">
                                                <%= setting_switch "require_custom_field_#{i}", class: "require-switch" %>
                                                <label  for="require-custom-field-<%= i %>">
                                                    <%= lang('require') %>
                                                </label>
                                            </div>

                                            <div class="choice switch-field">
                                                <%= setting_switch "long_custom_field_#{i}" %>
                                                <label  for="long-custom-field-<%= i %>">
                                                    <%= lang('longer_text_field') %>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% end %>
                        </div>


                        <h5>
                            <%= lang('options') %>
                        </h5>

                        <div>
                            <div>
                                <div>
                                    <div class="field">
                                        <label  for="booking-display-mode">
                                            <%= lang('booking_display_mode') %>
                                        </label>
                                        <%= setting_select "booking_display_mode",
                                                           [ [ lang('display_as_dropdown'), "dropdown" ], [ lang('display_as_cards'), "cards" ] ] %>
                                    </div>

                                    <div class="field">
                                        <label><%= lang('picture_styles') %></label>
                                        <% { "picture_style_categories" => "categories",
                                             "picture_style_services" => "services",
                                             "picture_style_providers" => "providers" }.each do |field, label_key| %>
                                            <div class="field split">
                                                <label class="col-form-label" for="<%= field.tr('_', '-') %>">
                                                    <%= lang(label_key) %>
                                                </label>
                                                <div>
                                                    <%= setting_select field, [ [ lang('white_border'), "border" ], [ lang('zoomed'), "zoomed" ] ], id: field.tr('_', '-') %>
                                                </div>
                                            </div>
                                        <% end %>
                                        <div class="field-hint muted">
                                            <small><%= lang('picture_styles_hint') %></small>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="choice switch-field">
                                            <%= setting_switch "booking_provider_first" %>
                                            <label  for="booking-provider-first">
                                                <%= lang('booking_provider_first') %>
                                            </label>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="choice switch-field">
                                            <%= setting_switch "display_order_switch", default: "1" %>
                                            <label  for="display-order-switch">
                                                <%= lang('display_order_switch') %>
                                            </label>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="choice switch-field">
                                            <%= setting_switch "display_powered_by" %>
                                            <label  for="display-powered-by">
                                                <%= lang('display_powered_by') %>
                                            </label>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="choice switch-field">
                                            <%= setting_switch "limit_customer_access" %>
                                            <label  for="limit-customer-access">
                                                <%= lang('limit_customer_access') %>
                                            </label>
                                        </div>

                                        <div class="field-hint muted">
                                            <small>
                                                <%= lang('limit_customer_access_hint') %>
                                            </small>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="choice switch-field">
                                            <%= setting_switch "display_any_provider" %>
                                            <label  for="display-any-provider">
                                                <%= lang('any_provider') %>
                                            </label>
                                        </div>

                                        <div class="field-hint muted">
                                            <small>
                                                <%= lang('display_any_provider_hint') %>
                                            </small>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="choice switch-field">
                                            <%= setting_switch "display_login_button" %>
                                            <label  for="display-login-button">
                                                <%= lang('login_button') %>
                                            </label>
                                        </div>

                                        <div class="field-hint muted">
                                            <small>
                                                <%= lang('display_login_button_hint') %>
                                            </small>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="choice switch-field">
                                            <%= setting_switch "display_delete_personal_information" %>
                                            <label  for="display-delete-personal-information">
                                                <%= lang('delete_personal_information') %>
                                            </label>
                                        </div>

                                        <div class="field-hint muted">
                                            <small>
                                                <%= lang('delete_personal_information_setting_hint') %>
                                            </small>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="choice switch-field">
                                            <%= setting_switch "disable_booking" %>
                                            <label  for="disable-booking">
                                                <%= lang('disable_booking') %>
                                            </label>
                                        </div>

                                        <div class="field-hint muted">
                                            <small>
                                                <%= lang('disable_booking_hint') %>
                                            </small>
                                        </div>
                                    </div>

                                    <div class="form-group" data-visible-when="disable_booking=1">
                                        <label  for="disable-booking-message">
                                            <%= lang('display_message') %>
                                        </label>
                                        <%= setting_textarea "disable_booking_message", class: "rich-text", cols: 30, rows: 10 %>
                                    </div>
                                </div>
                            </div>
                        </div>

                    <% end %>
                </turbo-frame>
            </div>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= ea_js "pages/booking_settings" %>
<% end %>
