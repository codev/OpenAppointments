<% linked_ids = record.assistant_provider_links.map(&:id_users_provider) %>
<% settings = capture do %>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <label class="form-label mb-0"><%= lang('providers') %></label>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-outline-secondary" data-check-all="#assistant-providers">
                <%= lang('select_all') %>
            </button>
            <button type="button" class="btn btn-outline-secondary" data-check-none="#assistant-providers">
                <%= lang('select_none') %>
            </button>
        </div>
    </div>
    <div id="assistant-providers" class="card card-body border">
        <%= hidden_field_tag "assistant[providers][]", "", id: nil %>
        <% User.providers.order(:name).each do |provider| %>
            <div class="form-check">
                <%= check_box_tag "assistant[providers][]", provider.id, linked_ids.include?(provider.id),
                                  id: "provider-#{provider.id}", class: "form-check-input" %>
                <label class="form-check-label" for="provider-<%= provider.id %>"><%= provider.name %></label>
            </div>
        <% end %>
    </div>
<% end %>
<%= render "shared/user_form", record: record, delete_title: lang('delete_assistant'), settings: settings %>
