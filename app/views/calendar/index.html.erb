<%# Calendar page: one FullCalendar filtered by a provider or a service. %>
<div class="backend-page" id="calendar-page">
    <div class="split"  id="calendar-toolbar">
        <div class="toolbar" id="calendar-filter" >
            <select id="select-filter-item" 
                    data-tippy-content="<%= lang('select_filter_item_hint') %>" aria-label="Filter">
                <option value="all"><%= lang('all') %></option>
                <% if vars(:available_providers).any? %>
                    <optgroup label="<%= lang('providers') %>">
                        <% vars(:available_providers).each do |provider| %>
                            <option value="<%= provider["id"] %>" type="provider"
                                    google-sync="<%= provider.dig("settings", "google_sync") %>"
                                    caldav-sync="<%= provider.dig("settings", "caldav_sync") %>"
                                    <%= "selected" if session[:role_slug] == Role::PROVIDER && provider["id"] == session[:user_id] %>>
                                <%= provider["name"] %>
                            </option>
                        <% end %>
                    </optgroup>
                <% end %>
                <% if vars(:available_services).any? %>
                    <optgroup label="<%= lang('services') %>">
                        <% vars(:available_services).each do |service| %>
                            <option value="<%= service["id"] %>" type="service"><%= service["name"] %></option>
                        <% end %>
                    </optgroup>
                <% end %>
            </select>
            <%= render "shared/status_filter" %>
        </div>

        <div id="calendar-actions" >
            <button id="enable-sync" class="secondary"
                    data-tippy-content="<%= lang('enable_appointment_sync_hint') %>" hidden>
                <i class="fas fa-rotate"></i>
                <%= lang('enable_sync') %>
            </button>

            <span class="toolbar" id="sync-button-group" hidden>
                <button type="button" class="secondary" id="trigger-sync"
                        data-tippy-content="<%= lang('trigger_sync_hint') %>">
                    <i class="fas fa-rotate"></i>
                    <%= lang('synchronize') %>
                </button>
                <details class="menu">
                    <summary role="button" class="secondary" aria-label="<%= lang('disable_sync') %>"></summary>
                    <ul>
                        <li><a href="#" id="disable-sync"><%= lang('disable_sync') %></a></li>
                    </ul>
                </details>
            </span>

            <button id="calendar-feed" class="secondary" data-tippy-content="<%= lang('calendar_feed_hint') %>" hidden>
                <i class="fas fa-calendar-plus"></i>
                <%= lang('calendar_feed') %>
            </button>

            <%= render "calendar/actions", working_plan_exception: true %>
        </div>
    </div>

    <%# Provider colours when the calendar shows everyone; pages/calendar.js fills it. %>
    <div class="toolbar" id="calendar-legend"  hidden></div>

    <div id="calendar"></div>
</div>

<%= render "calendar/modals" %>
<%= render "calendar/feed_modal" %>

<% content_for :scripts do %>
    <%= javascript_include_tag "vendor/fullcalendar/index.global.min",
                               "vendor/fullcalendar-moment/index.global.min",
                               "vendor/jquery-jeditable/jquery.jeditable.min" %>
    <%= ea_js "utils/status_filter", "utils/ui", "utils/calendar_events", "utils/calendar_event_popover",
              "http/calendar_http_client",
              "utils/calendar_sync", "http/google_http_client", "http/caldav_http_client", "utils/calendar_feed",
              "pages/calendar" %>
<% end %>
