<%# Calendar page: one FullCalendar filtered by a provider or a service. %>
<div class="container-fluid backend-page pt-0 pb-0" id="calendar-page">
    <div class="row mb-3 text-white py-3 bg-dark" id="calendar-toolbar">
        <div id="calendar-filter" class="col-lg-3">
            <select id="select-filter-item" class="form-select mb-2 mb-lg-0"
                    data-tippy-content="<%= lang('select_filter_item_hint') %>" aria-label="Filter">
                <option value="all"><%= lang('all') %></option>
                <% if vars(:available_providers).any? %>
                    <optgroup label="<%= lang('providers') %>">
                        <% vars(:available_providers).each do |provider| %>
                            <option value="<%= provider["id"] %>" type="provider"
                                    google-sync="<%= provider.dig("settings", "google_sync") %>"
                                    caldav-sync="<%= provider.dig("settings", "caldav_sync") %>"
                                    <%= "selected" if session[:role_slug] == Role::PROVIDER && provider["id"] == session[:user_id] %>>
                                <%= provider["name"] %>
                            </option>
                        <% end %>
                    </optgroup>
                <% end %>
                <% if vars(:available_services).any? %>
                    <optgroup label="<%= lang('services') %>">
                        <% vars(:available_services).each do |service| %>
                            <option value="<%= service["id"] %>" type="service"><%= service["name"] %></option>
                        <% end %>
                    </optgroup>
                <% end %>
            </select>
        </div>

        <div id="calendar-actions" class="col-lg-9 text-md-end">
            <button id="enable-sync" class="btn btn-light"
                    data-tippy-content="<%= lang('enable_appointment_sync_hint') %>" hidden>
                <i class="fas fa-rotate me-2"></i>
                <%= lang('enable_sync') %>
            </button>

            <div class="btn-group" id="sync-button-group" hidden>
                <button type="button" class="btn btn-light" id="trigger-sync"
                        data-tippy-content="<%= lang('trigger_sync_hint') %>">
                    <i class="fas fa-rotate me-2"></i>
                    <%= lang('synchronize') %>
                </button>
                <button type="button" class="btn btn-light dropdown-toggle dropdown-toggle-split"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="visually-hidden">Toggle Dropdown</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" href="#" id="disable-sync">
                            <%= lang('disable_sync') %>
                        </a>
                    </li>
                </ul>
            </div>

            <%= render "calendar/actions", working_plan_exception: true %>
        </div>
    </div>

    <div id="calendar"></div>
</div>

<%= render "calendar/modals" %>

<% content_for :scripts do %>
    <%= javascript_include_tag "vendor/fullcalendar/index.global.min",
                               "vendor/fullcalendar-moment/index.global.min",
                               "vendor/jquery-jeditable/jquery.jeditable.min" %>
    <%= ea_js "utils/ui", "utils/calendar_events", "utils/calendar_event_popover",
              "http/calendar_http_client", "http/customers_http_client",
              "utils/calendar_sync", "http/google_http_client", "http/caldav_http_client",
              "pages/calendar" %>
<% end %>
