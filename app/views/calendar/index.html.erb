<%# Calendar page: one FullCalendar filtered by ticked stylists, services and statuses. %>
<%# No stale preview from Turbo's cache: the page is slow to fill and a copy would mislead. %>
<% content_for :meta do %>
    <meta name="turbo-cache-control" content="no-preview">
<% end %>
<div class="container-fluid backend-page pt-0 pb-0" id="calendar-page">
    <div class="row mb-3 py-3" id="calendar-toolbar">
        <div id="calendar-filter" class="col-12 col-md-auto d-flex flex-nowrap align-items-center gap-2">
            <% stylist_login = session[:role_slug] == Role::PROVIDER %>
            <% unless stylist_login %>
                <%= render "shared/tick_filter", id: "provider-filter", label: lang('providers'), hint: lang('filter_providers_hint'),
                           items: vars(:available_providers).map { |p| [ p["name"], p["id"] ] },
                           checked: vars(:available_providers).map { |p| p["id"] },
                           all_label: lang('all_providers'), clear_label: lang('clear_providers') %>
            <% end %>
            <%= render "shared/tick_filter", id: "service-filter", label: lang('services'), hint: lang('filter_services_hint'),
                       items: vars(:available_services).map { |s| [ s["name"], s["id"] ] },
                       checked: vars(:available_services).map { |s| s["id"] },
                       all_label: lang('all_services'), clear_label: lang('clear_services') %>
            <%# The one stylist in focus, read by sync, the feed and new events:
                set by pages/calendar.js when exactly one stylist is ticked, else all.
                A stylist is always in focus on their own calendar. %>
            <select id="select-filter-item" class="d-none" aria-label="Filter">
                <option value="all"><%= lang('all') %></option>
                <% vars(:available_providers).each do |provider| %>
                    <option value="<%= provider["id"] %>" type="provider"
                            google-sync="<%= provider.dig("settings", "google_sync") %>"
                            caldav-sync="<%= provider.dig("settings", "caldav_sync") %>"
                            <%= "selected" if stylist_login && provider["id"] == session[:user_id] %>>
                        <%= provider["name"] %>
                    </option>
                <% end %>
            </select>
            <%= render "shared/status_filter" %>
        </div>

        <div id="calendar-actions" class="col-auto ms-auto">
            <button id="enable-sync" class="btn btn-light"
                    data-tippy-content="<%= lang('enable_appointment_sync_hint') %>" hidden>
                <i class="fas fa-rotate"></i>
                <%= lang('enable_sync') %>
            </button>

            <div class="btn-group" id="sync-button-group" hidden>
                <button type="button" class="btn btn-light" id="trigger-sync"
                        data-tippy-content="<%= lang('trigger_sync_hint') %>">
                    <i class="fas fa-rotate"></i>
                    <%= lang('sync') %>
                </button>
                <button type="button" class="btn btn-light dropdown-toggle dropdown-toggle-split"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="visually-hidden">Toggle Dropdown</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" href="#" id="disable-sync">
                            <%= lang('disable_sync') %>
                        </a>
                    </li>
                </ul>
            </div>

            <button id="calendar-feed" class="btn btn-light" data-tippy-content="<%= lang('calendar_feed_hint') %>" hidden>
                <i class="far fa-calendar"></i>
                <%= lang('feed') %>
            </button>

            <%= render "calendar/actions", working_plan_exception: true %>
        </div>
    </div>

    <%# Provider colours when the calendar shows everyone; pages/calendar.js fills it. %>
    <div id="calendar-legend" class="d-flex flex-wrap gap-3 small mb-2" hidden></div>

    <div id="calendar"></div>
</div>

<%= render "calendar/modals" %>
<%= render "calendar/feed_modal" %>

<% content_for :scripts do %>
    <%= javascript_include_tag "vendor/fullcalendar/index.global.min",
                               "vendor/fullcalendar-moment/index.global.min",
                               "vendor/jquery-jeditable/jquery.jeditable.min" %>
    <%= ea_js "utils/status_filter", "utils/tick_filter", "utils/ui", "components/working_plan_exceptions_modal",
              "utils/calendar_events", "utils/calendar_event_popover",
              "http/calendar_http_client",
              "utils/calendar_sync", "http/google_http_client", "http/caldav_http_client", "utils/calendar_feed",
              "pages/calendar" %>
<% end %>
