<%# Calendar feed dialog: the selected provider's subscription link with copy
    and reset, and how to add it to Google and Apple Calendar. %>
<dialog id="calendar-feed-modal">
    <article class="wide">
            <div class="dialog-header">
                <h5 class="dialog-title" id="calendar-feed-title"><%= lang('calendar_feed') %></h5>
                <button type="button" class="dialog-close" data-dialog-close aria-label="<%= lang('close') %>"></button>
            </div>
            <div class="dialog-body">
                <p><%= lang('calendar_feed_hint') %></p>
                <label for="calendar-feed-link"><%= lang('calendar_feed_link') %></label>
                <div class="input-row">
                    <input type="text" id="calendar-feed-link"  readonly>
                    <button type="button" id="calendar-feed-copy" class="outline"
                            data-label="<%= lang('calendar_feed_copy') %>" data-copied="<%= lang('calendar_feed_copied') %>">
                        <%= lang('calendar_feed_copy') %>
                    </button>
                    <button type="button" id="calendar-feed-reset" class="destructive"><%= lang('calendar_feed_reset') %></button>
                </div>
                <p><%= lang('calendar_feed_google') %></p>
                <p><%= lang('calendar_feed_apple') %></p>
                <div class="notice" data-tone="warning"><%= lang('calendar_feed_refresh_note') %></div>
            </div>
    </article>
</dialog>
