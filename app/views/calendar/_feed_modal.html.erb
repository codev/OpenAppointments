<%# Feed dialog for the provider in focus. Calendar Feed tab: the subscription
    link with copy and reset, and how to add it to Google and Apple Calendar.
    Enable Sync tab: utils/calendar_sync.js shows one section, the sync method
    choice, the CalDAV form or the Google calendar choice while sync is off,
    or the disable option while it is on. %>
<div class="modal fade" id="calendar-feed-modal" tabindex="-1" aria-labelledby="calendar-feed-title">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="calendar-feed-title"><%= lang('feed') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= lang('close') %>"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs mb-3" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button type="button" class="nav-link active" id="calendar-feed-tab" role="tab"
                                data-bs-toggle="tab" data-bs-target="#calendar-feed-pane"
                                aria-controls="calendar-feed-pane" aria-selected="true">
                            <%= lang('calendar_feed') %>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button type="button" class="nav-link" id="calendar-sync-tab" role="tab"
                                data-bs-toggle="tab" data-bs-target="#calendar-sync-pane"
                                aria-controls="calendar-sync-pane" aria-selected="false">
                            <%= lang('enable_sync') %>
                        </button>
                    </li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="calendar-feed-pane" role="tabpanel" aria-labelledby="calendar-feed-tab">
                        <p><%= lang('calendar_feed_hint') %></p>
                        <label for="calendar-feed-link" class="form-label"><%= lang('calendar_feed_link') %></label>
                        <div class="input-group mb-4">
                            <input type="text" id="calendar-feed-link" class="form-control" readonly>
                            <button type="button" id="calendar-feed-copy" class="btn btn-outline-primary"
                                    data-label="<%= lang('calendar_feed_copy') %>" data-copied="<%= lang('calendar_feed_copied') %>">
                                <%= lang('calendar_feed_copy') %>
                            </button>
                            <button type="button" id="calendar-feed-reset" class="btn btn-outline-danger"><%= lang('calendar_feed_reset') %></button>
                        </div>
                        <p><%= lang('calendar_feed_google') %></p>
                        <p><%= lang('calendar_feed_apple') %></p>
                        <div class="alert alert-warning mb-0"><%= lang('calendar_feed_refresh_note') %></div>
                    </div>

                    <div class="tab-pane fade" id="calendar-sync-pane" role="tabpanel" aria-labelledby="calendar-sync-tab">
                        <div class="sync-section" id="sync-method" hidden>
                            <p><%= lang('sync_method_prompt') %></p>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-primary" id="sync-method-caldav">CalDAV Calendar</button>
                                <button type="button" class="btn btn-primary" id="sync-method-google">Google Calendar</button>
                            </div>
                        </div>

                        <div class="sync-section" id="sync-caldav" hidden>
                            <p><%= lang('caldav_connection_info_prompt') %></p>
                            <div class="mb-3">
                                <label for="caldav-url" class="form-label"><%= lang('calendar_url') %></label>
                                <input type="text" class="form-control" id="caldav-url">
                            </div>
                            <div class="mb-3">
                                <label for="caldav-username" class="form-label"><%= lang('username') %></label>
                                <input type="text" class="form-control" id="caldav-username">
                            </div>
                            <div class="mb-3">
                                <label for="caldav-password" class="form-label"><%= lang('password') %></label>
                                <input type="password" class="form-control" id="caldav-password">
                            </div>
                            <div class="alert alert-danger" hidden></div>
                            <button type="button" class="btn btn-primary" id="sync-caldav-connect"><%= lang('connect') %></button>
                        </div>

                        <div class="sync-section" id="sync-google-calendar" hidden>
                            <p><%= lang('select_sync_calendar_prompt') %></p>
                            <div class="mb-3">
                                <label for="google-calendar" class="form-label"><%= lang('select_sync_calendar') %></label>
                                <select class="form-select" id="google-calendar"></select>
                            </div>
                            <button type="button" class="btn btn-primary" id="sync-google-select"><%= lang('select') %></button>
                        </div>

                        <div class="sync-section" id="sync-disable" hidden>
                            <p><%= lang('disable_sync_prompt') %></p>
                            <button type="button" class="btn btn-outline-danger" id="sync-disable-confirm"><%= lang('disable_sync') %></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
