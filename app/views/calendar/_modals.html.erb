<%# The event dialog (appointment, unavailability and remove forms) and the
    working plan exception dialog. The reschedule link opens its appointment. %>
<%= render "shared/event_modal", src: (script_vars[:edit_appointment] && edit_appointment_path(script_vars[:edit_appointment]["id"])) %>

<%= render "shared/working_plan_exceptions_modal" %>

<% content_for :scripts do %>
    <%= javascript_include_tag "vendor/recurring_select/recurring_select" %>
    <%= ea_js "components/color_selection", "components/repeat_fields", "components/event_modal" %>
<% end %>
