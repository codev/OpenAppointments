<%# Add and reload buttons shared by the calendar and appointments pages. Locals: working_plan_exception. %>
<% if can?(:add, :appointments) %>
    <details class="menu" id="add-event-menu">
        <summary role="button" class="secondary" aria-label="<%= lang('add') %>">
            <i class="fas fa-plus-square"></i>
        </summary>
        <ul>
            <li><a href="#" id="insert-appointment"><%= lang('appointment') %></a></li>
            <li><a href="#" id="insert-unavailability"><%= lang('unavailability') %></a></li>
            <% if working_plan_exception && session[:role_slug] == Role::ADMIN %>
                <li><a href="#" id="insert-working-plan-exception"><%= lang('working_plan_exception') %></a></li>
            <% end %>
        </ul>
    </details>
<% end %>

<button id="reload-appointments" class="secondary" type="button"
        data-tippy-content="<%= lang('reload_appointments_hint') %>">
    <i class="fas fa-sync-alt"></i>
</button>
