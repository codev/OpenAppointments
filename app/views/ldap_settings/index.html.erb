<%# Port of EA pages/ldap_settings.php. Directory search is not available in this build. %>
<div id="ldap-settings-page" class="backend-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/settings_nav" %>
        </aside>
        <div id="ldap-settings" >
            <turbo-frame id="settings">
                <%= settings_form "/ldap_settings/save" do %>
                    <div class="toolbar spaced">
                        <h4>
                            <%= lang('ldap') %>
                        </h4>

                        <div class="split">
                            <a role="button" href="/integrations" data-turbo="false" class="outline">
                                <i class="fas fa-chevron-left"></i>
                                <%= lang('back') %>
                            </a>

                            <%= settings_save_button %>
                        </div>
                    </div>
                    <%= settings_flash %>

                    <div class="notice" data-tone="warning">
                        LDAP is not available in this build.
                    </div>

                    <div class="toolbar spaced">
                        <div class="full">
                            <div>
                                <div class="choice switch-field">
                                    <%= setting_switch "ldap_is_active" %>
                                    <label  for="ldap-is-active">
                                        <%= lang('active') %>
                                    </label>
                                </div>
                            </div>

                            <div class="field">
                                <label  for="ldap-host">
                                    <%= lang('host') %>
                                </label>
                                <%= setting_text "ldap_host" %>
                            </div>

                            <div class="field">
                                <label  for="ldap-port">
                                    <%= lang('port') %>
                                </label>
                                <%= setting_text "ldap_port" %>
                            </div>

                            <div class="field">
                                <label  for="ldap-user_dn">
                                    <%= lang('user_dn') %>
                                </label>
                                <%= setting_text "ldap_user_dn", id: "ldap-user_dn" %>
                            </div>

                            <div class="field">
                                <label  for="ldap-password">
                                    <%= lang('password') %>
                                </label>
                                <%= setting_password "ldap_password" %>
                            </div>

                            <div class="field">
                                <label  for="ldap-base-dn">
                                    <%= lang('base_dn') %>
                                </label>
                                <%= setting_text "ldap_base_dn" %>
                            </div>

                            <div>
                                <div class="field toolbar">
                                    <label  for="ldap-filter">
                                        <%= lang('filter') %>
                                    </label>
                                    <button type="button" class="small-action secondary"
                                            id="ldap-reset-filter">
                                        <i class="fas fa-undo"></i>
                                        <%= lang('reset') %>
                                    </button>
                                </div>
                                <%= setting_text "ldap_filter" %>
                            </div>

                            <div>
                                <div class="field toolbar">
                                    <label  for="ldap-field-mapping">
                                        <%= lang('field_mapping') %>
                                    </label>
                                    <button type="button" class="small-action secondary"
                                            id="ldap-reset-field-mapping">
                                        <i class="fas fa-undo"></i>
                                        <%= lang('reset') %>
                                    </button>
                                </div>

                                <%= setting_textarea "ldap_field_mapping", rows: 5 %>
                            </div>
                        </div>
                    </div>

                <% end %>
            </turbo-frame>

            <div>
                <h4>
                    <%= lang('search') %>
                </h4>
            </div>

            <p class="muted">
                <%= lang('ldap_search_hint') %>
            </p>

            <form id="ldap-search-form" >
                <label  for="ldap-search-keyword">
                    <%= lang('keyword') %>
                </label>

                <div class="input-row">
                    <input id="ldap-search-keyword" >

                    <button type="submit" class="outline">
                        <%= lang('search') %>
                    </button>
                </div>
            </form>

            <div id="ldap-search-results" >
                <!-- JS -->
            </div>
        </div>
    </div>
</div>

<%= render "shared/ldap_import_modal", roles: vars(:roles) %>

<% content_for :scripts do %>
    <%= ea_js "pages/ldap_settings" %>
<% end %>
