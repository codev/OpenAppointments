<div id="messages-settings-page" class="backend-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/messages_nav" %>
        </aside>
        <div id="messages-settings" >
            <turbo-frame id="settings">
                <%= settings_form "/messages_settings/save" do %>
                    <div class="page-heading toolbar spaced">
                        <h4>
                            <%= lang('settings') %>
                        </h4>

                        <%= settings_save_button %>
                    </div>

                    <div class="split">
                        <div>
                            <div class="field">
                                <label  for="messages-enabled">
                                    <%= lang('messages_enabled') %>
                                </label>
                                <%= setting_select "messages_enabled", [ [ lang('messages_enabled_on'), "1" ], [ lang('messages_enabled_off'), "0" ], [ lang('messages_enabled_debug'), "debug" ] ] %>
                                <div class="field-hint muted full">
                                    <small>
                                        <%= lang('messages_enabled_hint') %>
                                    </small>
                                </div>
                            </div>

                            <div class="split">
                                <div class="field">
                                    <label  for="messages-intercept-email">
                                        <%= lang('email') %>
                                    </label>
                                    <%= setting_text "messages_intercept_email", type: "email", data: { field: "messages_intercept_email", enabled_when: "messages_enabled=debug" } %>
                                </div>
                                <div class="field">
                                    <label  for="messages-intercept-phone">
                                        <%= lang('phone_number') %>
                                    </label>
                                    <%= setting_text "messages_intercept_phone", data: { field: "messages_intercept_phone", enabled_when: "messages_enabled=debug" } %>
                                </div>
                                <div class="field-hint muted">
                                    <small>
                                        <%= lang('messages_intercept_hint') %>
                                    </small>
                                </div>
                            </div>
                            <%= settings_flash %>

                            <div class="field">
                                <label  for="messages-retention-days">
                                    <%= lang('messages_retention_days') %>
                                </label>
                                <%= setting_text "messages_retention_days", min: 0, type: "number" %>
                                <div class="field-hint muted">
                                    <small>
                                        <%= lang('messages_retention_days_hint') %>
                                    </small>
                                </div>
                            </div>

                            <div class="field">
                                <label  for="messages-email-subject">
                                    <%= lang('messages_email_subject') %>
                                </label>
                                <%= setting_text "messages_email_subject", placeholder: "{{Company Name}} - Appointments" %>
                                <div class="field-hint muted">
                                    <small>
                                        <%= lang('messages_email_subject_hint') %>
                                    </small>
                                </div>
                            </div>

                            <div>
                                <div class="choice switch-field">
                                    <%= setting_switch "messages_sms_variation" %>
                                    <label  for="messages-sms-variation">
                                        <%= lang('messages_sms_variation') %>
                                    </label>
                                </div>
                                <div class="field-hint muted">
                                    <small>
                                        <%= lang('messages_sms_variation_hint') %>
                                    </small>
                                </div>
                            </div>

                            <div>
                                <div class="choice switch-field">
                                    <%= setting_switch "messages_failure_alert" %>
                                    <label  for="messages-failure-alert">
                                        <%= lang('messages_failure_alert') %>
                                    </label>
                                </div>
                                <div class="field-hint muted">
                                    <small>
                                        <%= lang('messages_failure_alert_hint') %>
                                    </small>
                                </div>
                            </div>

                            <div class="field">
                                <label  for="messages-failure-alert-emails">
                                    <%= lang('messages_failure_alert_emails') %>
                                </label>
                                <%= setting_text "messages_failure_alert_emails", value: vars(:failure_alert_emails), data: { field: "messages_failure_alert_emails", enabled_when: "messages_failure_alert=1" } %>
                                <div class="field-hint muted">
                                    <small>
                                        <%= lang('messages_failure_alert_emails_hint') %>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                <% end %>
            </turbo-frame>
        </div>
    </div>
</div>

