<div id="messages-settings-page" class="container backend-page py-3">
    <div class="row">
        <div class="col-sm-3">
            <%= render "shared/messages_nav" %>
        </div>
        <div id="messages-settings" class="col-sm-9">
            <turbo-frame id="settings">
                <%= settings_form "/messages_settings/save" do %>
                    <div class="d-flex justify-content-between align-items-center border-bottom mb-4 py-2">
                        <h4 class="mb-0 fw-light">
                            <%= lang('settings') %>
                        </h4>

                        <%= settings_save_button %>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-8">
                            <div class="form-check form-switch mb-3">
                                <%= setting_switch "messages_enabled" %>
                                <label class="form-check-label" for="messages-enabled">
                                    <%= lang('messages_enabled') %>
                                </label>
                                <div class="form-text text-muted">
                                    <small>
                                        <%= lang('messages_enabled_hint') %>
                                    </small>
                                </div>
                            </div>
                            <%= settings_flash %>

                            <div class="mb-3">
                                <label class="form-label" for="messages-retention-days">
                                    <%= lang('messages_retention_days') %>
                                </label>
                                <%= setting_text "messages_retention_days", min: 0, type: "number" %>
                                <div class="form-text text-muted">
                                    <small>
                                        <%= lang('messages_retention_days_hint') %>
                                    </small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="messages-email-subject">
                                    <%= lang('messages_email_subject') %>
                                </label>
                                <%= setting_text "messages_email_subject", placeholder: "{{Company Name}} - Appointments" %>
                                <div class="form-text text-muted">
                                    <small>
                                        <%= lang('messages_email_subject_hint') %>
                                    </small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <%= setting_switch "messages_failure_alert" %>
                                    <label class="form-check-label" for="messages-failure-alert">
                                        <%= lang('messages_failure_alert') %>
                                    </label>
                                </div>
                                <div class="form-text text-muted">
                                    <small>
                                        <%= lang('messages_failure_alert_hint') %>
                                    </small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="messages-failure-alert-emails">
                                    <%= lang('messages_failure_alert_emails') %>
                                </label>
                                <%= setting_text "messages_failure_alert_emails", value: vars(:failure_alert_emails), data: { field: "messages_failure_alert_emails", enabled_when: "messages_failure_alert=1" } %>
                                <div class="form-text text-muted">
                                    <small>
                                        <%= lang('messages_failure_alert_emails_hint') %>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                <% end %>
            </turbo-frame>
        </div>
    </div>
</div>

