<%# The signed in user's own details and settings, as a Rails form. %>
<% user = current_user %>
<% settings = user.settings || user.build_settings %>
<div id="account-page" class="backend-page">
    <div id="account">
        <div class="split">
            <div class="offset-lg-2">
                <% if vars(:require_password_change) %>
                    <div id="password-change-banner" class="notice" data-tone="warning">
                        <%= lang('first_login_update_details') %>
                    </div>
                <% end %>
                <%= form_with url: "/account/save", method: :post, id: "account-form", data: { turbo: false } do |f| %>
                    <%= hidden_field_tag :form, "1" %>
                    <div class="toolbar spaced">
                        <h4><%= lang('account') %></h4>
                        <% if can?(:edit, :user_settings) %>
                            <button type="submit" id="save-settings" >
                                <i class="fas fa-check-square"></i>
                                <%= lang('save') %>
                            </button>
                        <% end %>
                    </div>
                    <% if notice %><div class="notice" data-tone="success"><%= notice %></div><% end %>
                    <% if alert %><div class="notice" data-tone="error"><%= alert %></div><% end %>

                    <div class="split">
                        <div>
                            <div class="field">
                                <label  for="name"><%= lang('name') %> <span class="required">*</span></label>
                                <%= text_field_tag "account[name]", user.name, id: "name", required: true %>
                            </div>
                            <div class="field">
                                <label  for="email"><%= lang('email') %> <span class="required">*</span></label>
                                <%= email_field_tag "account[email]", user.email, id: "email", required: true %>
                            </div>
                            <% %i[phone_number mobile_number address city state zip_code].each do |field| %>
                                <div class="field">
                                    <label  for="<%= field.to_s.dasherize %>"><%= lang(field.to_s) %></label>
                                    <%= text_field_tag "account[#{field}]", user.public_send(field), id: field.to_s.dasherize %>
                                </div>
                            <% end %>
                            <div class="field">
                                <label  for="notes"><%= lang('notes') %></label>
                                <%= text_area_tag "account[notes]", user.notes, id: "notes", rows: 6 %>
                            </div>
                        </div>

                        <div>
                            <div class="field">
                                <label  for="username"><%= lang('username') %> <span class="required">*</span></label>
                                <%= text_field_tag "account[settings][username]", settings.username, id: "username",
                                                   required: true, autocomplete: "username" %>
                            </div>
                            <div class="field">
                                <label  for="password"><%= lang('password') %></label>
                                <%= password_field_tag "account[settings][password]", nil, id: "password",
                                                       autocomplete: "new-password" %>
                            </div>
                            <div class="field">
                                <label  for="retype-password"><%= lang('retype_password') %></label>
                                <%= password_field_tag "account[settings][password_confirmation]", nil, id: "retype-password", autocomplete: "new-password" %>
                            </div>
                            <div class="field">
                                <label  for="language"><%= lang('language') %> <span class="required">*</span></label>
                                <%= select_tag "account[language]", options_for_select(Localization.available_languages.map { |l| [ l.capitalize, l ] }, user.language),
                                               id: "language", required: true %>
                            </div>
                            <div class="<%= timezone_hidden_class %>">
                                <label  for="timezone"><%= lang('timezone') %> <span class="required">*</span></label>
                                <%= select_tag "account[timezone]",
                                               grouped_options_for_select(grouped_timezones.map { |c, zones| [ c, zones.map { |v, n| [ n, v ] } ] }, user.timezone),
                                               id: "timezone", required: true %>
                            </div>
                            <div><label><%= lang('options') %></label></div>
                        </div>
                    </div>
                <% end %>
            </div>
        </div>
    </div>
</div>
