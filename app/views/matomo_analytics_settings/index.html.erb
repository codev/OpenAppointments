<%# Port of EA pages/matomo_analytics_settings.php. %>
<div id="matomo-analytics-settings-page" class="backend-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/settings_nav" %>
        </aside>
        <div id="matomo-analytics-settings" >
            <turbo-frame id="settings">
                <%= settings_form "/matomo_analytics_settings/save" do %>
                    <div class="toolbar spaced">
                        <h4>
                            <%= lang('matomo_analytics') %>
                        </h4>

                        <div class="split">
                            <a role="button" href="/integrations" data-turbo="false" class="outline">
                                <i class="fas fa-chevron-left"></i>
                                <%= lang('back') %>
                            </a>

                            <%= settings_save_button %>
                        </div>
                    </div>
                    <%= settings_flash %>

                    <div>
                        <div class="full">
                            <div class="field">
                                <label  for="matomo-analytics-url">
                                    <%= lang('matomo_analytics_url') %>
                                </label>
                                <%= setting_text "matomo_analytics_url", placeholder: "//example.org/url/to/matomo/" %>
                                <div class="field-hint muted">
                                    <small>
                                        <%= lang('matomo_analytics_url_hint') %>
                                    </small>
                                </div>
                            </div>

                            <div class="field">
                                <label  for="matomo-analytics-site-id">
                                    <%= lang('matomo_analytics_site_id') %>
                                </label>
                                <%= setting_text "matomo_analytics_site_id" %>
                                <div class="field-hint muted">
                                    <small>
                                        <%= lang('matomo_analytics_site_id_hint') %>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                <% end %>
            </turbo-frame>
        </div>
    </div>
</div>

