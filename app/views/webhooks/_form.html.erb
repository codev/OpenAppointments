<%= render "shared/crud_form", record: record, delete_title: lang('delete_webhook') do |f| %>
    <div class="field">
        <%= f.label :name do %>
            <%= lang('name') %> <span class="required">*</span>
        <% end %>
        <%= f.text_field :name, required: true, maxlength: 128,
                         class: "#{'is-invalid' if record.errors.include?(:name)}" %>
    </div>

    <div class="field">
        <%= f.label :url do %>
            <%= lang('url') %> <span class="required">*</span>
        <% end %>
        <%= f.text_field :url, required: true,
                         class: "#{'is-invalid' if record.errors.include?(:url)}" %>
    </div>

    <div class="field">
        <%= f.label :secret_header, lang('secret_header') %>
        <%= f.text_field :secret_header %>
    </div>

    <div class="field">
        <%= f.label :secret_token, lang('secret_token') %>
        <%= f.text_field :secret_token %>
    </div>

    <div><label><%= lang('actions') %></label></div>
    <div  id="actions">
        <%= hidden_field_tag "webhook[actions][]", "" %>
        <% WebhooksController::AVAILABLE_ACTIONS.each do |action| %>
            <div>
                <div class="choice switch-field">
                    <%= check_box_tag "webhook[actions][]", action, record.handles?(action),
                                      id: "include-#{action.dasherize}" %>
                    <label  for="include-<%= action.dasherize %>"><%= lang(action) %></label>
                </div>
            </div>
        <% end %>
    </div>

    <div><label><%= lang('options') %></label></div>
    <div>
        <div class="choice switch-field">
            <%= f.check_box :is_ssl_verified %>
            <%= f.label :is_ssl_verified, lang('verify_ssl') %>
        </div>
    </div>

    <div class="field">
        <%= f.label :notes, lang('notes') %>
        <%= f.text_area :notes, rows: 8 %>
    </div>
<% end %>
