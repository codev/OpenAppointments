<%# Port of EA pages/booking_cancellation.php. Rendered with the message layout. %>
<div class="toolbar">
    <div class="centered">
        <div class="toolbar"  style="width: 100px; height: 100px;">
            <i class="fas fa-calendar-times fa-3x required"></i>
        </div>

        <h3 class="muted"><%= lang('appointment_cancelled_title') %></h3>

        <p class="muted">
            <%= lang('appointment_cancelled') %>
        </p>
        <% if vars(:late_notice).present? %>
            <p class="muted"><%= vars(:late_notice) %></p>
        <% end %>

        <div>
            <a role="button" href="/" >
                <i class="fas fa-calendar-alt"></i>
                <%= lang('go_to_booking_page') %>
            </a>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= render "shared/google_analytics_script", google_analytics_code: vars(:google_analytics_code) %>
    <%= render "shared/matomo_analytics_script",
               matomo_analytics_url: vars(:matomo_analytics_url),
               matomo_analytics_site_id: vars(:matomo_analytics_site_id) %>
    <%= render "shared/umami_analytics_script" %>
<% end %>
