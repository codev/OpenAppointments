<%# Port of EA pages/about.php, trimmed of the upstream blog/premium/social sections. %>
<div id="about-page" class="backend-page">
    <div id="about" class="offset-lg-2">

        <div class="centered">
            <img src="<%= image_path('logo.png') %>" alt="OpenAppointments Logo" >

            <h3>
                OpenAppointments
            </h3>
            <h6 class="text-primary">
                Online Appointment Scheduler
            </h6>
        </div>

        <p>
            <%= lang('about_app_info') %>
        </p>

        <div class="panel">
            <div class="split">
                <h5>
                    <%= lang('current_version') %>
                </h5>
            </div>
            <div>
                <strong>
                    <%= EaHelper::VERSION %>
                </strong>
            </div>
        </div>

        <h4>
            <%= lang('release_notes') %>
        </h4>

        <div>
            <% Changelog.entries.each do |entry| %>
                <h6>v<%= entry[:version] %></h6>
                <ul class="muted">
                    <% entry[:notes].each do |note| %>
                        <li><%= note %></li>
                    <% end %>
                </ul>
            <% end %>
        </div>

        <h4>
            <%= lang('support') %>
        </h4>

        <p>
            <%= lang('about_app_support') %>
        </p>

        <div>
            <div>
                <a role="button" class="secondary" href="https://github.com/codev/OpenAppointments" target="_blank">
                    <i class="fas fa-external-link-alt"></i>
                    <%= lang('official_website') %>
                </a>
            </div>

            <div>
                <a role="button" class="secondary"
                   href="https://github.com/codev/OpenAppointments/issues" target="_blank">
                    <i class="fas fa-external-link-alt"></i>
                    <%= lang('project_issues') %>
                </a>
            </div>
        </div>

        <h4>
            <%= lang('license') %>
        </h4>

        <p>
            <%= lang('about_app_license') %>
        </p>

        <div>
            <a role="button" class="secondary" href="https://www.gnu.org/licenses/agpl-3.0.en.html"
               target="_blank">
                <i class="fas fa-external-link-alt"></i>
                AGPL-3.0
            </a>
        </div>
    </div>
</div>
