<div id="messages-email-settings-page" class="backend-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/messages_nav" %>
        </aside>
        <div id="messages-email-settings" >
            <turbo-frame id="settings">
                <%= settings_form "/messages_email_settings/save" do %>
                    <%= render "shared/messages_provider_header", title: "Email" %>

                    <div class="split">
                        <div>
                            <div class="choice switch-field">
                                <%= setting_switch "messages_email_enabled", id: "email-enabled" %>
                                <label  for="email-enabled">
                                    <%= lang('active') %>
                                </label>
                            </div>

                            <div class="choice switch-field">
                                <%= setting_switch "messages_email_incoming", id: "email-incoming" %>
                                <label  for="email-incoming">
                                    <%= lang('messages_incoming') %>
                                </label>
                                <div class="field-hint muted">
                                    <small>
                                        <%= lang('messages_incoming_hint') %>
                                    </small>
                                </div>
                            </div>

                            <h5>
                                <%= lang('messages_email_outgoing') %>
                            </h5>

                            <div class="field">
                                <label  for="email-mode">
                                    <%= lang('messages_email_mode') %>
                                </label>
                                <select name="settings[messages_email_mode]" data-field="messages_email_mode" id="email-mode" >
                                    <option value="server" <%= "selected" if setting('messages_email_mode').to_s == "server" %>><%= lang('messages_email_mode_server') %></option>
                                    <option value="smtp" <%= "selected" if setting('messages_email_mode').to_s == "smtp" %>><%= lang('messages_email_mode_smtp') %></option>
                                </select>
                            </div>

                            <div data-visible-when="messages_email_mode=smtp">
                                <div class="field">
                                    <label  for="smtp-host"><%= lang('messages_smtp_host') %></label>
                                    <%= setting_text "messages_email_smtp_host", id: "smtp-host" %>
                                </div>
                                <div class="field">
                                    <label  for="smtp-port"><%= lang('messages_smtp_port') %></label>
                                    <%= setting_text "messages_email_smtp_port", id: "smtp-port", type: "number" %>
                                </div>
                                <div class="field">
                                    <label  for="smtp-username"><%= lang('username') %></label>
                                    <%= setting_text "messages_email_smtp_username", id: "smtp-username", autocomplete: "off" %>
                                </div>
                                <div class="field">
                                    <label  for="smtp-password"><%= lang('password') %></label>
                                    <%= setting_password "messages_email_smtp_password", id: "smtp-password", autocomplete: "new-password" %>
                                </div>
                                <div class="choice switch-field">
                                    <%= setting_switch "messages_email_smtp_tls", id: "smtp-tls" %>
                                    <label  for="smtp-tls">
                                        <%= lang('messages_smtp_tls') %>
                                    </label>
                                </div>
                            </div>

                            <h5>
                                <%= lang('messages_email_incoming_section') %>
                            </h5>

                            <div data-visible-when="messages_email_incoming=1">
                                <div class="field">
                                    <label  for="email-incoming-mode">
                                        <%= lang('messages_email_incoming_mode') %>
                                    </label>
                                    <select name="settings[messages_email_incoming_mode]" data-field="messages_email_incoming_mode" id="email-incoming-mode" >
                                        <option value="server" <%= "selected" if setting('messages_email_incoming_mode').to_s == "server" %>><%= lang('messages_email_incoming_server') %></option>
                                        <option value="imap" <%= "selected" if setting('messages_email_incoming_mode').to_s == "imap" %>><%= lang('messages_email_incoming_imap') %></option>
                                    </select>
                                    <div class="field-hint muted">
                                        <small>
                                            <%= lang('messages_email_incoming_server_hint') %>
                                        </small>
                                    </div>
                                </div>

                                <div data-visible-when="messages_email_incoming=1&messages_email_incoming_mode=imap">
                                    <div class="field">
                                        <label  for="imap-host"><%= lang('messages_imap_host') %></label>
                                        <%= setting_text "messages_email_imap_host", id: "imap-host" %>
                                    </div>
                                    <div class="field">
                                        <label  for="imap-port"><%= lang('messages_imap_port') %></label>
                                        <%= setting_text "messages_email_imap_port", id: "imap-port", type: "number" %>
                                    </div>
                                    <div class="field">
                                        <label  for="imap-username"><%= lang('username') %></label>
                                        <%= setting_text "messages_email_imap_username", id: "imap-username", autocomplete: "off" %>
                                    </div>
                                    <div class="field">
                                        <label  for="imap-password"><%= lang('password') %></label>
                                        <%= setting_password "messages_email_imap_password", id: "imap-password", autocomplete: "new-password" %>
                                    </div>
                                </div>
                            </div>

                            <div class="field-hint muted">
                                <small>
                                    <%= lang('messages_email_credentials_hint') %>
                                    <a href="https://console.aws.amazon.com/" target="_blank" rel="noopener">Amazon SES</a>
                                </small>
                            </div>
                        </div>
                    </div>
                <% end %>
            </turbo-frame>
        </div>
    </div>
</div>

