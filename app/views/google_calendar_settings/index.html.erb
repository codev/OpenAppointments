<%# Port of EA pages/google_calendar_settings.php. %>
<div id="google-calendar-settings-page" class="backend-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/settings_nav" %>
        </aside>
        <div id="google-calendar-settings" >
            <turbo-frame id="settings">
                <%= settings_form "/google_calendar_settings/save" do %>
                    <div class="toolbar spaced">
                        <h4>
                            <%= lang('google_calendar') %>
                        </h4>

                        <div class="split">
                            <a role="button" href="/integrations" data-turbo="false" class="outline">
                                <i class="fas fa-chevron-left"></i>
                                <%= lang('back') %>
                            </a>

                            <%= settings_save_button %>
                        </div>
                    </div>
                    <%= settings_flash %>

                    <div>
                        <div class="full">
                            <div>
                                <div class="field-hint muted">
                                    <%= lang('google_calendar_info') %>
                                </div>
                            </div>

                            <div>
                                <div class="choice switch-field">
                                    <%= setting_switch "google_sync_feature" %>
                                    <label  for="google-sync-feature">
                                        <%= lang('active') %>
                                    </label>
                                </div>
                            </div>

                            <div class="field">
                                <label for="google-client-id" >
                                    <%= lang('google_client_id') %>
                                </label>
                                <%= setting_text "google_client_id", placeholder: lang('google_client_id') %>
                                <div class="field-hint muted">
                                    <%= lang('google_client_id_info') %>
                                </div>
                            </div>

                            <div class="field">
                                <label for="google-client-secret" >
                                    <%= lang('google_client_secret') %>
                                </label>
                                <%= setting_password "google_client_secret", placeholder: lang('google_client_secret') %>
                                <div class="field-hint muted">
                                    <%= lang('google_client_secret_info') %>
                                </div>
                            </div>

                            <div class="notice" data-tone="info">
                                <i class="fas fa-info-circle"></i>
                                <%= lang('google_calendar_setup_info') %>
                                <a href="https://console.developers.google.com" target="_blank">
                                    Google Cloud Console
                                </a>
                            </div>

                            <div>
                                <div class="choice switch-field">
                                    <%= setting_switch "google_meet_link_generation" %>
                                    <label  for="google-meet-link-generation">
                                        <%= lang('google_meet_link_generation') %>
                                    </label>
                                </div>
                                <div class="field-hint muted">
                                    <%= lang('google_meet_link_generation_info') %>
                                </div>
                            </div>

                            <div>
                                <div class="choice switch-field">
                                    <%= setting_switch "display_add_to_google_calendar" %>
                                    <label  for="display-add-to-google-calendar">
                                        <%= lang('display_add_to_google_calendar') %>
                                    </label>
                                </div>
                                <div class="field-hint muted">
                                    <%= lang('display_add_to_google_calendar_info') %>
                                </div>
                            </div>

                        </div>
                    </div>

                <% end %>
            </turbo-frame>
        </div>
    </div>
</div>

