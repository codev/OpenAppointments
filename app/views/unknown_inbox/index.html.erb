<div id="unknown-inbox-page" class="backend-page">
    <div class="split">
        <div class="full">
            <h4>
                <%= lang('unknown_inbox') %>
            </h4>

            <p class="field-hint muted">
                <%= lang('unknown_inbox_info') %>
            </p>

            <%= render "shared/inbox_list",
                       messages: vars(:inbox_messages), page: vars(:inbox_page),
                       last_page: vars(:inbox_last_page), base_path: "/unknown_inbox" %>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= ea_js "utils/mark_read" %>
<% end %>
