<%# Port of EA pages/altcha_settings.php. %>
<div id="altcha-settings-page" class="backend-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/settings_nav" %>
        </aside>
        <div id="altcha-settings" >
            <turbo-frame id="settings">
                <%= settings_form "/altcha_settings/save" do %>
                    <div class="toolbar spaced">
                        <h4>
                            <%= lang('captcha') %>
                        </h4>

                        <div class="split">
                            <a role="button" href="/integrations" data-turbo="false" class="outline">
                                <i class="fas fa-chevron-left"></i>
                                <%= lang('back') %>
                            </a>

                            <%= settings_save_button %>
                        </div>
                    </div>
                    <%= settings_flash %>

                    <div>
                        <div class="full">
                            <div>
                                <div class="field-hint muted">
                                    <%= lang('captcha_info') %>
                                </div>
                            </div>

                            <div>
                                <div class="choice switch-field">
                                    <%= setting_switch "altcha_enabled" %>
                                    <label  for="altcha-enabled">
                                        <%= lang('captcha_active_customers') %>
                                    </label>
                                </div>
                                <div class="field-hint muted">
                                    <%= lang('captcha_enabled_hint') %>
                                </div>
                            </div>

                            <div>
                                <div class="choice switch-field">
                                    <%= setting_switch "captcha_login_enabled" %>
                                    <label  for="captcha-login-enabled">
                                        <%= lang('captcha_active_login') %>
                                    </label>
                                </div>
                                <div class="field-hint muted">
                                    <%= lang('captcha_login_hint') %>
                                </div>
                            </div>

                            <div class="field">
                                <label  for="captcha-provider">
                                    <%= lang('captcha_provider') %>
                                </label>
                                <select name="settings[captcha_provider]" data-field="captcha_provider" id="captcha-provider" >
                                    <option value="altcha" <%= "selected" if setting('captcha_provider').to_s == "altcha" %>>ALTCHA</option>
                                    <option value="turnstile" <%= "selected" if setting('captcha_provider').to_s == "turnstile" %>>Cloudflare Turnstile</option>
                                </select>
                            </div>

                            <div id="turnstile-provider-settings" data-visible-when="captcha_provider=turnstile">
                                <div class="field">
                                    <label  for="turnstile-site-key">
                                        <%= lang('turnstile_site_key') %>
                                    </label>
                                    <%= setting_text "turnstile_site_key", maxlength: 256 %>
                                    <div class="field-hint muted">
                                        <%= lang('turnstile_keys_hint') %>
                                        <a href="https://dash.cloudflare.com/?to=/:account/turnstile" target="_blank">dash.cloudflare.com</a>
                                        <%= lang('turnstile_keys_hint_after') %>
                                    </div>
                                </div>

                                <div class="field">
                                    <label  for="turnstile-secret-key">
                                        <%= lang('turnstile_secret_key') %>
                                    </label>
                                    <%= setting_password "turnstile_secret_key", maxlength: 256, autocomplete: "new-password" %>
                                </div>

                                <div>
                                    <div id="turnstile-test" ></div>
                                    <div class="field-hint muted">
                                        <%= lang('turnstile_test_hint') %>
                                    </div>
                                </div>
                            </div>

                            <div id="altcha-provider-settings" data-visible-when="captcha_provider=altcha">
                                <div class="field-hint muted">
                                    <%= lang('altcha_info') %>
                                </div>

                            <div class="field">
                                <label  for="altcha-hmac-key">
                                    <%= lang('altcha_hmac_key') %>
                                    <span class="required">*</span>
                                </label>
                                <div class="input-row">
                                    <%= setting_text "altcha_hmac_key" %>
                                    <button type="button" id="generate-hmac-key" class="secondary">
                                        <i class="fas fa-sync-alt"></i>
                                        <%= lang('generate') %>
                                    </button>
                                </div>
                                <div class="field-hint muted">
                                    <%= lang('altcha_hmac_key_hint') %>
                                </div>
                            </div>

                            <div class="field">
                                <label  for="altcha-max-number">
                                    <%= lang('altcha_max_number') %>
                                </label>
                                <%= setting_text "altcha_max_number", min: 10000, max: 1000000, type: "number" %>
                                <div class="field-hint muted">
                                    <%= lang('altcha_max_number_hint') %>
                                </div>
                            </div>

                            <div class="field">
                                <label  for="altcha-expires">
                                    <%= lang('altcha_expires') %>
                                </label>
                                <%= setting_text "altcha_expires", min: 60, max: 3600, type: "number" %>
                                <div class="field-hint muted">
                                    <%= lang('altcha_expires_hint') %>
                                </div>
                            </div>
                            </div>

                        </div>
                    </div>

                <% end %>
            </turbo-frame>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= ea_js "pages/altcha_settings" %>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onloadTurnstileCallback&render=explicit"
            async defer></script>
<% end %>
