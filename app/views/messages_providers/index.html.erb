<div id="messages-providers-page" class="backend-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/messages_nav" %>
        </aside>
        <div id="messages-providers" >
            <h4>
                <%= lang('messages_providers') %>
            </h4>

            <p class="field-hint muted">
                <%= lang('messages_providers_info') %>
            </p>

            <div class="split">
                <% vars(:provider_cards).each do |card| %>
                    <div>
                        <div class="panel">
                            <div class="toolbar spaced">
                                <h5>
                                    <%= card[:label] %>
                                </h5>
                                <% if !card[:enabled] %>
                                    <span class="tag"><%= lang('messages_provider_disabled') %></span>
                                <% elsif card[:incoming] %>
                                    <span class="tag"><%= lang('messages_provider_incoming_outgoing') %></span>
                                <% else %>
                                    <span class="tag count"><%= lang('messages_provider_outgoing') %></span>
                                <% end %>
                            </div>
                            <div>
                                <div class="integration-info">
                                    <small>
                                        <%= lang("messages_provider_#{card[:key]}_info") %>
                                    </small>
                                </div>
                            </div>
                            <div>
                                <a role="button" href="<%= card[:settings_path] %>" class="outline">
                                    <i class="fas fa-cogs"></i>
                                    <%= lang('configure') %>
                                </a>
                            </div>
                        </div>
                    </div>
                <% end %>

            </div>
        </div>
    </div>
</div>
