<%# Theme and brand colour settings, split out of General Settings. %>
<div id="theme-settings-page" class="backend-page">
    <div id="theme-settings">
        <div class="with-sidebar">
            <aside>
                <%= render "shared/settings_nav" %>
            </aside>
            <div>
                <%= settings_form "/theme_settings/save", frame: false do %>
                        <div class="page-heading toolbar spaced">
                            <h4>
                                <%= lang('theme') %>
                            </h4>

                            <%= settings_save_button %>
                        </div>
                        <%= settings_flash %>

                        <div class="split">
                            <div class="full">
                                <div class="field">
                                    <label  for="theme">
                                        <%= lang('theme') %>
                                    </label>

                                    <%= setting_select "theme", vars(:available_themes).map { |t| [ t.capitalize, t ] }, hidden: true %>

                                    <div class="split" id="theme-cards" >
                                        <% vars(:available_themes).each do |available_theme| %>
                                            <div class="toolbar">
                                                <div class="panel theme-card" data-theme="<%= available_theme %>"
                                                     role="button" tabindex="0"
                                                     aria-label="<%= available_theme.capitalize %>">
                                                    <div class="theme-preview-holder">
                                                        <iframe class="theme-preview-frame" title="<%= available_theme.capitalize %>"
                                                                data-theme="<%= available_theme %>" loading="lazy"
                                                                scrolling="no" tabindex="-1"></iframe>
                                                    </div>
                                                    <div class="toolbar spaced">
                                                        <span><%= available_theme.capitalize %></span>
                                                        <i class="fas fa-check-circle theme-selected-check" aria-hidden="true"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        <% end %>
                                    </div>

                                    <style>
                                        #theme-cards .theme-card {
                                            cursor: pointer;
                                            overflow: hidden;
                                        }

                                        #theme-cards .theme-card.selected {
                                            border-color: var(--bs-primary);
                                            box-shadow: 0 0 0 2px var(--bs-primary);
                                        }

                                        #theme-cards .theme-selected-check {
                                            visibility: hidden;
                                            color: var(--bs-primary);
                                        }

                                        #theme-cards .theme-card.selected .theme-selected-check {
                                            visibility: visible;
                                        }

                                        #theme-cards .theme-preview-holder {
                                            height: 200px;
                                            overflow: hidden;
                                            background: #fff;
                                        }

                                        #theme-cards .theme-preview-frame {
                                            display: block;
                                            width: 200%;
                                            height: 400px;
                                            border: 0;
                                            transform: scale(0.5);
                                            transform-origin: top left;
                                            pointer-events: none;
                                        }
                                    </style>

                                    <div>
                                        <button type="button" class="secondary small-action apply-suggested-colors"
                                                data-palette="0">
                                            <i class="fas fa-fill-drip"></i>
                                            <%= lang('apply_suggested_colors') %> 1
                                        </button>
                                        <button type="button" class="secondary small-action apply-suggested-colors"
                                                data-palette="1">
                                            <i class="fas fa-fill-drip"></i>
                                            <%= lang('apply_suggested_colors') %> 2
                                        </button>
                                    </div>
                                </div>

                                <div id="color-accessibility"  aria-live="polite"></div>

                                <div class="field">
                                    <label  for="company-color">
                                        <%= lang('company_color') %>
                                    </label>

                                    <%= setting_text "company_color", type: "color" %>
                                </div>

                                <div class="field">
                                    <label  for="company-secondary-color">
                                        <%= lang('secondary_color') %>
                                    </label>

                                    <%= setting_text "company_secondary_color", type: "color" %>
                                </div>

                                <div class="field">
                                    <label  for="company-background-color">
                                        <%= lang('background_color') %>
                                    </label>

                                    <%= setting_text "company_background_color", type: "color" %>
                                </div>

                                <div class="field">
                                    <label  for="custom-css">
                                        <%= lang('custom_css') %>
                                    </label>

                                    <%= setting_textarea "custom_css", rows: 8 %>
                                    <div class="field-hint muted">
                                        <%= lang('custom_css_hint') %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% end %>
                            </div>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= ea_js "utils/contrast", "pages/theme_settings" %>
<% end %>
