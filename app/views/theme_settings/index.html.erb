<%# Theme and brand colour settings, split out of General Settings. %>
<div id="theme-settings-page" class="container backend-page py-3">
    <div id="theme-settings">
        <div class="row">
            <div class="col-sm-3">
                <%= render "shared/settings_nav" %>
            </div>
            <div class="col-sm-9">
                <form>
                    <fieldset>
                        <div class="d-flex justify-content-between align-items-center border-bottom mb-4 py-2">
                            <h4 class="mb-0 fw-light">
                                <%= lang('theme') %>
                            </h4>

                            <% if can?(:edit, :system_settings) %>
                                <button type="button" id="save-settings" class="btn btn-primary">
                                    <i class="fas fa-check-square me-2"></i>
                                    <%= lang('save') %>
                                </button>
                            <% end %>
                        </div>

                        <div class="row mb-5">
                            <div class="col-12">
                                <div class="mb-3">
                                    <label class="form-label" for="theme">
                                        <%= lang('theme') %>
                                    </label>

                                    <select id="theme" data-field="theme" class="form-select d-none">
                                        <% vars(:available_themes).each do |available_theme| %>
                                            <option value="<%= available_theme %>">
                                                <%= available_theme.capitalize %>
                                            </option>
                                        <% end %>
                                    </select>

                                    <div id="theme-cards" class="row g-3 mb-3">
                                        <% vars(:available_themes).each do |available_theme| %>
                                            <div class="col-sm-6 col-xl-4">
                                                <div class="card theme-card h-100" data-theme="<%= available_theme %>"
                                                     role="button" tabindex="0"
                                                     aria-label="<%= available_theme.capitalize %>">
                                                    <div class="theme-preview-holder">
                                                        <iframe class="theme-preview-frame" title="<%= available_theme.capitalize %>"
                                                                data-theme="<%= available_theme %>" loading="lazy"
                                                                scrolling="no" tabindex="-1"></iframe>
                                                    </div>
                                                    <div class="card-footer py-2 d-flex align-items-center justify-content-between">
                                                        <span class="fw-medium"><%= available_theme.capitalize %></span>
                                                        <i class="fas fa-check-circle theme-selected-check" aria-hidden="true"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        <% end %>
                                    </div>

                                    <style>
                                        #theme-cards .theme-card {
                                            cursor: pointer;
                                            overflow: hidden;
                                        }

                                        #theme-cards .theme-card.selected {
                                            border-color: var(--bs-primary);
                                            box-shadow: 0 0 0 2px var(--bs-primary);
                                        }

                                        #theme-cards .theme-selected-check {
                                            visibility: hidden;
                                            color: var(--bs-primary);
                                        }

                                        #theme-cards .theme-card.selected .theme-selected-check {
                                            visibility: visible;
                                        }

                                        #theme-cards .theme-preview-holder {
                                            height: 200px;
                                            overflow: hidden;
                                            background: #fff;
                                        }

                                        #theme-cards .theme-preview-frame {
                                            display: block;
                                            width: 200%;
                                            height: 400px;
                                            border: 0;
                                            transform: scale(0.5);
                                            transform-origin: top left;
                                            pointer-events: none;
                                        }
                                    </style>

                                    <div class="my-2 d-flex gap-2">
                                        <button type="button" class="btn btn-outline-secondary btn-sm apply-suggested-colors"
                                                data-palette="0">
                                            <i class="fas fa-fill-drip me-2"></i>
                                            <%= lang('apply_suggested_colors') %> 1
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm apply-suggested-colors"
                                                data-palette="1">
                                            <i class="fas fa-fill-drip me-2"></i>
                                            <%= lang('apply_suggested_colors') %> 2
                                        </button>
                                    </div>
                                </div>

                                <div id="color-accessibility" class="mb-3" aria-live="polite"></div>

                                <div class="mb-3">
                                    <label class="form-label" for="company-color">
                                        <%= lang('company_color') %>
                                    </label>

                                    <input type="color" id="company-color" data-field="company_color"
                                           class="form-control">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="company-secondary-color">
                                        <%= lang('secondary_color') %>
                                    </label>

                                    <input type="color" id="company-secondary-color"
                                           data-field="company_secondary_color" class="form-control">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="company-background-color">
                                        <%= lang('background_color') %>
                                    </label>

                                    <input type="color" id="company-background-color"
                                           data-field="company_background_color" class="form-control">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="custom-css">
                                        <%= lang('custom_css') %>
                                    </label>

                                    <textarea id="custom-css" data-field="custom_css" rows="8"
                                              class="form-control font-monospace" spellcheck="false"></textarea>
                                    <div class="form-text text-muted small">
                                        <%= lang('custom_css_hint') %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= ea_js "utils/contrast", "http/theme_settings_http_client", "pages/theme_settings" %>
<% end %>
