<%# Theme preview sample rendered inside the Theme settings cards. Standalone
    page: theme stylesheet + brand colours (query overrides) + booking markup. %>
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <%= stylesheet_link_tag "themes/#{@theme}", "general", "frontend" %>
    <%= javascript_include_tag "vendor/@fortawesome-fontawesome-free/fontawesome.min",
                               "vendor/@fortawesome-fontawesome-free/solid.min" %>
    <%= render "shared/brand_style", primary_override: @colors[:primary],
                                     secondary_override: @colors[:secondary],
                                     background_override: @colors[:background] %>
    <style>
        body { margin: 0; overflow: hidden; }
    </style>
</head>
<body id="book-appointment-wizard">
    <header id="header" class="p-3 d-flex align-items-center bg-primary">
        <div id="company-name" class="text-white fs-5 fw-light flex-grow-1">
            <span><%= setting("company_name") %></span>
            <div>
                <span class="display-booking-selection small fw-normal text-white-50">
                    <%= lang('service') %> │ <%= lang('provider') %>
                </span>
            </div>
        </div>
        <ol id="steps" class="d-inline-block my-1">
            <% [ "completed-step", "active-step", "", "", "" ].each_with_index do |state, index| %>
                <li class="book-step d-inline-block float-start rounded text-center <%= state %>">
                    <strong class="d-block text-center">
                        <span class="step-number"><%= index + 1 %></span>
                        <i class="fas fa-check step-check" aria-hidden="true"></i>
                    </strong>
                </li>
            <% end %>
        </ol>
    </header>

    <div class="p-3">
        <h6 class="fw-light mb-3"><%= lang('select_service') %></h6>

        <select class="form-select mb-3">
            <option><%= lang('select_service') %></option>
        </select>

        <input type="text" class="form-control mb-3" value="<%= lang('customer_information') %>" readonly>

        <div class="alert alert-success py-2 small">
            <%= lang('appointment_registered') %>
        </div>

        <div class="d-flex justify-content-between">
            <button class="btn btn-outline-secondary" type="button">
                <i class="fas fa-chevron-left me-2"></i>
                <%= lang('back') %>
            </button>
            <button class="btn btn-primary" type="button">
                <%= lang('next') %>
                <i class="fas fa-chevron-right ms-2"></i>
            </button>
        </div>
    </div>
</body>
</html>
