<%# Theme preview sample rendered inside the Theme settings cards. Standalone
    page: theme stylesheet + brand colours (query overrides) + booking markup. %>
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <%= stylesheet_link_tag "themes/#{@theme}", "general", "frontend" %>
    <%= javascript_include_tag "vendor/@fortawesome-fontawesome-free/fontawesome.min",
                               "vendor/@fortawesome-fontawesome-free/solid.min" %>
    <%= render "shared/brand_style", primary_override: @colors[:primary],
                                     secondary_override: @colors[:secondary],
                                     background_override: @colors[:background] %>
    <style>
        body { margin: 0; overflow: hidden; }
    </style>
</head>
<body id="book-appointment-wizard">
    <header class="toolbar" id="header" >
        <div id="company-name" >
            <span><%= setting("company_name") %></span>
            <div class="toolbar spaced">
                <span class="display-booking-selection">
                    <%= lang('service') %> │ <%= lang('provider') %>
                </span>
            </div>
        </div>
        <ol id="steps" >
            <% [ "completed-step", "active-step", "", "", "" ].each_with_index do |state, index| %>
                <li class="book-step <%= state %>">
                    <strong>
                        <span class="step-number"><%= index + 1 %></span>
                        <i class="fas fa-check step-check" aria-hidden="true"></i>
                    </strong>
                </li>
            <% end %>
        </ol>
    </header>

    <div>
        <h6><%= lang('select_service') %></h6>

        <select>
            <option><%= lang('select_service') %></option>
        </select>

        <input type="text"  value="<%= lang('customer_information') %>" readonly>

        <div class="notice" data-tone="success">
            <%= lang('appointment_registered') %>
        </div>

        <div>
            <button class="secondary" type="button">
                <i class="fas fa-chevron-left"></i>
                <%= lang('back') %>
            </button>
            <button  type="button">
                <%= lang('next') %>
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </div>
</body>
</html>
