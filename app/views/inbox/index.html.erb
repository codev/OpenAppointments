<div id="inbox-page" class="backend-page">
    <div class="split">
        <div class="full">
            <div class="toolbar spaced">
                <h4><%= lang('inbox') %></h4>
                <div class="toolbar" role="group">
                    <a role="button" href="/inbox" class="small-action <%= 'secondary' if vars(:inbox_unread_only) %>">
                        <%= lang('all') %>
                    </a>
                    <a role="button" href="/inbox?unread=1" class="small-action <%= 'secondary' unless vars(:inbox_unread_only) %>">
                        <%= lang('unread') %>
                    </a>
                </div>
            </div>

            <p class="field-hint muted"><%= lang('inbox_info') %></p>

            <%= render "shared/inbox_list",
                       messages: vars(:inbox_messages), page: vars(:inbox_page),
                       last_page: vars(:inbox_last_page),
                       base_path: vars(:inbox_unread_only) ? "/inbox?unread=1" : "/inbox" %>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= ea_js "utils/mark_read" %>
<% end %>
