<div id="inbox-page" class="container backend-page py-3">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center border-bottom py-3 mb-3">
                <h4 class="mb-0 fw-light"><%= lang('inbox') %></h4>
                <div class="btn-group" role="group">
                    <% InboxController::FILTERS.each do |filter, (path, label)| %>
                        <a href="<%= path %>" class="btn btn-sm <%= vars(:inbox_filter) == filter ? 'btn-secondary' : 'btn-outline-secondary' %>">
                            <%= lang(label) %>
                        </a>
                    <% end %>
                </div>
            </div>

            <p class="form-text text-muted mb-4"><%= lang('inbox_info') %></p>
            <%= render "shared/bubble_key" %>

            <%= render "shared/inbox_list",
                       messages: vars(:inbox_messages), page: vars(:inbox_page),
                       last_page: vars(:inbox_last_page),
                       base_path: InboxController::FILTERS.fetch(vars(:inbox_filter)).first %>
        </div>
    </div>
</div>

<% content_for :scripts do %>
    <%= ea_js "utils/mark_read" %>
<% end %>
