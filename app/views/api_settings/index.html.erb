<div id="api-settings-page" class="backend-page">
    <div class="with-sidebar">
        <aside>
            <%= render "shared/settings_nav" %>
        </aside>
        <div id="api-settings" >
            <turbo-frame id="settings">
                <%= settings_form "/api_settings/save" do %>
                    <div class="toolbar spaced">
                        <h4><%= lang('api') %></h4>
                        <div>
                            <a role="button" href="/integrations" class="outline" data-turbo="false">
                                <i class="fas fa-chevron-left"></i>
                                <%= lang('back') %>
                            </a>
                            <%= settings_save_button %>
                        </div>
                    </div>
                    <%= settings_flash %>

                    <div class="field">
                        <label  for="api-token"><%= lang('api_token') %></label>
                        <%= setting_text "api_token" %>
                        <div class="field-hint muted"><small><%= lang('api_token_hint') %></small></div>
                    </div>
                <% end %>
            </turbo-frame>
        </div>
    </div>
</div>
