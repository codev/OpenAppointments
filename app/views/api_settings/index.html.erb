<div id="api-settings-page" class="container backend-page py-3">
    <div class="row">
        <div class="col-sm-3">
            <%= render "shared/settings_nav" %>
        </div>
        <div id="api-settings" class="col-sm-9">
            <turbo-frame id="settings">
                <%= settings_form "/api_settings/save" do %>
                    <div class="d-flex justify-content-between align-items-center border-bottom mb-4 py-2">
                        <h4 class="mb-0 fw-light"><%= lang('api') %></h4>
                        <div>
                            <a href="/integrations" class="btn btn-outline-primary me-2" data-turbo="false">
                                <i class="fas fa-chevron-left me-2"></i>
                                <%= lang('back') %>
                            </a>
                            <%= settings_save_button %>
                        </div>
                    </div>
                    <%= settings_flash %>

                    <div class="mb-3">
                        <label class="form-label" for="api-token"><%= lang('api_token') %></label>
                        <%= setting_text "api_token" %>
                        <div class="form-text text-muted"><small><%= lang('api_token_hint') %></small></div>
                    </div>
                <% end %>
            </turbo-frame>
        </div>
    </div>
</div>
