<% picture_url = EaRows.picture_url(record) %>
<% providers = User.providers.order(:name) %>
<% linked_ids = record.provider_links.map(&:id_users) %>
<% booking_link = ->(query) { link_to root_path(query), target: "_blank", title: lang('booking_link'),
                                      "aria-label": lang('booking_link') do %>
    <i class="fas fa-link"></i>
<% end } %>
<% header = capture do %>
    <% if record.persisted? %>
        <div>
            <%= booking_link.call(service: record.booking_slug) %>
            <%= button_to lang('regenerate_link'), regenerate_link_service_path(record),
                          class: "secondary small-action", form_class: "inline-form", data: { turbo_confirm_title: lang('regenerate_link'), turbo_confirm_button: lang('change') },
                          form: { data: { turbo_frame: "services_record",
                                          turbo_confirm: lang('regenerate_link_warning_service') } } %>
        </div>
    <% end %>
<% end %>
<%= render "shared/crud_form", record: record, delete_title: lang('delete_service'), header: header do |f| %>

    <div class="field toolbar spaced">
        <%= f.label :name do %>
            <%= lang('name') %> <span class="required">*</span>
        <% end %>
        <%= f.text_field :name, required: true, maxlength: 128,
                         class: "#{'is-invalid' if record.errors.include?(:name)}" %>
    </div>

    <div class="record-picture">
        <%= f.label :picture, lang('picture') %>
        <img class="picture-preview" <%= 'hidden' unless picture_url %>
             style="max-height: 120px;" src="<%= picture_url %>" alt="">
        <%= f.file_field :picture, accept: PictureUpload::ALLOWED_PICTURE_TYPES.join(",") %>
        <% if picture_url %>
            <div class="choice">
                <%= f.check_box :remove_picture, checked: false %>
                <%= f.label :remove_picture, lang('remove_picture') %>
            </div>
        <% end %>
    </div>

    <div class="field">
        <%= f.label :duration do %>
            <%= lang('duration_minutes') %> <span class="required">*</span>
        <% end %>
        <%= f.number_field :duration, required: true, min: Appointment::EVENT_MINIMUM_DURATION,
                           class: "#{'is-invalid' if record.errors.include?(:duration)}" %>
    </div>

    <div class="field">
        <%= f.label :price do %>
            <%= lang('price') %> <span class="required">*</span>
        <% end %>
        <%= f.text_field :price, required: true %>
    </div>

    <div class="field">
        <%= f.label :currency, lang('currency') %>
        <%= f.text_field :currency, maxlength: 32 %>
    </div>

    <div class="field">
        <%= f.label :id_service_categories, lang('category') %>
        <%= f.collection_select :id_service_categories, ServiceCategory.display_order, :id, :name, { include_blank: true } %>
    </div>

    <div class="field">
        <%= f.label :slot_interval do %>
            <%= lang('slot_interval') %> <span class="required">*</span>
        <% end %>
        <%= f.number_field :slot_interval, required: true, min: 1 %>
    </div>

    <div class="field">
        <%= f.label :attendants_number do %>
            <%= lang('attendants_number') %> <span class="required">*</span>
        <% end %>
        <%= f.number_field :attendants_number, required: true, min: 1 %>
    </div>

    <div class="field">
        <%= f.label :location, lang('location') %>
        <%= f.text_field :location %>
    </div>

    <div>
        <%= render "shared/color_selection", name: "service[color]", value: record.color %>
    </div>

    <div><label><%= lang('options') %></label></div>
    <div>
        <div class="choice switch-field">
            <%= f.check_box :is_private %>
            <%= f.label :is_private, lang('hide_from_public') %>
        </div>
        <div class="field-hint muted"><small><%= lang('private_hint') %></small></div>
    </div>

    <div class="field">
        <%= f.label :description, lang('description') %>
        <%= f.text_area :description, rows: 4 %>
    </div>

    <div class="field">
        <label><%= lang('providers') %></label>
        <div class="toolbar">
            <button type="button" class="secondary" data-check-all="#service-providers">
                <%= lang('select_all') %>
            </button>
            <button type="button" class="secondary" data-check-none="#service-providers">
                <%= lang('select_none') %>
            </button>
        </div>
    </div>
    <div id="service-providers" class="panel">
        <%= hidden_field_tag "service[providers][]", "", id: nil %>
        <% providers.each do |provider| %>
            <div class="choice">
                <%= check_box_tag "service[providers][]", provider.id, linked_ids.include?(provider.id),
                                  id: "provider-#{provider.id}" %>
                <label  for="provider-<%= provider.id %>"><%= provider.name %></label>
                <% if record.persisted? && linked_ids.include?(provider.id) && provider.booking_slug.present? %>
                    <%= booking_link.call(service: record.booking_slug, provider: provider.booking_slug) %>
                <% end %>
            </div>
        <% end %>
    </div>
<% end %>
