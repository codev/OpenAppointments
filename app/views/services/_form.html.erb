<% picture_url = EaRows.picture_url(record) %>
<% providers = User.providers.order(:name) %>
<% linked_ids = record.provider_links.map(&:id_users) %>
<% booking_link = ->(query) { link_to root_path(query), target: "_blank", class: "ms-2", title: lang('booking_link'),
                                      "aria-label": lang('booking_link') do %>
    <i class="fas fa-link"></i>
<% end } %>
<% header = capture do %>
    <% if record.persisted? %>
        <div class="mb-3">
            <%= booking_link.call(service: record.booking_slug) %>
            <%= button_to lang('regenerate_link'), regenerate_link_service_path(record),
                          class: "btn btn-outline-secondary btn-sm ms-2", form_class: "d-inline",
                          data: { turbo_confirm_title: lang('regenerate_link'), turbo_confirm_button: lang('change') },
                          form: { data: { turbo_frame: "services_record",
                                          turbo_confirm: lang('regenerate_link_warning_service') } } %>
        </div>
    <% end %>
<% end %>
<%= render "shared/crud_form", record: record, delete_title: lang('delete_service'), header: header do |f| %>

    <div class="mb-3">
        <%= f.label :name, class: "form-label" do %>
            <%= lang('name') %> <span class="text-danger">*</span>
        <% end %>
        <%= f.text_field :name, required: true, maxlength: 128,
                         class: "form-control #{'is-invalid' if record.errors.include?(:name)}" %>
    </div>

    <div class="mb-3 record-picture">
        <%= f.label :picture, lang('picture'), class: "form-label d-block" %>
        <img class="picture-preview img-thumbnail mb-2 <%= 'd-none' unless picture_url %>"
             style="max-height: 120px;" src="<%= picture_url %>" alt="">
        <%= f.file_field :picture, class: "form-control mb-2", accept: PictureUpload::ALLOWED_PICTURE_TYPES.join(",") %>
        <% if picture_url %>
            <div class="form-check">
                <%= f.check_box :remove_picture, class: "form-check-input", checked: false %>
                <%= f.label :remove_picture, lang('remove_picture'), class: "form-check-label" %>
            </div>
        <% end %>
    </div>

    <div class="mb-3">
        <%= f.label :duration, class: "form-label" do %>
            <%= lang('duration_minutes') %> <span class="text-danger">*</span>
        <% end %>
        <%= f.number_field :duration, required: true, min: Appointment::EVENT_MINIMUM_DURATION,
                           class: "form-control #{'is-invalid' if record.errors.include?(:duration)}" %>
    </div>

    <div class="mb-3">
        <%= f.label :price, class: "form-label" do %>
            <%= lang('price') %> <span class="text-danger">*</span>
        <% end %>
        <%= f.text_field :price, required: true, class: "form-control" %>
    </div>

    <div class="mb-3">
        <%= f.label :currency, lang('currency'), class: "form-label" %>
        <%= f.text_field :currency, maxlength: 32, class: "form-control" %>
    </div>

    <div class="mb-3">
        <%= f.label :id_service_categories, lang('category'), class: "form-label" %>
        <%= f.collection_select :id_service_categories, ServiceCategory.display_order, :id, :name, { include_blank: true },
                                class: "form-select" %>
    </div>

    <div class="mb-3">
        <%= f.label :slot_interval, class: "form-label" do %>
            <%= lang('slot_interval') %> <span class="text-danger">*</span>
        <% end %>
        <%= f.number_field :slot_interval, required: true, min: 1, class: "form-control" %>
    </div>

    <div class="mb-3">
        <%= f.label :attendants_number, class: "form-label" do %>
            <%= lang('attendants_number') %> <span class="text-danger">*</span>
        <% end %>
        <%= f.number_field :attendants_number, required: true, min: 1, class: "form-control" %>
    </div>

    <div class="mb-3">
        <%= f.label :location, lang('location'), class: "form-label" %>
        <%= f.text_field :location, class: "form-control" %>
    </div>

    <div class="mb-3">
        <%= render "shared/color_selection", name: "service[color]", value: record.color %>
    </div>

    <div><label class="form-label mb-3"><%= lang('options') %></label></div>
    <div class="border rounded mb-3 p-3">
        <div class="form-check form-switch">
            <%= f.check_box :is_private, class: "form-check-input" %>
            <%= f.label :is_private, lang('hide_from_public'), class: "form-check-label" %>
        </div>
        <div class="form-text text-muted"><small><%= lang('private_hint') %></small></div>
    </div>

    <div class="mb-3">
        <%= f.label :description, lang('description'), class: "form-label" %>
        <%= f.text_area :description, rows: 4, class: "form-control" %>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <label class="form-label mb-0"><%= lang('providers') %></label>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-outline-secondary" data-check-all="#service-providers">
                <%= lang('select_all') %>
            </button>
            <button type="button" class="btn btn-outline-secondary" data-check-none="#service-providers">
                <%= lang('select_none') %>
            </button>
        </div>
    </div>
    <div id="service-providers" class="card card-body border mb-3">
        <%= hidden_field_tag "service[providers][]", "", id: nil %>
        <% providers.each do |provider| %>
            <div class="form-check">
                <%= check_box_tag "service[providers][]", provider.id, linked_ids.include?(provider.id),
                                  id: "provider-#{provider.id}", class: "form-check-input" %>
                <label class="form-check-label" for="provider-<%= provider.id %>"><%= provider.name %></label>
                <% if record.persisted? && linked_ids.include?(provider.id) && provider.booking_slug.present? %>
                    <%= booking_link.call(service: record.booking_slug, provider: provider.booking_slug) %>
                <% end %>
            </div>
        <% end %>
    </div>
<% end %>
